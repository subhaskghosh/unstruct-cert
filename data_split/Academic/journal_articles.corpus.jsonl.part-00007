{"_id": "Academic--journal_articles--p--66736", "text": "{\n    \"title\": \"Deep Learning for Enhanced MRI Reconstruction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2022-07-15\",\n    \"journal_name\": \"Medical Image Analysis\",\n    \"volume\": 28,\n    \"issue\": 4,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1016/j.media.2022.102001\",\n    \"keywords\": [\n        \"medical imaging\",\n        \"MRI\",\n        \"deep learning\",\n        \"image reconstruction\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for accelerating MRI reconstruction. Results demonstrate significant improvements in image quality and reconstruction time.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Paper 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Paper 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Paper 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Paper 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Paper 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Paper 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Paper 7\",\n            \"author\": \"Author G\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66736", "text": "{\n    \"title\": \"Pediatric Brain Tumor Detection using Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Children's Hospital Los Angeles\"\n        }\n    ],\n    \"publication_date\": \"2023-03-10\",\n    \"journal_name\": \"Radiology\",\n    \"volume\": 295,\n    \"issue\": 2,\n    \"pages\": \"345-357\",\n    \"doi\": \"10.1148/radiol.2023221234\",\n    \"keywords\": [\n        \"pediatric radiology\",\n        \"brain tumor\",\n        \"CNN\",\n        \"medical imaging\"\n    ],\n    \"abstract\": \"This study investigates the application of convolutional neural networks for the detection of brain tumors in pediatric patients.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Paper 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Paper 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Paper 3\",\n            \"author\": \"Author C\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66737", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 135,\n    \"issue\": 2,\n    \"pages\": \"104-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104155\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This study presents a novel deep learning model for the early detection of diabetic retinopathy using retinal fundus images. The model achieves state-of-the-art performance and demonstrates potential for improved clinical outcomes.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 7\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 8\",\n            \"author\": \"Author H\"\n        },\n        {\n            \"title\": \"Reference Article 9\",\n            \"author\": \"Author I\"\n        },\n        {\n            \"title\": \"Reference Article 10\",\n            \"author\": \"Author J\"\n        },\n        {\n            \"title\": \"Reference Article 11\",\n            \"author\": \"Author K\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66737", "text": "{\n    \"title\": \"Machine Learning Applications in Financial Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Journal of Financial Data Science\",\n    \"volume\": 5,\n    \"issue\": 4,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.3934/jfdsci.2022025\",\n    \"keywords\": [\n        \"machine learning\",\n        \"financial forecasting\",\n        \"time series analysis\",\n        \"econometrics\"\n    ],\n    \"abstract\": \"This paper explores the application of various machine learning techniques for improving the accuracy of financial forecasts. Results demonstrate promising performance gains compared to traditional statistical methods.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author L\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author M\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author N\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author O\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author P\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66738", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning approach for the automated detection of diabetic retinopathy in retinal fundus images. The proposed method achieves state-of-the-art performance and demonstrates the potential for improving early diagnosis and treatment.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66738", "text": "{\n    \"title\": \"Traditional Machine Learning Methods in Cardiology\",\n    \"authors\": [\n        {\n            \"name\": \"Smith, John\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2024-03-10\",\n    \"journal_name\": \"American Journal of Cardiology\",\n    \"volume\": 88,\n    \"issue\": 1,\n    \"pages\": \"55-68\",\n    \"doi\": \"10.1016/j.amjcard.2024.01005\",\n    \"keywords\": [\n        \"machine learning\",\n        \"cardiology\",\n        \"heart disease\",\n        \"diagnosis\"\n    ],\n    \"abstract\": \"We explore the application of traditional machine learning techniques, such as logistic regression and support vector machines, for the diagnosis of heart disease. Results indicate modest improvements over existing clinical methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66739", "text": "{\n    \"title\": \"Perovskite Solar Cells with Enhanced Stability and Efficiency for Sustainable Energy\",\n    \"authors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 14,\n    \"issue\": 1,\n    \"pages\": \"3256-3268\",\n    \"doi\": \"10.1038/s41467-023-31000-x\",\n    \"keywords\": [\n        \"perovskite solar cells\",\n        \"sustainable energy\",\n        \"solar power\",\n        \"efficiency\",\n        \"stability\"\n    ],\n    \"abstract\": \"We report a significant improvement in the stability and efficiency of perovskite solar cells through compositional engineering and interface passivation. The resulting devices demonstrate a power conversion efficiency of 25.5% and maintain 95% of their initial performance after 1000 hours of operation under continuous illumination.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66739", "text": "{\n    \"title\": \"Novel Catalyst for Hydrogen Production from Biomass\",\n    \"authors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 13,\n    \"issue\": 1,\n    \"pages\": \"6789-6802\",\n    \"doi\": \"10.1038/s41467-022-34000-y\",\n    \"keywords\": [\n        \"hydrogen production\",\n        \"biomass\",\n        \"catalysis\",\n        \"renewable energy\",\n        \"sustainable chemistry\"\n    ],\n    \"abstract\": \"A novel catalyst based on nickel nanoparticles supported on ceria is developed for efficient hydrogen production from biomass-derived feedstocks. The catalyst exhibits high activity and selectivity under mild reaction conditions.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66740", "text": "{\n    \"title\": \"Transformer-Based Models for Predictive Maintenance in Industrial Systems\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"IEEE Transactions on Industrial Informatics\",\n    \"volume\": 19,\n    \"issue\": 3,\n    \"pages\": \"2500-2512\",\n    \"doi\": \"10.1109/TII.2023.3267890\",\n    \"keywords\": [\n        \"machine learning\",\n        \"predictive maintenance\",\n        \"transformers\",\n        \"industrial automation\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"This paper explores the application of transformer-based models for predictive maintenance in industrial systems. We demonstrate significant improvements in prediction accuracy compared to traditional methods, leading to reduced downtime and increased efficiency.\",\n    \"references\": [\n        {\n            \"title\": \"Attention is All You Need\",\n            \"author\": \"Vaswani et al.\"\n        },\n        {\n            \"title\": \"Deep Learning\",\n            \"author\": \"Goodfellow et al.\"\n        },\n        {\n            \"title\": \"A Survey of Predictive Maintenance Techniques\",\n            \"author\": \"Jardine et al.\"\n        },\n        {\n            \"title\": \"Time-Series Forecasting\",\n            \"author\": \"Hyndman et al.\"\n        },\n        {\n            \"title\": \"Machine Learning for Industrial Applications\",\n            \"author\": \"Lee et al.\"\n        },\n        {\n            \"title\": \"Introduction to Machine Learning\",\n            \"author\": \"Bishop\"\n        },\n        {\n            \"title\": \"The Elements of Statistical Learning\",\n            \"author\": \"Hastie et al.\"\n        },\n        {\n            \"title\": \"Practical Machine Learning\",\n            \"author\": \"Géron\"\n        },\n        {\n            \"title\": \"Understanding Machine Learning\",\n            \"author\": \"Shalev-Shwartz et al.\"\n        },\n        {\n            \"title\": \"Advanced Predictive Maintenance\",\n            \"author\": \"Mobley\"\n        },\n        {\n            \"title\": \"Data Mining: Concepts and Techniques\",\n            \"author\": \"Han et al.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66740", "text": "{\n    \"title\": \"Numerical Solutions to Partial Differential Equations\",\n    \"authors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2022-11-01\",\n    \"journal_name\": \"Applied Mathematics\",\n    \"volume\": 12,\n    \"issue\": 4,\n    \"pages\": \"300-320\",\n    \"doi\": \"10.1007/s00205-022-01800-7\",\n    \"keywords\": [\n        \"partial differential equations\",\n        \"numerical analysis\",\n        \"finite element method\"\n    ],\n    \"abstract\": \"This paper presents a novel numerical method for solving a class of partial differential equations. The method is shown to be accurate and efficient.\",\n    \"references\": [\n        {\n            \"title\": \"Finite Element Methods\",\n            \"author\": \"Ciarlet\"\n        },\n        {\n            \"title\": \"Numerical Methods for Partial Differential Equations\",\n            \"author\": \"Quarteroni et al.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66741", "text": "{\n    \"title\": \"Deep Learning for Enhanced Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2022-07-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 75,\n    \"issue\": 4,\n    \"pages\": \"102-115\",\n    \"doi\": \"10.1016/j.jbi.2022.104025\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning model for the automated diagnosis of diabetic retinopathy using retinal fundus images. The model achieves state-of-the-art performance and demonstrates potential for clinical application.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 7\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 8\",\n            \"author\": \"Author H\"\n        },\n        {\n            \"title\": \"Reference Article 9\",\n            \"author\": \"Author I\"\n        },\n        {\n            \"title\": \"Reference Article 10\",\n            \"author\": \"Author J\"\n        },\n        {\n            \"title\": \"Reference Article 11\",\n            \"author\": \"Author K\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66741", "text": "{\n    \"title\": \"Traditional Statistical Methods for Predicting Patient Outcomes\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"publication_date\": \"2023-03-10\",\n    \"journal_name\": \"Health Statistics Quarterly\",\n    \"volume\": 18,\n    \"issue\": 2,\n    \"pages\": \"45-58\",\n    \"doi\": \"10.1080/10665326.2023.1188776\",\n    \"keywords\": [\n        \"statistical analysis\",\n        \"patient outcomes\",\n        \"healthcare\",\n        \"regression\"\n    ],\n    \"abstract\": \"This study investigates the use of traditional statistical methods, such as logistic regression, for predicting patient outcomes in a large cohort study.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author L\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author M\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author N\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author O\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author P\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66742", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Machine Learning Research\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"250-280\",\n    \"doi\": \"10.1234/jmlr.2023.12345\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Image Recognition\",\n        \"Convolutional Neural Networks\",\n        \"Machine Learning\"\n    ],\n    \"abstract\": \"This paper provides a comprehensive review of deep learning techniques applied to image recognition, focusing on recent advancements and challenges.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey Hinton\"\n            ]\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"authors\": [\n                \"Christian Szegedy\",\n                \"Wei Liu\",\n                \"Yangqing Jia\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"Kaiming He\",\n                \"Xiangyu Zhang\",\n                \"Shaoqing Ren\"\n            ]\n        },\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Ashish Vaswani\",\n                \"Noam Shazeer\",\n                \"Noam Parmar\"\n            ]\n        },\n        {\n            \"title\": \"BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding\",\n            \"authors\": [\n                \"Jacob Devlin\",\n                \"Ming-Wei Chang\",\n                \"Kenton Lee\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66742", "text": "{\n    \"title\": \"Traditional Machine Learning Algorithms for Spam Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-03-10\",\n    \"journal_name\": \"Journal of Information Security\",\n    \"volume\": 98,\n    \"issue\": 1,\n    \"pages\": \"50-75\",\n    \"doi\": \"10.5678/jis.2024.67890\",\n    \"keywords\": [\n        \"Spam Detection\",\n        \"Machine Learning\",\n        \"Naive Bayes\",\n        \"Support Vector Machines\"\n    ],\n    \"abstract\": \"This paper explores the application of traditional machine learning algorithms to the problem of spam detection.\",\n    \"references\": [\n        {\n            \"title\": \"Spam Filtering Based on Machine Learning\",\n            \"authors\": [\n                \"Paul Graham\"\n            ]\n        },\n        {\n            \"title\": \"A Comparison of Machine Learning Techniques for Spam Classification\",\n            \"authors\": [\n                \"Mark Lillis\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66743", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Diagnosis: A Practical Implementation\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 105,\n    \"issue\": 3,\n    \"pages\": \"456-472\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"medical imaging\",\n        \"healthcare\",\n        \"implementation\"\n    ],\n    \"abstract\": \"This paper presents a practical implementation of deep learning models for the diagnosis of diabetic retinopathy using retinal fundus images. We detail the challenges and solutions encountered during deployment in a clinical setting.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66743", "text": "{\n    \"title\": \"Theoretical Foundations of Reinforcement Learning in Medical Decision Making\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"publication_date\": \"2022-12-20\",\n    \"journal_name\": \"Artificial Intelligence in Medicine\",\n    \"volume\": 98,\n    \"issue\": 2,\n    \"pages\": \"234-250\",\n    \"doi\": \"10.1016/j.artmed.2022.102005\",\n    \"keywords\": [\n        \"reinforcement learning\",\n        \"medical decision making\",\n        \"theory\",\n        \"algorithms\"\n    ],\n    \"abstract\": \"This paper explores the theoretical underpinnings of reinforcement learning algorithms applied to medical decision-making problems. We present novel mathematical frameworks and analyze their convergence properties.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66744", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 6,\n    \"pages\": \"101-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"artificial intelligence\",\n        \"healthcare\",\n        \"image recognition\"\n    ],\n    \"abstract\": \"This study presents a novel deep learning model for the early detection of diabetic retinopathy using retinal fundus images. Results demonstrate significant improvements in accuracy and sensitivity compared to existing methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66744", "text": "{\n    \"title\": \"The Role of Nutrition in Cardiovascular Health\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"publication_date\": \"2024-03-20\",\n    \"journal_name\": \"American Journal of Clinical Nutrition\",\n    \"volume\": 15,\n    \"issue\": 2,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.1093/ajcn/nqad055\",\n    \"keywords\": [\n        \"nutrition\",\n        \"cardiovascular health\",\n        \"diet\",\n        \"cholesterol\",\n        \"heart disease\"\n    ],\n    \"abstract\": \"This research examines the impact of dietary patterns on cardiovascular health outcomes. The findings highlight the importance of a balanced diet rich in fruits, vegetables, and whole grains.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66745", "text": "{\n    \"title\": \"Transformer-Based Models for Enhanced Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Journal of Computational Biology\",\n    \"volume\": 12,\n    \"issue\": 2,\n    \"pages\": \"123-145\",\n    \"doi\": \"10.1000/jcb.2024.12.2.123\",\n    \"keywords\": [\n        \"artificial intelligence\",\n        \"protein structure prediction\",\n        \"transformer models\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"This article presents a novel approach to protein structure prediction using transformer-based models. Results demonstrate significant improvements over existing methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66745", "text": "{\n    \"title\": \"Traditional Statistical Methods in Genetic Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2023-11-01\",\n    \"journal_name\": \"Genetics Research\",\n    \"volume\": 9,\n    \"issue\": 4,\n    \"pages\": \"456-478\",\n    \"doi\": \"10.5555/gr.2023.9.4.456\",\n    \"keywords\": [\n        \"genetics\",\n        \"statistical analysis\",\n        \"heritability\",\n        \"population genetics\"\n    ],\n    \"abstract\": \"This paper reviews traditional statistical methods used in genetic analysis, focusing on their application to heritability studies.\",\n    \"references\": []\n}"}
