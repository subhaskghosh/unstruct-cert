{"_id": "Academic--journal_articles--p--66560", "text": "{\n    \"title\": \"Deep Learning for Enhanced Cancer Detection in MRI Scans\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Medical Image Analysis\",\n    \"volume\": 105,\n    \"issue\": 3,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1016/j.media.2023.03.001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"cancer detection\",\n        \"MRI\",\n        \"image analysis\"\n    ],\n    \"abstract\": \"This study investigates the use of deep learning techniques to improve the accuracy of cancer detection in magnetic resonance imaging (MRI) scans. We demonstrate a significant improvement in sensitivity and specificity compared to traditional methods.\",\n    \"references\": [\n        {\n            \"title\": \"Convolutional Neural Networks for Medical Image Analysis\",\n            \"author\": \"LeCun et al.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66560", "text": "{\n    \"title\": \"Traditional Image Processing Techniques for Lung Nodule Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-01-20\",\n    \"journal_name\": \"Journal of Digital Imaging\",\n    \"volume\": 98,\n    \"issue\": 1,\n    \"pages\": \"45-58\",\n    \"doi\": \"10.1007/s10278-023-00822-x\",\n    \"keywords\": [\n        \"image processing\",\n        \"lung nodules\",\n        \"computer-aided detection\"\n    ],\n    \"abstract\": \"This paper presents a review of traditional image processing techniques applied to the detection of lung nodules in chest X-rays. We evaluate the performance of various filtering and segmentation algorithms.\",\n    \"references\": [\n        {\n            \"title\": \"Image Segmentation Techniques\",\n            \"author\": \"Gonzalez and Woods\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66561", "text": "{\n    \"title\": \"Deep Learning for Improved Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 6,\n    \"pages\": \"1234-1245\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning approach for the automated diagnosis of diabetic retinopathy from retinal fundus images. Results demonstrate significant improvement in diagnostic accuracy compared to traditional methods.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66561", "text": "{\n    \"title\": \"Traditional Statistical Methods in Medical Imaging\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-05-01\",\n    \"journal_name\": \"Medical Physics\",\n    \"volume\": 8,\n    \"issue\": 2,\n    \"pages\": \"456-467\",\n    \"doi\": \"10.1118/1.5148992\",\n    \"keywords\": [\n        \"statistical analysis\",\n        \"medical imaging\",\n        \"image processing\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This study investigates the application of traditional statistical methods for image analysis in the medical domain.  The performance is compared to newer algorithms.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author H\"\n        }\n    ]\n}"}
