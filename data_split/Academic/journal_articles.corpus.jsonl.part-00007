{"_id": "Academic--journal_articles--p--67782", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"IEEE Transactions on Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"456-468\",\n    \"doi\": \"10.1109/TMI.2023.3278901\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for the early detection of diabetic retinopathy using retinal fundus images. Our results demonstrate a significant improvement in accuracy compared to existing methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67782", "text": "{\n    \"title\": \"Traditional Statistical Methods for Analyzing Healthcare Data\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 9,\n    \"issue\": 1,\n    \"pages\": \"12-25\",\n    \"doi\": \"10.1038/s41586-022-05421-9\",\n    \"keywords\": [\n        \"statistical analysis\",\n        \"healthcare\",\n        \"data mining\",\n        \"epidemiology\"\n    ],\n    \"abstract\": \"This article reviews traditional statistical methods used in healthcare data analysis. It discusses the strengths and limitations of these approaches.\",\n    \"references\": []\n}"}
