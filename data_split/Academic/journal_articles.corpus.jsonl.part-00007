{"_id": "Academic--journal_articles--n--67369", "text": "{\n    \"title\": \"Traditional Statistical Methods in Data Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2023-11-20\",\n    \"journal_name\": \"Journal of Statistical Computing\",\n    \"volume\": 8,\n    \"issue\": 4,\n    \"pages\": \"55-70\",\n    \"doi\": \"10.5678/jsc.2023.8.4\",\n    \"keywords\": [\n        \"statistics\",\n        \"data analysis\",\n        \"regression\",\n        \"hypothesis testing\"\n    ],\n    \"abstract\": \"This article reviews traditional statistical methods for data analysis, including regression analysis, hypothesis testing, and confidence intervals. The methods are illustrated with real-world examples.\",\n    \"references\": []\n}"}
