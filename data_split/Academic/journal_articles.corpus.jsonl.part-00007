{"_id": "Academic--journal_articles--p--67506", "text": "{\n    \"title\": \"AI-Driven Diagnostics and Personalized Treatment in Oncology\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Medical Informatics\",\n    \"volume\": 12,\n    \"issue\": 4,\n    \"pages\": \"245-260\",\n    \"doi\": \"10.1000/jmi.2023.12.4.245\",\n    \"keywords\": [\n        \"artificial intelligence\",\n        \"healthcare\",\n        \"diagnostics\",\n        \"oncology\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This article explores the application of artificial intelligence in improving diagnostic accuracy and personalizing treatment plans for cancer patients.\",\n    \"references\": []\n}"}
