{"_id": "Academic--journal_articles--n--66690", "text": "{\n    \"title\": \"Machine Learning for Financial Fraud Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology, USA\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University, USA\"\n        }\n    ],\n    \"publication_date\": \"2022-11-01\",\n    \"journal_name\": \"Journal of Financial Data Science\",\n    \"volume\": 10,\n    \"issue\": 4,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.3934/jfd.2022021\",\n    \"keywords\": [\n        \"machine learning\",\n        \"fraud detection\",\n        \"financial data\",\n        \"anomaly detection\"\n    ],\n    \"abstract\": \"This paper explores the use of machine learning techniques for identifying fraudulent transactions in financial data. A comparative analysis of several algorithms...\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66691", "text": "{\n    \"title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 4,\n    \"pages\": \"15-28\",\n    \"doi\": \"10.1234/jmi.2023.12345\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"healthcare\",\n        \"image analysis\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning approach for improving the accuracy of medical image analysis, with a focus on detecting subtle anomalies in X-ray images. We demonstrate significant performance gains compared to traditional methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66691", "text": "{\n    \"title\": \"Machine Learning in Patient Monitoring\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-03-01\",\n    \"journal_name\": \"Healthcare Technology Letters\",\n    \"volume\": 8,\n    \"issue\": 1,\n    \"pages\": \"5-9\",\n    \"doi\": \"10.5678/htl.2024.67890\",\n    \"keywords\": [\n        \"machine learning\",\n        \"patient monitoring\",\n        \"healthcare\",\n        \"predictive analytics\"\n    ],\n    \"abstract\": \"This study explores the use of machine learning algorithms for predicting patient deterioration based on physiological data. The results show promising potential for early intervention.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66692", "text": "{\n    \"title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"245-260\",\n    \"doi\": \"10.1234/jmi.2023.123\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"healthcare\",\n        \"image analysis\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning approach for improving the accuracy and efficiency of medical image analysis, leading to better diagnostic outcomes.\",\n    \"references\": []\n}"}
