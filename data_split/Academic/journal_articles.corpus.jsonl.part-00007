{"_id": "Academic--journal_articles--p--66559", "text": "{\n    \"title\": \"Practical Applications of Deep Reinforcement Learning in Robotics\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Artificial Intelligence\",\n    \"volume\": 305,\n    \"issue\": 2,\n    \"pages\": \"123-145\",\n    \"doi\": \"10.1007/s10462-023-10123-x\",\n    \"keywords\": [\n        \"Reinforcement Learning\",\n        \"Robotics\",\n        \"Deep Learning\",\n        \"Practical Applications\"\n    ],\n    \"abstract\": \"This paper explores the practical implementation of deep reinforcement learning algorithms for robotic control. We demonstrate successful applications in various real-world scenarios.\",\n    \"references\": []\n}"}
