{"_id": "Academic--journal_articles--p--69081", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 15,\n    \"issue\": 1,\n    \"pages\": \"123-145\",\n    \"doi\": \"10.1038/ncomms12345\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"artificial intelligence\"\n    ],\n    \"abstract\": \"This article presents novel advancements in deep learning algorithms for image recognition tasks, achieving state-of-the-art performance on benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey Hinton\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"Kaiming He\",\n                \"Xiangyu Zhang\",\n                \"Shaoqing Ren\",\n                \"Jian Sun\"\n            ]\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"authors\": [\n                \"Christian Szegedy\",\n                \"Wei Liu\",\n                \"Yangqing Jia\",\n                \"Pierre Sermanet\",\n                \"Scott Reed\",\n                \"Dragomir Anguelov\",\n                \"Dumitru Erhan\",\n                \"Vincent Vanhoucke\",\n                \"Andrew Rabinovich\"\n            ]\n        },\n        {\n            \"title\": \"Very Deep Convolutional Networks for Large-Scale Image Recognition\",\n            \"authors\": [\n                \"Karen Simonyan\",\n                \"Andrew Zisserman\"\n            ]\n        },\n        {\n            \"title\": \"Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift\",\n            \"authors\": [\n                \"Sergey Ioffe\",\n                \"Christian Szegedy\"\n            ]\n        },\n        {\n            \"title\": \"Generative Adversarial Nets\",\n            \"authors\": [\n                \"Ian Goodfellow\",\n                \"Jean Pouget-Abadie\",\n                \"Mehdi Mirza\",\n                \"Bing Xu\",\n                \"David Warde-Farley\",\n                \"Sherjil Ozair\",\n                \"Aaron Courville\",\n                \"Yoshua Bengio\"\n            ]\n        },\n        {\n            \"title\": \"Learning Deep Features for Discriminative Object Recognition\",\n            \"authors\": [\n                \"Jeff Donahue\",\n                \"Yangqing Jia\",\n                \"Ross Girshick\",\n                \"Roberto Socher\",\n                \"C. Lawrence Zitnick\"\n            ]\n        },\n        {\n            \"title\": \"Object Detection with Discriminatively Trained Part-Based Models\",\n            \"authors\": [\n                \"Pedro Felzenszwalb\",\n                \"Ross Girshick\",\n                \"David McAllester\"\n            ]\n        },\n        {\n            \"title\": \"Fast R-CNN\",\n            \"authors\": [\n                \"Ross Girshick\",\n                \"Jeff Donahue\",\n                \"Tzahi Hashimoto\",\n                \"Jitendra Malik\",\n                \"Bharath Hariharan\"\n            ]\n        },\n        {\n            \"title\": \"Faster R-CNN: Towards Real-Time Object Detection with Region Proposal Networks\",\n            \"authors\": [\n                \"Shaoqing Ren\",\n                \"Kaiming He\",\n                \"Ross Girshick\",\n                \"Jian Sun\"\n            ]\n        },\n        {\n            \"title\": \"Mask R-CNN\",\n            \"authors\": [\n                \"Kaiming He\",\n                \"Georgia Gkioxari\",\n                \"Piotr Dollár\",\n                \"Ross Girshick\"\n            ]\n        }\n    ]\n}"}
