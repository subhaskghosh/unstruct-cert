{"_id": "Academic--journal_articles--n--67403", "text": "{\n    \"title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"publication_date\": \"2024-01-20\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 12,\n    \"issue\": 1,\n    \"pages\": \"10-25\",\n    \"doi\": \"10.5678/tpami.67890\",\n    \"keywords\": [\n        \"image recognition\",\n        \"convolutional neural networks\",\n        \"deep learning\",\n        \"computer vision\"\n    ],\n    \"abstract\": \"This paper presents a novel deep convolutional neural network architecture for image classification, achieving state-of-the-art results on several benchmark datasets.\",\n    \"references\": []\n}"}
