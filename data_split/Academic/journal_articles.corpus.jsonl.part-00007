{"_id": "Academic--journal_articles--p--67461", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"machine learning\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This paper presents a deep learning model for automated diagnosis of diabetic retinopathy from retinal fundus images. The model achieves state-of-the-art performance on a large dataset...\",\n    \"references\": []\n}"}
