{"_id": "Academic--journal_articles--n--66516", "text": "{\n    \"title\": \"Machine Learning Applications in Cancer Diagnosis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"publication_date\": \"2024-05-20\",\n    \"journal_name\": \"Journal of Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"456-478\",\n    \"doi\": \"10.5678/jmi.12.3.456\",\n    \"keywords\": [\n        \"machine learning\",\n        \"cancer diagnosis\",\n        \"medical imaging\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"This study explores the use of machine learning algorithms for improving the accuracy and efficiency of cancer diagnosis through medical image analysis.\",\n    \"references\": []\n}"}
