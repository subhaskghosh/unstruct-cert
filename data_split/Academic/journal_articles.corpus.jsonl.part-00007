{"_id": "Academic--journal_articles--n--67397", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Lung Cancer using CT Scans\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"publication_date\": \"2024-05-20\",\n    \"journal_name\": \"Medical Image Analysis\",\n    \"volume\": 102,\n    \"issue\": 1,\n    \"pages\": \"12-28\",\n    \"doi\": \"10.5678/mia.67890\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"lung cancer\",\n        \"CT scans\",\n        \"artificial intelligence\"\n    ],\n    \"abstract\": \"We present a deep learning framework for the automated diagnosis of lung cancer using CT scan images. The system achieves high accuracy in detecting malignant nodules.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--67398", "text": "{\n    \"title\": \"Efficient Attention Mechanisms for Transformer Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Machine Learning Research\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"45-62\",\n    \"doi\": \"10.1234/jmlr.2023.123\",\n    \"keywords\": [\n        \"machine learning\",\n        \"transformer networks\",\n        \"attention mechanisms\",\n        \"model efficiency\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"This paper introduces novel attention mechanisms designed to reduce the computational cost of Transformer networks, leading to significant improvements in model efficiency without sacrificing accuracy.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67398", "text": "{\n    \"title\": \"A Survey of Traditional Machine Learning Algorithms\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2023-11-20\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 98,\n    \"issue\": 1,\n    \"pages\": \"1-20\",\n    \"doi\": \"10.5678/tpami.2023.456\",\n    \"keywords\": [\n        \"machine learning\",\n        \"supervised learning\",\n        \"unsupervised learning\",\n        \"classification\",\n        \"regression\"\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of traditional machine learning algorithms, including decision trees, support vector machines, and k-nearest neighbors.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--67399", "text": "{\n    \"title\": \"Deep Learning for Enhanced Tumor Detection in MRI\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Medical Imaging Analysis\",\n    \"volume\": 55,\n    \"issue\": 6,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1016/j.media.2023.11.001\",\n    \"keywords\": [\n        \"MRI\",\n        \"Deep Learning\",\n        \"Tumor Detection\",\n        \"Medical Imaging\"\n    ],\n    \"abstract\": \"This study presents a novel deep learning approach for improving tumor detection in MRI scans, leading to earlier diagnosis and better patient outcomes.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 7\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 8\",\n            \"author\": \"Author H\"\n        },\n        {\n            \"title\": \"Reference Article 9\",\n            \"author\": \"Author I\"\n        },\n        {\n            \"title\": \"Reference Article 10\",\n            \"author\": \"Author J\"\n        },\n        {\n            \"title\": \"Reference Article 11\",\n            \"author\": \"Author K\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67399", "text": "{\n    \"title\": \"Traditional Methods in Medical Image Enhancement\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-03-10\",\n    \"journal_name\": \"Journal of Digital Imaging\",\n    \"volume\": 52,\n    \"issue\": 2,\n    \"pages\": \"89-98\",\n    \"doi\": \"10.1007/s10278-024-00654-x\",\n    \"keywords\": [\n        \"Image Enhancement\",\n        \"Medical Imaging\",\n        \"Filtering\"\n    ],\n    \"abstract\": \"This paper reviews conventional image enhancement techniques used in medical imaging applications.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--67400", "text": "{\n    \"title\": \"Federated Learning for Medical Image Analysis: A Privacy-Preserving Approach\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"federated learning\",\n        \"medical imaging\",\n        \"privacy\",\n        \"machine learning\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This paper presents a novel approach to federated learning for medical image analysis, addressing privacy concerns while maintaining high accuracy. We demonstrate the effectiveness of our method on a large dataset of chest X-rays.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67400", "text": "{\n    \"title\": \"Deep Learning for Early Cancer Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature Medicine\",\n    \"volume\": 9,\n    \"issue\": 1,\n    \"pages\": \"45-58\",\n    \"doi\": \"10.1038/s41591-022-01850-7\",\n    \"keywords\": [\n        \"deep learning\",\n        \"cancer detection\",\n        \"medical imaging\",\n        \"machine learning\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"We present a deep learning model for the early detection of cancer using medical imaging techniques. The model achieves state-of-the-art performance on several benchmark datasets.\",\n    \"references\": []\n}"}
