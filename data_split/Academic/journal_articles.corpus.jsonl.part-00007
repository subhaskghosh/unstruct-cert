{"_id": "Academic--journal_articles--p--66563", "text": "{\n    \"title\": \"Transformer-Based Language Models for Time Series Forecasting\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Journal of Machine Learning Research\",\n    \"volume\": 12,\n    \"issue\": 2,\n    \"pages\": \"45-68\",\n    \"doi\": \"10.1234/jmlr.2024.12.2.45\",\n    \"keywords\": [\n        \"time series\",\n        \"transformer\",\n        \"machine learning\",\n        \"forecasting\"\n    ],\n    \"abstract\": \"This paper introduces a novel transformer-based architecture for time series forecasting, achieving state-of-the-art results on multiple benchmark datasets. We demonstrate improved performance compared to traditional recurrent neural networks and convolutional neural networks.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66563", "text": "{\n    \"title\": \"Real-Time Object Detection using Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"publication_date\": \"2023-11-01\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 11,\n    \"issue\": 4,\n    \"pages\": \"101-115\",\n    \"doi\": \"10.5678/tpami.2023.11.4.101\",\n    \"keywords\": [\n        \"object detection\",\n        \"convolutional neural networks\",\n        \"computer vision\",\n        \"real-time\"\n    ],\n    \"abstract\": \"This paper presents a fast and accurate object detection system based on convolutional neural networks.  We achieve real-time performance on embedded devices.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66564", "text": "{\n    \"title\": \"Deep Learning for Enhanced Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 14,\n    \"issue\": 1,\n    \"pages\": \"2345-2358\",\n    \"doi\": \"10.1038/s41467-023-31000-x\",\n    \"keywords\": [\n        \"deep learning\",\n        \"protein structure prediction\",\n        \"machine learning\",\n        \"bioinformatics\"\n    ],\n    \"abstract\": \"This study introduces a novel deep learning framework for accurate and efficient protein structure prediction. Our approach significantly improves upon existing methods and has the potential to accelerate drug discovery.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66564", "text": "{\n    \"title\": \"Traditional Statistical Methods for Analyzing Genomic Data\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Broad Institute\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 13,\n    \"issue\": 1,\n    \"pages\": \"6789-6802\",\n    \"doi\": \"10.1038/s41467-022-34000-y\",\n    \"keywords\": [\n        \"genomics\",\n        \"statistics\",\n        \"data analysis\",\n        \"bioinformatics\"\n    ],\n    \"abstract\": \"We present a comprehensive review of traditional statistical methods used in genomic data analysis. These methods provide a robust foundation for understanding complex biological systems.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66565", "text": "{\n    \"title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Journal of Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 2,\n    \"pages\": \"125-140\",\n    \"doi\": \"10.1109/JMI.2024.3000001\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Medical Imaging\",\n        \"Healthcare\",\n        \"Image Analysis\",\n        \"Convolutional Neural Networks\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for enhancing the accuracy and efficiency of medical image analysis. Our results demonstrate significant improvements in the diagnosis of various diseases, showcasing the potential of AI in healthcare.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey Hinton\"\n            ]\n        },\n        {\n            \"title\": \"Generative Adversarial Nets\",\n            \"authors\": [\n                \"Ian Goodfellow\",\n                \"Jean Pouget-Abadie\",\n                \"Mehdi Mirza\",\n                \"Bing Xu\",\n                \"David Warde-Farley\",\n                \"Sherjil Ozair\",\n                \"Aaron Courville\",\n                \"Yoshua Bengio\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"Kaiming He\",\n                \"Xiangyu Zhang\",\n                \"Shaoqing Ren\",\n                \"Sun Jian\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66565", "text": "{\n    \"title\": \"Statistical Methods in Genetic Research\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"publication_date\": \"2023-11-20\",\n    \"journal_name\": \"Genetics and Genomics\",\n    \"volume\": 9,\n    \"issue\": 4,\n    \"pages\": \"300-315\",\n    \"doi\": \"10.1000/GNG.2023.2000002\",\n    \"keywords\": [\n        \"Genetics\",\n        \"Statistics\",\n        \"Genome\",\n        \"Research\",\n        \"Bioinformatics\"\n    ],\n    \"abstract\": \"This article explores the application of statistical methods in the analysis of genetic data. We discuss various techniques used to identify significant correlations and patterns in genomes.\",\n    \"references\": [\n        {\n            \"title\": \"The Elements of Statistical Learning\",\n            \"authors\": [\n                \"Trevor Hastie\",\n                \"Robert Tibshirani\",\n                \"Jerome Friedman\"\n            ]\n        },\n        {\n            \"title\": \"Statistical Genetics: Gene Mapping Through Linkage Analysis\",\n            \"authors\": [\n                \"Bruce S. Weir\"\n            ]\n        }\n    ]\n}"}
