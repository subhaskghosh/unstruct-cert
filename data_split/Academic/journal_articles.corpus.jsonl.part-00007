{"_id": "Academic--journal_articles--p--69478", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2022-05-15\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 605,\n    \"issue\": 7911,\n    \"pages\": \"456-468\",\n    \"doi\": \"10.1038/s41586-022-04735-x\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"machine learning\",\n        \"computer vision\"\n    ],\n    \"abstract\": \"This article presents novel deep learning techniques for improving image recognition accuracy. We demonstrate state-of-the-art results on several benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"author\": \"Krizhevsky, A., Sutskever, I., & Hinton, G. E.\"\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"author\": \"Szegedy, C., Liu, W., Jia, Y., Sermanis, P., Reed, S., Anguelov, D., ... & Rabinovich, A.\"\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"author\": \"He, K., Zhang, X., Ren, S., & Sun, J.\"\n        },\n        {\n            \"title\": \"Attention is All You Need\",\n            \"author\": \"Vaswani, A., Shazeer, N., Parmar, N., Uszkoreit, J., Jones, L., Gomez, A. N., ... & Polosukhin, I.\"\n        },\n        {\n            \"title\": \"Generative Adversarial Nets\",\n            \"author\": \"Goodfellow, I. J., Pouget-Abadie, J., Mirza, M., Xu, B., Warde-Farley, D., Ozair, S., ... & Bengio, Y.\"\n        },\n        {\n            \"title\": \"Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift\",\n            \"author\": \"Ioffe, S., & Szegedy, C.\"\n        },\n        {\n            \"title\": \"Very Deep Convolutional Networks for Large-Scale Image Recognition\",\n            \"author\": \"Simonyan, K., & Zisserman, A.\"\n        },\n        {\n            \"title\": \"Learning Multiple Tasks with Multitask Learning\",\n            \"author\": \"Caruana, R.\"\n        },\n        {\n            \"title\": \"A Survey of Convolutional Neural Networks for Image Classification\",\n            \"author\": \"Albawi, S., Taha, T. A., Hawa, C. M., Al-omari, A. A., & Al-Rawi, A. M.\"\n        },\n        {\n            \"title\": \"Transfer Learning for Deep Learning\",\n            \"author\": \"Pan, S. J., & Yang, Q.\"\n        },\n        {\n            \"title\": \"Adaptive Gradient Algorithm for Deep Learning\",\n            \"author\": \"Duchi, J., Hazan, E., & Singer, Y.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--69478", "text": "{\n    \"title\": \"The Role of Genetics in Alzheimer's Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2023-11-01\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 623,\n    \"issue\": 7987,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1038/s41586-023-06800-w\",\n    \"keywords\": [\n        \"Alzheimer's disease\",\n        \"genetics\",\n        \"neuroscience\",\n        \"brain health\"\n    ],\n    \"abstract\": \"This study investigates the genetic factors contributing to the development of Alzheimer's disease. We identify several key genes associated with increased risk.\",\n    \"references\": [\n        {\n            \"title\": \"Familial Alzheimer disease\",\n            \"author\": \"Chartier-Harlin, M. C., Crawford, F., Haine, P., Goate, A. M., Rossor, M. N., Ridgway, A. J., ... & Alzheimer's Disease Genetics Consortium.\"\n        },\n        {\n            \"title\": \"Mutations in the presenilin 1 gene cause early-onset Alzheimer's disease\",\n            \"author\": \"Sherrington, R., Rohn, T. A., Rafajabl, M., Fullmer, M. S., Gaffney, B., Sutcliffe, J. G., ... & Pericak-Vance, M. A.\"\n        },\n        {\n            \"title\": \"APP mutations in familial Alzheimer disease\",\n            \"author\": \"Tanzi, R. E., Gusella, J. F., Watkins, C. L., Chiang, H. L., Kimble, G. S., Waggoner, D. J., ... & Bird, T. D.\"\n        },\n        {\n            \"title\": \"The epidemiology of Alzheimer's disease\",\n            \"author\": \"Alzheimer's Association.\"\n        },\n        {\n            \"title\": \"Risk genes and their effects on Alzheimer's disease\",\n            \"author\": \"Lambert, J. C., Tromp, E., & Schellenberg, G. D.\"\n        },\n        {\n            \"title\": \"The neuropathology of Alzheimer's disease\",\n            \"author\": \"Braak, H., & Braak, E.\"\n        },\n        {\n            \"title\": \"The role of inflammation in Alzheimer's disease\",\n            \"author\": \"Heneka, M. T., O'Banion, M. K., & Kummer, M. P.\"\n        },\n        {\n            \"title\": \"Amyloid beta and tau: the two pillars of Alzheimer's disease\",\n            \"author\": \"Hardy, J. A., & Higgins, G. A.\"\n        }\n    ]\n}"}
