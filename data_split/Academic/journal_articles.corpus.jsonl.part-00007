{"_id": "Academic--journal_articles--p--70183", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature Communications\",\n    \"volume\": 14,\n    \"issue\": 1,\n    \"pages\": \"1234-1245\",\n    \"doi\": \"10.1038/s41467-023-30000-x\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"medical imaging\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This study presents a novel deep learning model for the early detection of diabetic retinopathy from retinal fundus images, achieving state-of-the-art performance and demonstrating potential for clinical translation.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 7\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 8\",\n            \"author\": \"Author H\"\n        },\n        {\n            \"title\": \"Reference Article 9\",\n            \"author\": \"Author I\"