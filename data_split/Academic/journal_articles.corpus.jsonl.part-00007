{"_id": "Academic--journal_articles--p--69067", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 617,\n    \"issue\": 7943,\n    \"pages\": \"456-468\",\n    \"doi\": \"10.1038/s41586-023-06100-x\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Image Recognition\",\n        \"Convolutional Neural Networks\",\n        \"Machine Learning\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning architecture for image recognition tasks, achieving state-of-the-art results on benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Krizhevsky, A.\",\n                \"Sutskever, I.\",\n                \"Hinton, G. E.\"\n            ]\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"authors\": [\n                \"Szegedy, C.\",\n                \"Liu, W.\",\n                \"Jia, Y.\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"He, K.\",\n                \"Zhang, X.\",\n                \"Ren, S.\"\n            ]\n        },\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Vaswani, A.\",\n                \"Shazeer, N.\",\n                \"Parmar, N.\"\n            ]\n        },\n        {\n            \"title\": \"Generative Adversarial Nets\",\n            \"authors\": [\n                \"Goodfellow, I. J.\",\n                \"Pouget-Abadie, J.\",\n                \"Mirza, M.\"\n            ]\n        },\n        {\n            \"title\": \"Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift\",\n            \"authors\": [\n                \"Ioffe, S.\",\n                \"Szegedy, C.\"\n            ]\n        },\n        {\n            \"title\": \"Very Deep Convolutional Networks for Large-Scale Image Recognition\",\n            \"authors\": [\n                \"Simonyan, K.\",\n                \"Zisserman, A.\"\n            ]\n        },\n        {\n            \"title\": \"Learning Multiple Tasks with Multitask Learning\",\n            \"authors\": [\n                \"Caruana, R.\"\n            ]\n        },\n        {\n            \"title\": \"Dropout: A Simple Way to Prevent Neural Networks from Overfitting\",\n            \"authors\": [\n                \"Srivastava, N.\",\n                \"Hinton, G. E.\",\n                \"Krizhevsky, A.\"\n            ]\n        },\n        {\n            \"title\": \"Rectified Linear Units\",\n            \"authors\": [\n                \"Nair, V.\",\n                \"Khilar, G. E.\"\n            ]\n        },\n        {\n            \"title\": \"Optimizing Neural Networks with Second-Order Methods\",\n            \"authors\": [\n                \"Martens, J.\"\n            ]\n        }\n    ]\n}"}
