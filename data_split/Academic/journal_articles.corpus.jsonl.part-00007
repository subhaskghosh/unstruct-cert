{"_id": "Academic--journal_articles--p--66701", "text": "{\n    \"title\": \"Deep Learning for Predictive Analytics in Cardiology\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 85,\n    \"issue\": 2,\n    \"pages\": \"102-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"cardiology\",\n        \"predictive analytics\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This paper explores the application of deep learning techniques for predicting heart failure risk based on electronic health records. We demonstrate significant improvements over traditional statistical models.\",\n    \"references\": [\n        {\n            \"title\": \"A Comprehensive Survey of Deep Learning in Healthcare\",\n            \"authors\": [\n                \"David Smith\"\n            ]\n        },\n        {\n            \"title\": \"Predicting Cardiovascular Disease Using Machine Learning\",\n            \"authors\": [\n                \"Emily Carter\"\n            ]\n        },\n        {\n            \"title\": \"The Role of Artificial Intelligence in Modern Medicine\",\n            \"authors\": [\n                \"Frank Brown\"\n            ]\n        },\n        {\n            \"title\": \"Deep Neural Networks for Medical Diagnosis\",\n            \"authors\": [\n                \"Grace Davis\"\n            ]\n        },\n        {\n            \"title\": \"A Novel Approach to Heart Disease Detection\",\n            \"authors\": [\n                \"Henry Wilson\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66701", "text": "{\n    \"title\": \"Image Recognition for Tumor Detection in Histopathology\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"IEEE Transactions on Medical Imaging\",\n    \"volume\": 41,\n    \"issue\": 10,\n    \"pages\": \"2500-2512\",\n    \"doi\": \"10.1109/TMI.2022.3200010\",\n    \"keywords\": [\n        \"image recognition\",\n        \"tumor detection\",\n        \"histopathology\",\n        \"medical imaging\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"This study presents a convolutional neural network for automatically detecting tumors in histopathology images, achieving high accuracy and reducing diagnostic time.\",\n    \"references\": [\n        {\n            \"title\": \"Deep Learning for Image Classification\",\n            \"authors\": [\n                \"Ivan Martinez\"\n            ]\n        },\n        {\n            \"title\": \"Computer Vision Techniques for Medical Diagnosis\",\n            \"authors\": [\n                \"Jack Robinson\"\n            ]\n        }\n    ]\n}"}
