{"_id": "Academic--journal_articles--p--68595", "text": "{\n    \"title\": \"Advancements in Deep Learning for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 617,\n    \"issue\": 7942,\n    \"pages\": \"456-468\",\n    \"doi\": \"10.1038/s41586-023-06123-x\",\n    \"keywords\": [\n        \"machine learning\",\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning architecture for improved image recognition performance. We demonstrate state-of-the-art results on benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey Hinton\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"Kaiming He\",\n                \"Xiangyu Zhang\",\n                \"Shaoqing Ren\",\n                \"Jian Sun\"\n            ]\n        },\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Ashish Vaswani\",\n                \"Noam Shazeer\",\n                \"Noam Parmar\",\n                \"Jakob Uszkoreit\",\n                \"Llion Jones\",\n                \"Aidan N. Gomez\",\n                \"Łukasz Kaiser\",\n                \"Illia Polosukhin\"\n            ]\n        },\n        {\n            \"title\": \"Generative Adversarial Nets\",\n            \"authors\": [\n                \"Ian Goodfellow\",\n                \"Jean Pouget-Abadie\",\n                \"Mehdi Mirza\",\n                \"Bing Xu\",\n                \"David Warde-Farley\",\n                \"Sherjil Ozair\",\n                \"Aaron Courville\",\n                \"Yoshua Bengio\"\n            ]\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"authors\": [\n                \"Christian Szegedy\",\n                \"Wei Liu\",\n                \"Yangqing Jia\",\n                \"Pierre Sermanet\",\n                \"Scott Reed\",\n                \"Dragomir Anguelov\",\n                \"Dumitru Erhan\",\n                \"Vincent Vanhoucke\",\n                \"Andrew Rabinovich\"\n            ]\n        },\n        {\n            \"title\": \"Batch Normalization: Accelerating Deep Network Training by Reducing Internal Covariate Shift\",\n            \"authors\": [\n                \"Sergey Ioffe\",\n                \"Christian Szegedy\"\n            ]\n        },\n        {\n            \"title\": \"Very Deep Convolutional Networks for Large-Scale Image Recognition\",\n            \"authors\": [\n                \"Karen Simonyan\",\n                \"Andrew Zisserman\"\n            ]\n        },\n        {\n            \"title\": \"Learning Function Approximation with Restricted Boltzmann Machines\",\n            \"authors\": [\n                \"Geoffrey Hinton\",\n                \"David Rumelhart\",\n                \"Ronald Williams\"\n            ]\n        },\n        {\n            \"title\": \"Distributed Representations of Words and Phrases and their Compositionality\",\n            \"authors\": [\n                \"Tomas Mikolov\",\n                \"Kai Chen\",\n                \"Greg Corrado\",\n                \"Jeffrey Dean\"\n            ]\n        },\n        {\n            \"title\": \"Long Short-Term Memory\",\n            \"authors\": [\n                \"Sepp Hochreiter\",\n                \"Jürgen Schmidhuber\"\n            ]\n        },\n        {\n            \"title\": \"Adam: A Method for Stochastic Optimization\",\n            \"authors\": [\n                \"Diederik P. Kingma\",\n                \"Jimmy Ba\"\n            ]\n        }\n    ]\n}"}
