{"_id": "Academic--journal_articles--n--67052", "text": "{\n    \"title\": \"Genomic Sequencing of Rare Diseases\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 609,\n    \"issue\": 7927,\n    \"pages\": \"456-470\",\n    \"doi\": \"10.1038/s41586-022-05289-w\",\n    \"keywords\": [\n        \"genomics\",\n        \"rare diseases\",\n        \"sequencing\",\n        \"genetics\"\n    ],\n    \"abstract\": \"This study details the genomic sequencing efforts focused on identifying the genetic causes of rare diseases.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--67053", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"101-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This study investigates the use of deep learning models for automated diagnosis of diabetic retinopathy from retinal fundus images. The results demonstrate a high degree of accuracy and potential for clinical application.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67053", "text": "{\n    \"title\": \"Machine Learning Approaches to Cancer Treatment Optimization\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Journal of Clinical Oncology\",\n    \"volume\": 11,\n    \"issue\": 4,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.1200/JCO.2022.40.10.250\",\n    \"keywords\": [\n        \"machine learning\",\n        \"cancer\",\n        \"treatment optimization\",\n        \"oncology\",\n        \"clinical trials\"\n    ],\n    \"abstract\": \"This research explores machine learning algorithms for optimizing cancer treatment strategies. The findings suggest that personalized treatment plans can improve patient outcomes.\",\n    \"references\": []\n}"}
