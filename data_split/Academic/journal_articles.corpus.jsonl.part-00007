{"_id": "Academic--journal_articles--p--67202", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"IEEE Transactions on Medical Imaging\",\n    \"volume\": 42,\n    \"issue\": 6,\n    \"pages\": \"1234-1245\",\n    \"doi\": \"10.1109/TMI.2023.3278901\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Medical Imaging\",\n        \"Diabetic Retinopathy\",\n        \"Image Analysis\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for the automated diagnosis of diabetic retinopathy from retinal fundus images. The proposed method achieves state-of-the-art performance on multiple benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"Convolutional Neural Networks for Image Recognition\",\n            \"authors\": [\n                \"Krizhevsky, A.\",\n                \"Sutskever, I.\",\n                \"Hinton, G. E.\"\n            ]\n        },\n        {\n            \"title\": \"ImageNet Large Scale Visual Recognition Challenge\",\n            \"authors\": [\n                \"Deng, J.\",\n                \"Dong, W.\",\n                \"Socher, R.\",\n                \"Li, L. J.\",\n                \"Li, K.\",\n                \"Fei-Fei, L.\"\n            ]\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"authors\": [\n                \"He, K.\",\n                \"Zhang, X.\",\n                \"Ren, S.\",\n                \"Sun, J.\"\n            ]\n        },\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Vaswani, A.\",\n                \"Shazeer, N.\",\n                \"Parmar, N.\",\n                \"Uszkoreit, J.\",\n                \"Jones, L.\",\n                \"Gomez, A. N.\",\n                \"Kaiser, Ł., Polosukhin, I.\"\n            ]\n        },\n        {\n            \"title\": \"U-Net: Convolutional Networks for Biomedical Image Segmentation\",\n            \"authors\": [\n                \"Ronneberger, O.\",\n                \"Fischer, P.\",\n                \"Brox, T.\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67202", "text": "{\n    \"title\": \"Traditional Image Processing Techniques for Lung Nodule Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2022-11-01\",\n    \"journal_name\": \"Journal of Digital Imaging\",\n    \"volume\": 35,\n    \"issue\": 4,\n    \"pages\": \"678-689\",\n    \"doi\": \"10.1007/s10278-022-00567-x\",\n    \"keywords\": [\n        \"Image Processing\",\n        \"Lung Nodules\",\n        \"Medical Imaging\",\n        \"Computer-Aided Detection\"\n    ],\n    \"abstract\": \"This study explores the effectiveness of conventional image processing methods for detecting lung nodules in CT scans. The results demonstrate that these techniques can provide useful preliminary screening.\",\n    \"references\": [\n        {\n            \"title\": \"Image Enhancement Techniques\",\n            \"authors\": [\n                \"Gonzales, R. C.\",\n                \"Woods, R. E.\"\n            ]\n        },\n        {\n            \"title\": \"Digital Image Processing\",\n            \"authors\": [\n                \"Castleman, K. I.\"\n            ]\n        },\n        {\n            \"title\": \"A Review of Lung Nodule Detection Methods\",\n            \"authors\": [\n                \"Swensen, S. J.\",\n                \"Sheedy II, P. F.\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--67203", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Diagnosis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 145,\n    \"issue\": 2,\n    \"pages\": \"104-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104223\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image recognition\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for the automated diagnosis of diabetic retinopathy from retinal fundus images. Our model achieves state-of-the-art performance and demonstrates the potential for widespread clinical application.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey E. Hinton\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67203", "text": "{\n    \"title\": \"Traditional Statistical Methods in Epidemiology\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-03-01\",\n    \"journal_name\": \"American Journal of Epidemiology\",\n    \"volume\": 190,\n    \"issue\": 4,\n    \"pages\": \"500-510\",\n    \"doi\": \"10.1093/aje/kwae012\",\n    \"keywords\": [\n        \"epidemiology\",\n        \"statistical analysis\",\n        \"public health\",\n        \"regression\"\n    ],\n    \"abstract\": \"This article reviews common statistical methods used in epidemiological research, focusing on regression models and hypothesis testing.\",\n    \"references\": [\n        {\n            \"title\": \"Applied Regression Analysis\",\n            \"authors\": [\n                \"Draper & Smith\"\n            ]\n        }\n    ]\n}"}
