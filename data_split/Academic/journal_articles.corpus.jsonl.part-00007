{"_id": "Academic--journal_articles--p--67784", "text": "{\n    \"title\": \"Carbon Sequestration in Biochar-Amended Soils: A Meta-Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"University of California, Davis\"\n        },\n        {\n            \"name\": \"Anna Schmidt\",\n            \"affiliation\": \"ETH Zurich\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Sustainable Agriculture\",\n    \"volume\": 15,\n    \"issue\": 3,\n    \"pages\": \"123-145\",\n    \"doi\": \"10.1080/10440046.2023.1234567\",\n    \"keywords\": [\n        \"biochar\",\n        \"carbon sequestration\",\n        \"soil health\",\n        \"sustainable agriculture\",\n        \"carbon footprint\"\n    ],\n    \"abstract\": \"This meta-analysis examines the effects of biochar amendment on carbon sequestration in various soil types. Results indicate significant potential for reducing atmospheric carbon dioxide levels through widespread biochar application in agricultural systems.\",\n    \"references\": [\n        {\n            \"title\": \"Biochar effects on soil properties and plant productivity\",\n            \"author\": \"Lehmann, J., et al.\"\n        },\n        {\n            \"title\": \"The global potential of biochar for soil amendment\",\n            \"author\": \"Woolf, D., et al.\"\n        },\n        {\n            \"title\": \"Carbon sequestration in agricultural soils\",\n            \"author\": \"Lal, R.\"\n        },\n        {\n            \"title\": \"Environmental impacts of biochar\",\n            \"author\": \"Jones, M.\"\n        },\n        {\n            \"title\": \"Sustainable agriculture\",\n            \"author\": \"Smith, A.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67784", "text": "{\n    \"title\": \"Optimizing Feed Efficiency in Dairy Cattle Through Genomic Selection\",\n    \"authors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Iowa State University\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"University of Wisconsin-Madison\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Journal of Animal Science\",\n    \"volume\": 90,\n    \"issue\": 12,\n    \"pages\": \"4567-4580\",\n    \"doi\": \"10.2527/jas.2022-00123\",\n    \"keywords\": [\n        \"dairy cattle\",\n        \"genomic selection\",\n        \"feed efficiency\",\n        \"animal breeding\"\n    ],\n    \"abstract\": \"This study investigates the application of genomic selection to improve feed efficiency in dairy cattle, leading to increased milk production and reduced resource consumption.\",\n    \"references\": [\n        {\n            \"title\": \"Genomic selection in dairy cattle\",\n            \"author\": \"VanRaden, P.M., et al.\"\n        },\n        {\n            \"title\": \"Feed efficiency and its genetic basis\",\n            \"author\": \"Berry, D.P., et al.\"\n        },\n        {\n            \"title\": \"Genomic evaluation for milk production\",\n            \"author\": \"Dekkers, J.C.M., et al.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--67785", "text": "{\n    \"title\": \"Deep Learning for Image Recognition: A Comprehensive Review\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2022-05-15\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 44,\n    \"issue\": 6,\n    \"pages\": \"1234-1250\",\n    \"doi\": \"10.1109/TPAMI.2022.3178923\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"convolutional neural networks\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This paper provides a comprehensive review of deep learning techniques for image recognition, covering recent advances and challenges.\",\n    \"references\": [\n        {\n            \"title\": \"ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"author\": \"Krizhevsky, A., Sutskever, I., & Hinton, G. E.\"\n        },\n        {\n            \"title\": \"Going Deeper with Convolutions\",\n            \"author\": \"Szegedy, C., Liu, W., Jia, Y., Sermanis, P., Reed, S., Anguelov, D., ... & Rabinovich, A.\"\n        },\n        {\n            \"title\": \"Deep Residual Learning for Image Recognition\",\n            \"author\": \"He, K., Zhang, X., Ren, S., & Sun, J.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67785", "text": "{\n    \"title\": \"The Role of Artificial Intelligence in Cancer Diagnosis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"publication_date\": \"2023-01-20\",\n    \"journal_name\": \"The Lancet Oncology\",\n    \"volume\": 24,\n    \"issue\": 1,\n    \"pages\": \"56-68\",\n    \"doi\": \"10.1016/S1470-2045(22)00621-8\",\n    \"keywords\": [\n        \"artificial intelligence\",\n        \"cancer diagnosis\",\n        \"medical imaging\",\n        \"oncology\"\n    ],\n    \"abstract\": \"This article explores the application of artificial intelligence techniques in improving the accuracy and efficiency of cancer diagnosis.\",\n    \"references\": [\n        {\n            \"title\": \"Deep Learning for Medical Image Analysis\",\n            \"author\": \"Litjens, G., Kooi, T., Bejnordi, B. E., Setio, A. A. A., Ciompi, F., Ghafoorian, M., ... & van der Laak, J. A. W. M.\"\n        },\n        {\n            \"title\": \"Artificial Intelligence in Healthcare: Past, Present and Future\",\n            \"author\": \"Jiang, F., Jiang, Y., Zhi, H., Dong, Y., Li, H., Ma, S., ... & Wang, Y.\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--67786", "text": "{\n    \"title\": \"A Novel Deep Learning Architecture for Image Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Machine Learning Research\",\n    \"volume\": 12,\n    \"issue\": 1,\n    \"pages\": \"1-25\",\n    \"doi\": \"10.1234/jmlr.2023.12.1.1\",\n    \"keywords\": [\n        \"deep learning\",\n        \"image recognition\",\n        \"neural networks\",\n        \"convolutional neural networks\"\n    ],\n    \"abstract\": \"This paper introduces a novel deep learning architecture for image recognition that achieves state-of-the-art results on several benchmark datasets. The architecture is based on convolutional neural networks and incorporates a novel attention mechanism.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67786", "text": "{\n    \"title\": \"Recent Advances in Pattern Recognition\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 34,\n    \"issue\": 5,\n    \"pages\": \"880-895\",\n    \"doi\": \"10.1109/TPAMI.2022.3212345\",\n    \"keywords\": [\n        \"pattern recognition\",\n        \"machine learning\",\n        \"classification\"\n    ],\n    \"abstract\": \"This survey paper provides an overview of recent advances in pattern recognition, covering a wide range of topics including image recognition, speech recognition, and natural language processing.\",\n    \"references\": []\n}"}
