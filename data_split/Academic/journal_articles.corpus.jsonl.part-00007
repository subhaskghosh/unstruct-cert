{"_id": "Academic--journal_articles--p--66512", "text": "{\n    \"title\": \"Deep Reinforcement Learning for Robotics Control\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Artificial Intelligence Research\",\n    \"volume\": 78,\n    \"issue\": 2,\n    \"pages\": \"234-256\",\n    \"doi\": \"10.1613/jair.1234\",\n    \"keywords\": [\n        \"machine learning\",\n        \"reinforcement learning\",\n        \"robotics\",\n        \"control systems\"\n    ],\n    \"abstract\": \"This article presents a novel approach to robotics control using deep reinforcement learning. We demonstrate significant improvements in performance compared to traditional methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66512", "text": "{\n    \"title\": \"Machine Learning for Diagnosis of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"publication_date\": \"2024-03-10\",\n    \"journal_name\": \"Ophthalmology Journal\",\n    \"volume\": 120,\n    \"issue\": 1,\n    \"pages\": \"10-25\",\n    \"doi\": \"10.1016/j.ophtha.2024.01.001\",\n    \"keywords\": [\n        \"machine learning\",\n        \"diabetic retinopathy\",\n        \"medical imaging\",\n        \"diagnosis\"\n    ],\n    \"abstract\": \"This research investigates the application of machine learning techniques to improve the diagnosis of diabetic retinopathy from retinal images.\",\n    \"references\": []\n}"}
