{"_id": "Academic--academic_worksho--n--71995", "text": "{\n    \"workshop_title\": \"Advanced Machine Learning Techniques\",\n    \"workshop_leader\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Data Science Consulting Inc.\"\n    },\n    \"date_scheduled\": \"2023-11-20\",\n    \"duration\": 12.0,\n    \"target_audience\": \"Experienced data scientists and machine learning engineers\",\n    \"topics\": [\n        \"Deep learning\",\n        \"Reinforcement learning\",\n        \"Natural language processing\",\n        \"Computer vision\"\n    ],\n    \"registration_fee\": 400.0,\n    \"location\": \"Online - Zoom\",\n    \"contact_information\": {\n        \"email\": \"john.smith@dsconsulting.com\",\n        \"phone\": \"555-555-5555\"\n    }\n}"}
{"_id": "Academic--academic_worksho--p--71996", "text": "{\n    \"workshop_title\": \"Applied Data Science with Python\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_scheduled\": \"2024-03-15\",\n    \"duration\": 6.5,\n    \"target_audience\": \"Professionals seeking to apply data science techniques in their field; career changers.\",\n    \"topics\": [\n        \"Data Cleaning\",\n        \"Exploratory Data Analysis\",\n        \"Machine Learning Algorithms\",\n        \"Data Visualization\"\n    ],\n    \"registration_fee\": 450.0,\n    \"location\": \"Stanford University, Gates Computer Science Building\",\n    \"contact_information\": {\n        \"email\": \"datascience@stanford.edu\",\n        \"phone\": \"650-723-4300\"\n    }\n}"}
