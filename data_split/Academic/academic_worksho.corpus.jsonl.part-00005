{"_id": "Academic--academic_worksho--p--71999", "text": "{\n    \"workshop_title\": \"Introduction to Data Analysis with Python\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_scheduled\": \"2024-03-15\",\n    \"duration\": 6.0,\n    \"target_audience\": \"Students and professionals with basic programming knowledge who want to learn data analysis.\",\n    \"topics\": [\n        \"Data cleaning\",\n        \"Data visualization\",\n        \"Statistical analysis\",\n        \"Python libraries (Pandas, NumPy, Matplotlib)\"\n    ],\n    \"registration_fee\": 250.0,\n    \"location\": \"Stanford University Campus\",\n    \"contact_information\": {\n        \"email\": \"data.analysis@stanford.edu\",\n        \"phone\": \"+1-650-723-4567\"\n    }\n}"}
{"_id": "Academic--academic_worksho--n--71999", "text": "{\n    \"workshop_title\": \"Advanced Deep Reinforcement Learning for Robotics\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_scheduled\": \"2024-04-20\",\n    \"duration\": 8.0,\n    \"target_audience\": \"Researchers and engineers with a strong background in machine learning and robotics.\",\n    \"topics\": [\n        \"Deep Q-Networks\",\n        \"Policy Gradients\",\n        \"Actor-Critic Methods\",\n        \"Simulation and Deployment\"\n    ],\n    \"registration_fee\": 350.0,\n    \"location\": \"MIT AI Lab\",\n    \"contact_information\": {\n        \"email\": \"rl.robotics@mit.edu\",\n        \"phone\": \"+1-617-253-8000\"\n    }\n}"}
