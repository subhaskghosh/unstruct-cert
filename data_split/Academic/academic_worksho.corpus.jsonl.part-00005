{"_id": "Academic--academic_worksho--p--71997", "text": "{\n    \"workshop_title\": \"Introduction to Python for Data Science\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Statistics\"\n    },\n    \"date_scheduled\": \"2024-10-27\",\n    \"duration\": 16.0,\n    \"target_audience\": \"Beginners with no prior programming experience interested in learning data science fundamentals.\",\n    \"topics\": [\n        \"Python basics\",\n        \"Data manipulation with Pandas\",\n        \"Data visualization with Matplotlib\",\n        \"Introduction to Machine Learning\"\n    ],\n    \"registration_fee\": 350.0,\n    \"location\": \"Stanford University, Gates Computer Science Building\",\n    \"contact_information\": {\n        \"email\": \"datascience@stanford.edu\",\n        \"phone\": \"+1-650-723-4000\"\n    }\n}"}
{"_id": "Academic--academic_worksho--n--71997", "text": "{\n    \"workshop_title\": \"Advanced Statistical Modeling\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"Harvard University, Department of Mathematics\"\n    },\n    \"date_scheduled\": \"2024-11-15\",\n    \"duration\": 22.0,\n    \"target_audience\": \"Researchers and graduate students with a strong background in statistics and mathematics.\",\n    \"topics\": [\n        \"Generalized Linear Models\",\n        \"Bayesian Statistics\",\n        \"Time Series Analysis\",\n        \"Multivariate Analysis\"\n    ],\n    \"registration_fee\": 600.0,\n    \"location\": \"Harvard University, Science Center\",\n    \"contact_information\": {\n        \"email\": \"statmodel@harvard.edu\",\n        \"phone\": \"+1-617-495-5000\"\n    }\n}"}
{"_id": "Academic--academic_worksho--p--71998", "text": "{\n    \"workshop_title\": \"Applied Data Science for Business Analysts\",\n    \"workshop_leader\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Data Insights Consulting\"\n    },\n    \"date_scheduled\": \"2024-10-26\",\n    \"duration\": 2.5,\n    \"target_audience\": \"Business analysts, data analysts, and professionals seeking to leverage data science in their roles.\",\n    \"topics\": [\n        \"Data Cleaning and Preprocessing\",\n        \"Exploratory Data Analysis\",\n        \"Statistical Modeling\",\n        \"Machine Learning Fundamentals\",\n        \"Data Visualization\"\n    ],\n    \"registration_fee\": 450.0,\n    \"location\": \"Online - Zoom\",\n    \"contact_information\": {\n        \"email\": \"workshops@datainsights.com\",\n        \"phone\": \"555-123-4567\"\n    }\n}"}
