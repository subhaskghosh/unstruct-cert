{"_id": "resume_search--graphic_design:_--p--69280", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, and brand guidelines.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application focused on sustainable living.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research and user interviews, followed by ideation, prototyping, and iterative design refinement.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver effective design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - 2024\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging design role where I can utilize my skills and creativity to deliver impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-11-20\"\n}"}
