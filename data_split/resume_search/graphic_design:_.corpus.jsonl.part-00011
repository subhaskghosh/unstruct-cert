{"_id": "resume_search--graphic_design:_--p--70531", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines for a sustainable flower delivery service. Focused on a modern, natural aesthetic.\",\n            \"image_url\": \"https://example.com/ecobloom_logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups - 'Urban Eats'\",\n            \"description\": \"UI/UX design for a restaurant website, emphasizing user-friendliness and visually appealing food photography. Included wireframes and high-fidelity mockups.\",\n            \"image_url\": \"https://example.com/urban_eats_mockup.png\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I approach design with a user-centered methodology, starting with thorough research and brainstorming sessions. I iterate on concepts based on feedback and always prioritize visual clarity and emotional impact.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to understand their needs and deliver effective design solutions, managing projects from initial concept to final delivery.\",\n    \"design_awards\": [\n        \"Silver Award - Design Excellence 2022\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n  