   ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\",\n        \"Typography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my design skills and creativity to a challenging and innovative environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68607", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe InDesign\",\n        \"QuarkXPress\",\n        \"Adobe Acrobat\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout Design\",\n            \"description\": \"Layout design for a monthly magazine, featuring various articles and advertisements.\",\n            \"image_url\": \"https://example.com/magazine_layout.jpg\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Design of a tri-fold brochure for a local business.\",\n            \"image_url\": \"https://example.com/brochure.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on meticulous attention to detail and ensuring print-ready files. I prioritize accuracy and adherence to brand guidelines.\",\n    \"client_work_experience\": \"Years of experience working with clients to create high-quality print materials.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Applied Science in Graphic Communications\",\n            \"university\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Print Production Specialist\",\n            \"company\": \"Printing Company Y\",\n            \"duration\": \"2018 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\",\n        \"Adobe InDesign\",\n        \"QuarkXPress\",\n        \"Pre-Press\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a position where I can utilize my print production expertise.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2024-02-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--68608", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines for a sustainable floral company.\",\n            \"image_url\": \"https://example.com/ecobloom_logo.jpg\"\n        },\n        {\n            \"title\": \"Marketing Collateral for 'Urban Eats'\",\n            \"description\": \"Design of flyers, posters, and social media graphics for a local restaurant.\",\n            \"image_url\": \"https://example.com/urbaneats_flyer.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and brainstorming sessions to understand the client's vision and target audience. I then iterate through multiple concepts, refining based on feedback until we achieve a visually compelling and effective design.\",\n    \"client_work_experience\": \"Extensive experience working directly with clients to understand their needs and deliver designs that exceed expectations. Proven ability to manage projects from concept to completion, ensuring timely delivery and client satisfaction.\",\n    \"design_awards\": [],\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Print Design\",\n        \"Marketing Materials\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role within a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://avachen.portfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68608", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Mobile App Interface Design\",\n            \"description\": \"UI design for a fitness tracking application.\",\n            \"image_url\": \"https://example.com/fitnessapp_ui.jpg\"\n        },\n        {\n            \"title\": \"Website Wireframes\",\n            \"description\": \"Low-fidelity wireframes for an e-commerce website.\",\n            \"image_url\": \"https://example.com/ecommerce_wireframes.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design principles, conducting user research, creating wireframes and prototypes, and iterating based on usability testing.\",\n    \"client_work_experience\": \"Experience collaborating with product managers and developers to create user-friendly and visually appealing interfaces.\",\n    \"design_awards\": [\n        \"UX Design Award - 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Human-Computer Interaction\",\n            \"university\": \"Tech Institute\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Innovations Ltd.\",\n            \"start_date\": \"2021-07-01\",\n            \"end_date\": \"Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Wireframing\",\n        \"Prototyping\",\n        \"Usability Testing\",\n        \"Figma\",\n        \"Sketch\"\n  