: \"To leverage my UI/UX design skills to create exceptional user experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ethancarterdesign.com\"\n    ],\n    \"availability\": \"2024-04-30\"\n}"}
