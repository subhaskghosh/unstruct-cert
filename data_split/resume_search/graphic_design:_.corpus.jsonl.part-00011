{"_id": "resume_search--graphic_design:_--p--70943", "text": "{\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"California Institute of the Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"BrandFirst Agency\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2021-12-31\",\n            \"description\": \"Developed branding materials and marketing collateral for diverse clients.\"\n        },\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"start_date\": \"2022-01-01\",\n            \"end_date\": \"2024-01-01\",\n            \"description\": \"Designed user interfaces and improved user experiences for web and mobile applications.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Visual Communication\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity package for a sustainable beauty brand, including logo, color palette, typography, and marketing materials.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"UI Design for 'Mobile Banking App'\",\n            \"description\": \"Redesign of a mobile banking app focusing on user-friendliness and accessibility.\",\n            \"url\": \"https://example.com/bankingapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding and UI/UX\",\n    \"creative_process\": \"My process starts with thorough research and understanding the client's needs. I then move into ideation and sketching, followed by digital design and refinement.\",\n    \"client_work_experience\": \"I have extensive experience collaborating directly with clients, managing feedback, and delivering projects on time and within budget.\",\n    \"portfolio_links\": [\n        \"https://avachen.com\"\n    ],\n    \"availability\": \"2024-02-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70943", "text": "{\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Marketing\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2017\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Marketing Assistant\",\n            \"company\": \"Creative Marketing Solutions\",\n            \"start_date\": \"2017-08-01\",\n            \"end_date\": \"2020-05-31\",\n            \"description\": \"Supported marketing campaigns and created social media content.\"\n        }\n    ],\n    \"skills\": [\n        \"Social Media Marketing\",\n        \"Content Creation\",\n        \"Copywriting\",\n        \"Adobe Photoshop\",\n        \"Basic Graphic Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Canva\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"A collection of graphics created for various social media campaigns.\",\n            \"url\": \"https://example.com/socialgraphics\"\n        }\n    ],\n    \"design_specialization\": \"Social Media Marketing\",\n    \"creative_process\": \"I focus on creating visually appealing content that aligns with brand guidelines and marketing objectives.\",\n    \"client_work_experience\": \"I have experience working with clients to develop and execute social media campaigns.\",\n    \"portfolio_links\": [\n        \"https://bencarter.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--70944", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Brand Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        },\n        {\n            \"title\": \"Design Intern\",\n            \"company\": \"Creative Agency X\",\n            \"duration\": \"Summer 2019\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity including logo, color palette, and style guide for a new tech startup.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed the user interface and user experience for a mobile application focused on health and wellness.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative and iterative design process, starting with thorough research and concept development, followed by prototyping and refinement based on client feedback.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients to understand their needs and deliver effective design solutions.\",\n    \"portfolio_links\": [\n        \"https://www.anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
