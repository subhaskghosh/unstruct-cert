{"_id": "resume_search--graphic_design:_--p--68259", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand overhaul for a sustainable flower delivery service, including logo design, color palette, typography, and brand guidelines.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for 'CityMapper' App\",\n            \"description\": \"Redesign of key user flows for a city navigation app, focusing on user experience and intuitive interface design.\",\n            \"image_url\": \"https://example.com/citymapper.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My creative process begins with in-depth research and understanding of the client's needs and target audience. I then move into ideation and sketching, followed by digital prototyping and iterative refinement based on feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients, managing feedback, and delivering projects on time and within budget. I'm adept at translating client visions into compelling visual solutions.\",\n    \"design_awards\": [\n        \"AIGA 2022 Design Excellence Award\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"DesignHub Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Visual Communication\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert (Photoshop)\"\n    ],\n    \"objective\": \"Seeking a challenging and creative role where I can leverage my branding and UI/UX design skills to create impactful visual experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
