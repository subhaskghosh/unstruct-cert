{"_id": "resume_search--graphic_design:_--p--71966", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'Bloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines.\",\n            \"image_url\": \"https://example.com/bloom_logo.jpg\"\n        },\n        {\n            \"title\": \"Packaging Design for 'Artisan Coffee'\",\n            \"description\": \"Packaging design for a new line of artisan coffee beans.\",\n            \"image_url\": \"https://example.com/coffee_packaging.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and concept development, followed by iterative design and refinement based on client feedback.\",\n    \"client_work_experience\": \"Over 5 years of experience working directly with clients, managing projects from initial brief to final delivery, ensuring client satisfaction throughout the process.\",\n    \"design_awards\": [\n        \"Silver Award - Design Excellence 2022\"\n    ],\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Print Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative expertise and passion for branding to a challenging and rewarding design position.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
