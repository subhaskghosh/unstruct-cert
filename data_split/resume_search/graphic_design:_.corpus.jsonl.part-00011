Design\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Client Communication\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a dynamic team and deliver impactful design solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70710", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration for Children's Book\",\n            \"description\": \"Detailed illustrations for a children's storybook.\",\n            \"url\": \"https://example.com/childrensbook\"\n        },\n        {\n            \"title\": \"Flyer Design for Local Event\",\n            \"description\": \"Promotional flyer for a community event.\",\n            \"url\": \"https://example.com/eventflyer\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy bringing imaginative concepts to life through detailed illustrations. I focus on creating visually engaging artwork that captures the essence of the story or message.\",\n    \"client_work_experience\": \"2 years of freelance work with small clients.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Storytelling\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To further develop my illustration skills and contribute to creative projects.\",\n    \"languages\": [\n        \"English\"\n    