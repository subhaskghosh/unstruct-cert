{"_id": "resume_search--graphic_design:_--p--71019", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity, including logo, color palette, and typography, for a new tech startup. Focused on a minimalist and modern aesthetic.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed the user interface and user experience for a mobile application, prioritizing usability and visual appeal.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX Design\",\n    \"creative_process\": \"I begin each project with thorough research and brainstorming, followed by sketching and prototyping. I iterate based on client feedback, ensuring the final design aligns with their vision and brand guidelines.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with diverse clients, managing projects from concept to completion, and consistently delivering designs that meet their objectives.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\",\n        \"Web Design Award 2023\"\n    ],\n    \"name\": \"Alice Wonderland\",\n    \"contact_information\": {\n        \"email\": \"alice.wonderland@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my skills and creativity to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicewonderland.com/portfolio\"\n    ],\n    \"availability\": \"2024-10-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71019", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Project\",\n            \"description\": \"A series of detailed illustrations for a children's book.\",\n            \"url\": \"https://example.com/portfolio/illustrations\"\n        },\n        {\n            \"title\": \"Website Mockup\",\n            \"description\": \"Mockup design for a corporate website.\",\n            \"url\": \"https://example.com/portfolio/website\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I usually start with a rough sketch and then refine it digitally, focusing on detail and accuracy.\",\n    \"client_work_experience\": \"Over 2 years of freelance work, mostly focused on illustration projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob The Builder\",\n    \"contact_information\": {\n        \"email\": \"bob.builder@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Illustration\",\n            \"university\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"Sketch\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking freelance illustration opportunities.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobbuilder.com/portfolio\"\n    ],\n    \"availability\": \"2024-11-15\"\n}"}
