{"_id": "resume_search--graphic_design:_--n--69496", "text": "{\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Mobile App Interface\",\n            \"description\": \"Designed a user-friendly interface for a mobile application.\",\n            \"image_url\": \"https://example.com/app.jpg\"\n        },\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Created engaging social media graphics for a variety of clients.\",\n            \"image_url\": \"https://example.com/social.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design principles and iterative prototyping to create effective and engaging user experiences.\",\n    \"client_work_experience\": \"Worked closely with clients to understand their target audiences and create designs that resonate with them.\",\n    \"design_awards\": [],\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"Tech Institute\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"ABC Corp\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Wireframing\",\n        \"User Testing\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"To contribute to the creation of innovative and user-centric