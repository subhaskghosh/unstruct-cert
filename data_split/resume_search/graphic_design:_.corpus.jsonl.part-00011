{"_id": "resume_search--graphic_design:_--p--69974", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for EcoWear\",\n            \"description\": \"Complete branding package including logo design, color palette, and brand guidelines.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile health and fitness application.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research, followed by ideation and sketching, then digital design and iterative refinement based on feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients throughout the design process, from initial concept to final delivery.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Graphic Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com/portfolio\"\n    ],\n    \"availability\": \"2024-10-20\"\n}"}
