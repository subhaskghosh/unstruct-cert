{"_id": "resume_search--graphic_design:_--p--71215", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Tech Startup Logo Design\",\n            \"description\": \"Designed a modern and scalable logo for a fintech startup. Included brand guidelines and color palette.\"\n        },\n        {\n            \"title\": \"Mobile App Interface\",\n            \"description\": \"UI/UX design for a mobile app focused on user engagement.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative process, starting with thorough research and sketching before moving to digital implementation. I prioritize client feedback at every stage.\",\n    \"client_work_experience\": \"Extensive experience working directly with clients to understand their needs and deliver effective visual solutions, particularly within the tech industry.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Brand Identity\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and passion for branding to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
