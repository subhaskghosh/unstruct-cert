{"_id": "resume_search--graphic_design:_--p--70580", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"BrandForward Inc.\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Developed branding materials and marketing collateral for various clients.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"UI Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"A complete brand identity package including logo, color palette, typography, and guidelines. Focused on a minimalist and modern aesthetic.\",\n            \"url\": \"http://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"Marketing Collateral for Sustainable Clothing Brand\",\n            \"description\": \"Designed social media graphics and website banners using a cohesive and visually appealing style.\",\n            \"url\": \"http://example.com/portfolio/sustainablefashion\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough client research and concept development, iterating on designs based on feedback until a compelling visual solution is achieved. I prioritize clear communication and a collaborative approach.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver design solutions that exceed expectations. Successfully managed projects from concept to completion, ensuring client satisfaction.\",\n    \"design_awards\": [],\n    \"portfolio_links\": [\n        \"http://example.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70580", "text": "{\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"college\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Designer\",\n            \"company\": \"Print Solutions Ltd.\",\n            \"start_date\": \"2022-08-01\",\n            \"end_date\": \"2023-10-31\",\n            \"description\": \"Assisted senior designers with layout and production of print materials.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Print Design\",\n        \"Layout\",\n        \"Typography\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe InDesign\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brochure Design for Local Restaurant\",\n            \"description\": \"A tri-fold brochure highlighting the restaurant's menu and specials.\",\n            \"url\": \"http://example.com/portfolio/restaurantbrochure\"\n        },\n        {\n            \"title\": \"Flyer Design for Community Event\",\n            \"description\": \"A promotional flyer for a local community event.\",\n            \"url\": \"http://example.com/portfolio/communityflyer\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on delivering technically accurate designs that meet the client's specifications. My approach is detail-oriented and practical.\",\n    \"client_work_experience\": \"Limited direct client interaction. Primarily worked under the guidance of senior designers to execute their visions.