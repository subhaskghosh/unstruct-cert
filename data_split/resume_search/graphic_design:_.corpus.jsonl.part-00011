{"_id": "resume_search--graphic_design:_--n--71037", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for 'Pet Pals'\",\n            \"description\": \"Simple logo design for a local pet store.\"\n        },\n        {\n            \"title\": \"Flyer for 'Summer Sale'\",\n            \"description\": \"Promotional flyer for a retail store.\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I prefer a more free-flowing creative process, allowing the design to evolve organically without strict adherence to user research.\",\n    \"client_work_experience\": \"I primarily work with art directors and project managers, with limited direct client interaction.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Art\",\n            \"college\": \"Community College of Anytown\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Illustrator\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Digital Painting\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To expand my skills as an illustrator and contribute to exciting art projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bencarterillustrations.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71038", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Tech Startup Branding\",\n            \"description\": \"Complete branding package for a new tech startup, including logo, color palette, and website mockups. Focused on a modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/tech_branding.jpg\"\n        },\n        {\n            \"title\": \"Mobile App UI Design\",\n            \"description\": \"UI/UX design for a mobile application, emphasizing user experience and visual appeal.\",\n            \"image_url\": \"https://example.com/app_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin each project with thorough research and brainstorming, followed by sketching and digital prototyping. I prioritize client feedback throughout the entire process.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver designs that exceed expectations. I am skilled in presenting concepts and incorporating feedback effectively.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Innovate Design Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n