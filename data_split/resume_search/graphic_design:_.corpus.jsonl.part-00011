{"_id": "resume_search--graphic_design:_--p--71196", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Rebranding for Tech Startup\",\n            \"description\": \"Complete rebranding project including logo design, color palette, and brand guidelines. Modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/techstartup.jpg\"\n        },\n        {\n            \"title\": \"Packaging Design for Coffee Brand\",\n            \"description\": \"Designed packaging for a new coffee brand, focusing on a clean and contemporary look.\",\n            \"image_url\": \"https://example.com/portfolio/coffeepackaging.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin each project with thorough research and client collaboration, followed by sketching and digital prototyping. I prioritize simplicity and user experience.\",\n    \"client_work_experience\": \"Extensive experience working directly with clients, managing feedback, and delivering projects on time and within budget.\",\n    \"design_awards\": [\n        \"Golden A' Design Award 2022 - Branding Category\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Senior Graphic Designer\",\n            \"company\": \"Creative Agency X\",\n            \"duration\": \"2019 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",