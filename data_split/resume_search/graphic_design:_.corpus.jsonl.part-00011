{"_id": "resume_search--graphic_design:_--p--71868", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'Bloom'\",\n            \"description\": \"Complete brand identity design, including logo, color palette, typography, and brand guidelines.  Focus on a modern, minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/bloom_logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'Tech Solutions'\",\n            \"description\": \"UI/UX design for a technology company's website. Emphasized user experience and visual appeal.\",\n            \"image_url\": \"https://example.com/tech_solutions_website.png\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and brainstorming before moving into sketching and digital prototyping. I prioritize client feedback throughout the entire process.\",\n    \"client_work_experience\": \"I have consistently delivered projects on time and within budget, maintaining strong communication with clients to ensure their vision is realized. I've successfully managed projects from initial concept to final delivery.\",\n    \"design_awards\": [],\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Graphic Designer\",\n            \"company\": \"Creative Agency X\",\n            \"duration\": \"2021 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role in a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71868", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\",\n        \"Inkscape\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Digital Painting - Landscape\",\n            \"description\": \"A digital painting showcasing landscape scenery.\",\n            \"image_url\": \"https://example.com/landscape.jpg\"\n        },\n        {\n            \"title\": \"3D Model - Abstract Sculpture\",\n            \"description\": \"An abstract sculpture created using 3D modeling software.\",\n            \"image_url\": \"https://example.com/sculpture.png\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy exploring different artistic styles and techniques to create unique and visually appealing artwork.\",\n    \"client_work_experience\": \"I have limited experience working directly with clients on design projects.\",\n    \"design_awards\": [\n        \"Local Art Competition - 1st Place\"\n    ],\n    \"name\": \"Arthur Bell\",\n    \"contact_information\": {\n        \"email\": \"arthur.bell@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"City College\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Digital Painting\",\n        \"3D Modeling\",\n        \"Illustration\",\n        \"Concept Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career in the arts and contribute my skills to creative projects.\",\n    \"languages\": [\n        \"English\",\n        \"S