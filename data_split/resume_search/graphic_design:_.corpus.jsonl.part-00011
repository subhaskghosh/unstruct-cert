{"_id": "resume_search--graphic_design:_--n--70106", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Web Design for 'TechHub'\",\n            \"description\": \"Design of a website for a technology blog, focusing on clean layouts and user-friendly navigation.\",\n            \"url\": \"https://example.com/techhub\"\n        },\n        {\n            \"title\": \"App Icon Design\",\n            \"description\": \"Creation of a set of app icons for a mobile game.\",\n            \"url\": \"https://example.com/appicons\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user research and creating wireframes before moving on to the visual design stage. My goal is to build intuitive and functional interfaces.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients, primarily on web and app design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Liam O'Connell\",\n    \"contact_information\": {\n        \"email\": \"liam.oconnell@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"City College\",\n            \"year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Web Innovations\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Wireframing\",\n        \"Prototyping\",\n        \"Figma\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"To leverage my UI/UX skills to create innovative and