{"_id": "resume_search--graphic_design:_--p--70327", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Startup X\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide.\",\n            \"url\": \"https://example.com/startupx\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App Y\",\n            \"description\": \"User interface and user experience design for a mobile application focused on productivity.\",\n            \"url\": \"https://example.com/appY\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and prototyping. I iterate based on feedback and focus on creating visually compelling and user-centered designs.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, understanding their needs, and delivering designs that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency A\",\n            \"duration\": \"2020 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [