{"_id": "resume_search--graphic_design:_--p--69279", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Designed a modern and minimalist logo for a new tech startup focusing on AI solutions.\",\n            \"image_url\": \"https://example.com/logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockup\",\n            \"description\": \"Created a visually appealing website mockup for a local business.\",\n            \"image_url\": \"https://example.com/website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative process, starting with thorough research and sketching, followed by digital iterations and feedback incorporation.\",\n    \"client_work_experience\": \"Over 3 years of experience working directly with clients to deliver high-quality design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020-2023\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can utilize my skills and experience to create impactful visuals.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-02-15\"\n}"}
