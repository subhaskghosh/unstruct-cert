{"_id": "resume_search--graphic_design:_--p--70813", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity including logo, color palette, typography, and brand guidelines for a tech startup focused on sustainable energy solutions. Focused on clean lines and a modern aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/tech_startup_branding.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for E-commerce Client\",\n            \"description\": \"Designed website mockups for an e-commerce client selling handcrafted jewelry. Emphasis on user experience and visual appeal.\",\n            \"image_url\": \"https://example.com/portfolio/ecommerce_website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process begins with thorough research and understanding the client's needs and target audience. I then brainstorm multiple concepts, create mood boards, and iterate on designs based on feedback, always striving for innovative and effective solutions.\",\n    \"client_work_experience\": \"I have over 4 years of experience working directly with clients, managing projects from initial concept to final delivery, and consistently exceeding their expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2019-06-01\",\n            \"end_date\": \"2023-06-01\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Web Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70813", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Painting\",\n            \"description\": \"Oil painting depicting a landscape scene.\",\n            \"image_url\": \"https://example.com/portfolio/landscape_painting.jpg\"\n        },\n        {\n            \"title\": \"Watercolor Portrait\",\n            \"description\": \"Watercolor portrait of a family member.\",\n            \"image_url\": \"https://example.com/portfolio/watercolor_portrait.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I generally start with a rough sketch and refine it until I'm satisfied with the result.\",\n    \"client_work_experience\": \"I have limited experience working directly with clients, mostly personal projects.\",\n    \"design_awards\": [],\n    \"name\": \"Arthur Penhaligon\",\n    \"contact_information\": {\n        \"email\": \"arthur.penhaligon@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Art Intern\",\n            \"company\": \"Local Art Gallery\",\n            \"start_date\": \"2020-07-01\",\n            \"end_date\": \"2021-01-01\"\n        }\n    ],\n    \"skills\": [\n        \"Painting\",\n        \"Drawing\",\n        \"Watercolor\",\n        \"Illustration\",\n        \"Adobe Photoshop\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking an opportunity to utilize my artistic talents.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n      