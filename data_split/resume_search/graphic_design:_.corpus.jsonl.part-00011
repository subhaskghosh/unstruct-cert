{"_id": "resume_search--graphic_design:_--p--68550", "text": "{\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Brand Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Client Communication\",\n        \"Project Management\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity, including logo, color palette, and typography, for a new tech startup. Focused on clean lines and a modern aesthetic.\"\n        },\n        {\n            \"title\": \"Rebranding for Local Restaurant\",\n            \"description\": \"Rebranded a local restaurant with a fresh, inviting look that appealed to a younger audience.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research into the client's brand and target audience, followed by sketching and concept development. I prioritize iterative design and client feedback throughout the process.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients, managing expectations, and delivering designs that meet their needs.\",\n    \"portfolio_links\": [\n        \"https://www.avachen.design\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
