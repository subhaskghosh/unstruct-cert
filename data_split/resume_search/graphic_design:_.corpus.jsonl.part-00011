{"_id": "resume_search--graphic_design:_--n--70488", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Digital Illustrations\",\n            \"description\": \"Created a series of digital illustrations for a children's book.\",\n            \"date\": \"2020-08-01\"\n        },\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Designed engaging social media graphics for a marketing campaign.\",\n            \"date\": \"2021-03-10\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I primarily work independently, focusing on bringing my own artistic vision to life. I receive project briefs and then execute the design based on my interpretation.\",\n    \"client_work_experience\": \"Limited client interaction; projects are typically handled through project managers.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Visual Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2017\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"5 years\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\"\n    ],\n    \"certifications\": [\n        \"Digital Illustration Certificate\"\n    ],\n    \"objective\": \"Seeking freelance illustration opportunities.\",\n    \"languages\": [\n        \"English\"\n 