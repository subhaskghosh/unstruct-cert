{"_id": "resume_search--graphic_design:_--p--70625", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for EcoClean\",\n            \"description\": \"Complete branding package including logo, color palette, and brand guidelines.\",\n            \"image_url\": \"https://example.com/ecoclean.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application.\",\n            \"image_url\": \"https://example.com/mobileapp.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with understanding the client's needs and target audience, then I brainstorm ideas, create sketches, and iterate based on feedback. I focus on creating visually appealing and effective designs that solve problems.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to deliver high-quality design solutions, managing feedback, and meeting deadlines.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Wonderland\",\n    \"contact_information\": {\n        \"email\": \"alice.wonderland@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creativity and design skills to a challenging and rewarding role in a dynamic environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicewonderland.com/portfolio\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
