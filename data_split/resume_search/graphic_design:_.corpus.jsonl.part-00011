{"_id": "resume_search--graphic_design:_--n--69503", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup for App Z\",\n            \"description\": \"UI/UX design for a mobile application.\",\n            \"image_url\": \"https://example.com/ui.jpg\"\n        },\n        {\n            \"title\": \"Icon Set for Software W\",\n            \"description\": \"Design of icons for a software platform.\",\n            \"image_url\": \"https://example.com/icon.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design principles, conducting user research and creating wireframes and prototypes.\",\n    \"client_work_experience\": \"2 years of experience working with clients on digital product design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UX Designer\",\n            \"company\": \"Tech Startup B\",\n            \"duration\": \"2022-2024\"\n        }\n    ],\n    \"skills\": [\n        \"Wireframing\",\n        \"Prototyping\",\n        \"User Research\",\n        \"Usability Testing\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To apply my UX design skills to create intuitive and user-friendly digital experiences.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobjohnsondesign.com\"\n    ],\n    \"availability\": \"2024-02-01\"\n}"}
