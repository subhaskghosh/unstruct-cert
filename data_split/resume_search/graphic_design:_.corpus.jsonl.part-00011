{"_id": "resume_search--graphic_design:_--p--70632", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"A complete branding package for a sustainable flower delivery service. Focused on a clean, modern aesthetic with natural color palettes.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design for a tech startup, prioritizing user-friendliness and a contemporary design.\",\n            \"url\": \"https://example.com/techforward\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research into the client's target audience and brand values, then develop mood boards and initial concepts. Iteration and feedback are key throughout the process.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to deliver successful branding and marketing materials. I excel at translating client vision into compelling visual solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"BFA in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for branding to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70632", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustrative Artwork - Fantasy Landscape\",\n            \"description\": \"A detailed illustration of a fantastical landscape, showcasing vibrant colors and intricate details.\",\n            \"url\": \"https://example.com/fantasyart\"\n        },\n        {\n            \"title\": \"Print Design - Brochure for Local Event\",\n            \"description\": \"A tri-fold brochure designed for a community event, featuring informative content and eye-catching graphics.\",\n            \"url\": \"https://example.com/brochure\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"My process is very fluid and driven by intuition. I often begin with sketches and explore various styles before settling on a final direction.\",\n    \"client_work_experience\": \"1.5 years of experience completing small illustration projects for local businesses.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"BA in Fine Arts\",\n            \"university\": \"City College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Freelance\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"Traditional Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To develop my artistic skills and contribute to visually engaging projects.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencarterart.com\"\n    ],\n    \"availability\": \"2024-05-01\"\n}"}
