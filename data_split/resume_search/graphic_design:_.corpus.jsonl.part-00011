{"_id": "resume_search--graphic_design:_--p--70485", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Developed a complete brand identity for a sustainable flower delivery service, including logo, color palette, typography, and marketing materials.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Website Redesign for 'TechForward'\",\n            \"description\": \"Led the redesign of a tech company's website, focusing on improved user experience and visual appeal.\",\n            \"image_url\": \"https://example.com/techforward.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research into the client's needs and target audience. I then generate multiple concepts, iterate based on feedback, and deliver high-quality, visually engaging designs.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to understand their brand vision and translate it into effective design solutions. I’m adept at managing client expectations and delivering projects on time and within budget.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\",\n        \"Best Branding Project - 2021\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Senior Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Web Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70485", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Series\",\n            \"description\": \"A series of digital illustrations exploring abstract concepts.\",\n            \"image_url\": \"https://example.com/illustration.jpg\"\n        },\n        {\n            \"title\": \"Motion Graphics Reel\",\n            \"description\": \"A showcase of animated logos and visual effects.\",\n            \"image_url\": \"https://example.com/motiongraphics.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Motion Graphics\",\n    \"creative_process\": \"My design process is heavily influenced by current trends and experimentation with new techniques.\",\n    \"client_work_experience\": \"Limited client interaction, primarily focused on executing briefs provided by creative directors.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Digital Media\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Motion Graphics Designer\",\n            \"company\": \"Animation Studios\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Motion Graphics\",\n        \"Animation\",\n        \"After Effects\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"After Effects Certified User\"\n    ],\n    \"objective\": \"Seeking a challenging role in the animation industry.\",\n    \"languages\": [\n        \"English\"\