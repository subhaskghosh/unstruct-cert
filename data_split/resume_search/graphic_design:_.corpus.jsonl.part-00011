{"_id": "resume_search--graphic_design:_--p--68839", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Branding for Tech Startup\",\n            \"description\": \"Developed a complete branding package including logo, color palette, and brand guidelines for a new tech startup, focusing on a clean and modern aesthetic.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed the user interface and user experience for a mobile application, prioritizing user-friendliness and intuitive navigation.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research and brainstorming, then create multiple concepts before refining based on client feedback. I believe in iterative design and collaboration.\",\n    \"client_work_experience\": \"I've successfully collaborated with clients from various industries, understanding their needs and translating them into effective visual solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n    