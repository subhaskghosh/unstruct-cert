start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Client Communication\",\n        \"Project Management\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional in Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design role focused on branding and visual communication.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
