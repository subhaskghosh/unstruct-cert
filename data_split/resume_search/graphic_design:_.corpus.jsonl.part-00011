{"_id": "resume_search--graphic_design:_--p--69988", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo, color palette, and brand guidelines for a sustainable floral company.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI/UX design for a responsive e-commerce website.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with understanding the client's needs and target audience, then move to brainstorming and sketching, followed by digital design and iteration.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating with clients, managing feedback, and delivering projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design role.\",\n    \"languages\": [\n       