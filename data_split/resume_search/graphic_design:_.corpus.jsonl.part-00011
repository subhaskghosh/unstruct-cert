{"_id": "resume_search--graphic_design:_--p--71589", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Branding Project\",\n            \"description\": \"Brand identity design for a tech startup, including logo, color palette, and typography.\",\n            \"image_url\": \"https://example.com/branding1.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application, focusing on usability and visual appeal.\",\n            \"image_url\": \"https://example.com/uiux1.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX and Branding\",\n    \"creative_process\": \"My creative process is highly collaborative, involving close communication with clients to understand their needs and translate them into effective design solutions. I prioritize user research and iterative prototyping.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients on a variety of design projects, consistently delivering results that meet their objectives and exceed their expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n     