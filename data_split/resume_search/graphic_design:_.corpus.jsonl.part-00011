{"_id": "resume_search--graphic_design:_--p--71687", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package for a sustainable flower delivery service, including logo design, color palette, and brand guidelines.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"UI/UX for 'SwiftPay'\",\n            \"description\": \"Redesign of a mobile payment app focusing on user experience and visual appeal.\",\n            \"url\": \"https://example.com/swiftpay\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research and sketching, followed by digital prototyping and iterative refinement based on user feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients on diverse branding and UI/UX projects, consistently exceeding expectations and delivering impactful designs.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"DesignHub Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my creative skills and experience to deliver innovative and impactful design solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71687", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"Inkscape\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Print Design for 'Local Eats'\",\n            \"description\": \"Flyer and poster design for a local restaurant promotion.\",\n            \"url\": \"https://example.com/localeats\"\n        },\n        {\n            \"title\": \"Illustration for 'Kids' Book'\",\n            \"description\": \"Character illustrations for a children's storybook.\",\n            \"url\": \"https://example.com/kidsbook\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy experimenting with different artistic styles and techniques to create unique and visually appealing illustrations.\",\n    \"client_work_experience\": \"2 years of freelance illustration work, primarily focusing on print and digital art.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Fine Arts\",\n            \"university\": \"Community College of Anytown\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\",\n        \"CorelDRAW\",\n        \"Inkscape\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To continue developing my illustration skills and contribute to creative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencarterart.com\"\n    ],\n    \"availability\": \"2024-04-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71688", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Branding for Tech Startup\",\n            \"description\": \"A complete branding package for a new tech company, including logo design, color palette, and brand guidelines. Emphasis on clean lines and minimalist design.\",\n            \"image_url\": \"https://example.com/portfolio/tech_branding.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application focused on productivity. Designed with user feedback and usability testing.\",\n            \"image_url\": \"https://example.com/portfolio/mobile_app_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding and UI/UX Design\",\n    \"creative_process\": \"My creative process is highly collaborative. I start with thorough client interviews and research, followed by iterative design concepts and constant feedback loops to ensure the final product aligns perfectly with their vision. I value open communication and believe the best designs are born from teamwork.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating with diverse clients, from small startups to large corporations, delivering high-quality design solutions that meet their specific needs and goals.\",\n    \"design_awards\": [\n        \"Webby Award - Best Visual Design (2022)\",\n        \"Communication Arts - Excellence in Branding (2021)\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Graphic Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Adobe Creative Suite\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design position where I can leverage my creativity and skills to create impactful visual solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com/portfolio\"\n    ],\n    \"availability\": \"2024-02-29\"\n}"}
