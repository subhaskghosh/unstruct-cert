{"_id": "resume_search--graphic_design:_--p--71875", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Rebranding for 'EcoBloom'\",\n            \"description\": \"Complete brand overhaul for a sustainable flower delivery service, including logo, color palette, typography, and marketing materials.\",\n            \"image_url\": \"https://example.com/ecobloom_rebrand.jpg\"\n        },\n        {\n            \"title\": \"Logo Design for 'TechForward'\",\n            \"description\": \"Modern and minimalist logo design for a tech startup focusing on AI solutions.\",\n            \"image_url\": \"https://example.com/techforward_logo.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I embrace a collaborative and iterative design process, starting with thorough research and brainstorming sessions with clients. I focus on creating visually compelling and strategically sound solutions that resonate with target audiences.  I prioritize staying current with modern design trends and techniques.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients to develop and execute successful branding and marketing campaigns. I excel at translating client needs into impactful visual designs.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Design Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for branding to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-26\"\n}"}
