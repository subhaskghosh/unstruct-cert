{"_id": "resume_search--graphic_design:_--n--70483", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Illustration Project\",\n            \"description\": \"A hand-drawn illustration for a children's book, created using traditional techniques.\",\n            \"image_url\": \"https://example.com/portfolio/illustration.jpg\"\n        },\n        {\n            \"title\": \"Print Advertisement Design\",\n            \"description\": \"A print advertisement for a local business.  Focused on conveying a message quickly.\",\n            \"image_url\": \"https://example.com/portfolio/advertisement.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I generally work independently, developing concepts based on initial briefs. I appreciate clear direction from clients.\",\n    \"client_work_experience\": \"I have approximately 1 year of experience working directly with clients.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Art\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2022-09-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"certifications\": [],