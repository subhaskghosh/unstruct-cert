{"_id": "resume_search--graphic_design:_--n--71112", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout\",\n            \"description\": \"Full-page magazine spread for a lifestyle publication.\"\n        },\n        {\n            \"title\": \"Flyer Design\",\n            \"description\": \"Promotional flyer for a local event.\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"Focus on visual hierarchy and impactful imagery to capture attention.\",\n    \"client_work_experience\": \"Managed client expectations and delivered designs within tight deadlines.\",\n    \"design_awards\": [\n        \"Best Magazine Layout - Local Design Competition 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2017\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"PrintPro Ltd.\",\n            \"duration\": \"7 years\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To leverage my extensive experience in print design and contribute to a growing organization.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com/prints\"\n    ],\n    \"avail