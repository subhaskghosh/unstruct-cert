{"_id": "resume_search--graphic_design:_--p--71717", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Tech Startup Branding\",\n            \"description\": \"Complete branding package for a SaaS startup, including logo design, color palette, and brand guidelines. Focus on a modern, minimalist aesthetic.\",\n            \"url\": \"https://example.com/portfolio/startup1\"\n        },\n        {\n            \"title\": \"Minimalist Logo Design\",\n            \"description\": \"A series of logo designs emphasizing simplicity and clarity.\",\n            \"url\": \"https://example.com/portfolio/logos\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I approach each project with a focus on understanding the client's needs and translating them into a visually compelling brand identity. I prioritize simplicity, clarity, and a modern aesthetic.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients on branding projects, from initial concept development to final delivery. Proven ability to meet deadlines and exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Thompson\",\n    \"contact_information\": {\n        \"email\": \"aria.thompson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my branding expertise to a dynamic team and create impactful visual identities.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariathompsondesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
