": [],\n    \"objective\": \"To contribute my branding and design expertise to a creative team and deliver impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
