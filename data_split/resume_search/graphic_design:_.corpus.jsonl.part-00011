esign\",\n        \"UI/UX Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my creative skills and experience to develop innovative and impactful design solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
