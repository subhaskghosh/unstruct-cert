{"_id": "resume_search--graphic_design:_--p--69610", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity development including logo, color palette, typography, and brand guidelines for a sustainable skincare company.\"\n        },\n        {\n            \"title\": \"Website Mockups for 'Tech Solutions'\",\n            \"description\": \"UI/UX design for the homepage and key landing pages of a tech startup's website.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming, followed by sketching and digital prototyping. I prioritize client feedback throughout the entire process.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating directly with clients, managing projects from initial concept to final delivery, and ensuring their satisfaction.\",\n    \"design_awards\": [],\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience