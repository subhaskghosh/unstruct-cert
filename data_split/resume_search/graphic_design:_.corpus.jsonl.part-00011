{"_id": "resume_search--graphic_design:_--p--68067", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity package including logo design, color palette, typography, and brand guidelines. Focused on a modern, minimalist aesthetic.\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design for a tech startup's website, emphasizing usability and visual appeal.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital prototyping. Client feedback is integrated throughout the process to ensure a final product that aligns with their vision and goals.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs, present design concepts, and incorporate feedback effectively. Proven ability to manage client expectations and deliver projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Rodriguez\",\n    \"contact_information\": {\n        \"email\": \"aria.rodriguez@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n  