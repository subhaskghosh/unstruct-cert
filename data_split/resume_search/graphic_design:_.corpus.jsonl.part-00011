{"_id": "resume_search--graphic_design:_--p--69546", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, and typography.\",\n            \"date\": \"2023-08-15\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechSolutions'\",\n            \"description\": \"UI/UX design for a tech company website.\",\n            \"date\": \"2024-01-20\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with understanding the client's needs and target audience, then move to brainstorming and sketching concepts, followed by digital design and refinement.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients on diverse design projects, consistently delivering high-quality results that meet their specific needs and objectives.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020-Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my