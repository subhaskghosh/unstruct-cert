{"_id": "resume_search--graphic_design:_--n--71198", "text": "{\n    \"design_software_proficiency\": [\n        \"Figma\",\n        \"Sketch\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockups for 'CloudSolutions'\",\n            \"description\": \"UI/UX design for a cloud storage platform, focusing on usability and user engagement.\"\n        },\n        {\n            \"title\": \"Mobile App Design for 'FitTrack'\",\n            \"description\": \"Interface design for a fitness tracking mobile application, emphasizing data visualization and user experience.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I prioritize user research and wireframing to create intuitive and effective user interfaces.\",\n    \"client_work_experience\": \"2 years of experience working with development teams to implement designs and ensure a seamless user experience.\",\n    \"design_awards\": [\n        \"UX Design Award - 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Digital Innovations\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Wireframing\",\n        \"Prototyping\",\n        \"Figma\",\n        \"User Testing\"\n    ],\n    \"certifications\": [\n        \"Certified UX Professional\"\n    ],\n    \"objective\": \"To leverage my UI/UX expertise to create engaging and u