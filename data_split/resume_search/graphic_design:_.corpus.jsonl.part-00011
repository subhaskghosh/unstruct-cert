{"_id": "resume_search--graphic_design:_--n--69151", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Illustrator\",\n        \"CorelDRAW\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed user interfaces for a mobile application.\",\n            \"url\": \"https://example.com/uiux\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design principles and iterative prototyping.\",\n    \"client_work_experience\": \"Experienced in working directly with product managers and developers.\",\n    \"design_awards\": [\n        \"UX Design Award 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"Tech Institute\",\n            \"year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions\",\n            \"duration\": \"2019-2023\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Wireframing\"\n    ],\n    \"certifications\": [\n        \"Certified UX Professional\"\n    ],\n    \"objective\": \"To contribute my UI/UX expertise to create engaging and user-friendly digital experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2023-12-20\"\n}"}
