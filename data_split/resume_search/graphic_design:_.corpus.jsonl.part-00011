{"_id": "resume_search--graphic_design:_--p--69862", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Startup X\",\n            \"description\": \"Complete branding package including logo design, color palette, and style guide.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App Y\",\n            \"description\": \"User interface and user experience design for a mobile application.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research and brainstorming, followed by sketching and digital prototyping. I iterate based on feedback and prioritize user-centered design.\",\n    \"client_work_experience\": \"I have over 5 years of experience collaborating directly with clients, understanding their needs, and delivering high-quality designs that meet their objectives.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency A\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Web Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and design expertise to a challenging and rewarding role in a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
