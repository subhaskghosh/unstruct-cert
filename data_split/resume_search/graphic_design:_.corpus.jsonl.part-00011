{"_id": "resume_search--graphic_design:_--n--68096", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\",\n        \"Inkscape\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Illustration\",\n            \"description\": \"Hand-drawn illustration for a children's book.\"\n        },\n        {\n            \"title\": \"Flyer Design\",\n            \"description\": \"Created a flyer for a local event.\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I primarily work from client briefs, focusing on technical accuracy and efficient execution.\",\n    \"client_work_experience\": \"Limited direct client interaction; primarily worked through project managers.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Smith\",\n    \"contact_information\": {\n        \"email\": \"bob.smith@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Illustrator\",\n            \"company\": \"Print Shop\",\n            \"duration\": \"2018-Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find a stable position utilizing my illustration skills.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobsmithillustrations.com\"\n    ],\n    \"availability\": \"2024-06-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--68097", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Design Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"BFA in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"BrandFirst Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Developed branding materials and UI/UX designs for a variety of clients.\"\n        },\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2024-01-01\",\n            \"end_date\": null,\n            \"description\": \"Continuing to provide branding and design services to clients.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Visual Communication\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Tech Startup Branding\",\n            \"description\": \"Complete branding package for a tech startup, including logo, color palette, and brand guidelines. Focused on a clean, modern aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/techstartup.jpg\"\n        },\n        {\n            \"title\": \"Mobile App UI/UX Design\",\n            \"description\": \"UI/UX design for a mobile application focused on user engagement and intuitive navigation.  Visual storytelling was key to guiding the user.\",\n            \"image_url\": \"https://example.com/portfolio/mobileapp.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX Design\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and ideation, followed by iterative design and refinement based on client feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to understand their needs and deliver effective design solutions.\",\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68097", "text": "{\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Art Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"BFA in Illustration\",\n            \"university\": \"California College of the Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Cartoon Studios\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Created illustrations for various media, including books, magazines, and websites.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Digital Painting\",\n        \"Character Design\",\n        \"Storyboarding\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Procreate\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Children's Book Illustration\",\n            \"description\": \"Illustration for a children's book, focusing on whimsical characters and vibrant colors.\",\n            \"image_url\": \"https://example.com/portfolio/childrensbook.jpg\"\n        },\n        {\n            \"title\": \"Comic Book Cover\",\n            \"description\": \"Cover art for an independent comic book series.\",\n            \"image_url\": \"https://example.com/portfolio/comiccover.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I'm inspired by storytelling and character development, bringing narratives to life through vibrant visuals.\",\n    \"client_work_experience\": \"Limited experience working directly with clients, mostly focused on executing projects based on provided briefs.\",\n    \"portfolio_links\": [\n        \"https://bencarterart.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--68098", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Mobile App Redesign\",\n            \"description\": \"Redesign of a mobile banking app with a focus on user experience and visual clarity. Modern, clean aesthetic with a focus on usability.\",\n            \"image_url\": \"https://example.com/app_redesign.jpg\"\n        },\n        {\n            \"title\": \"Branding for a Tech Startup\",\n            \"description\": \"Complete branding package for a new tech startup, including logo design, color palette, and brand guidelines. Clean, minimalist design.\",\n            \"image_url\": \"https://example.com/branding_startup.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX and Branding\",\n    \"creative_process\": \"I approach design with a user-centered mindset, starting with research and ideation, followed by wireframing, prototyping, and visual design. I iterate based on feedback and prioritize usability and aesthetics.\",\n    \"client_work_experience\": \"I have extensive experience collaborating with clients throughout the entire design process, from initial concept to final delivery. I am adept at understanding client needs and translating them into effective design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Web Design\",\n        \"Mobile App Design\",\n        \"Adobe Creative Suite\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"To contribute my UI/UX design skills and creativity to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68098", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Flyer Design for Local Event\",\n            \"description\": \"Flyer created for a local community event. Traditional and colorful design.\",\n            \"image_url\": \"https://example.com/flyer.jpg\"\n        },\n        {\n            \"title\": \"Logo Design for Restaurant\",\n            \"description\": \"Logo designed for a family-owned restaurant, featuring detailed illustrations.\",\n            \"image_url\": \"https://example.com/restaurant_logo.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on creating visually appealing designs that effectively communicate a message. I prioritize client input and strive for client satisfaction.\",\n    \"client_work_experience\": \"I have worked with a variety of clients on print design projects, ensuring their vision is brought to life.\",\n    \"design_awards\": [\n        \"Local Print Design Award - 2018\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2015\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Print Solutions Ltd.\",\n            \"duration\": \"2015 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Logo Design\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Illustration\"\n    ],\n    \"certifications\": [],\n    \"objective\": 