{"_id": "resume_search--graphic_design:_--p--71117", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, and style guide for a sustainable flower delivery service.\",\n            \"image_url\": \"https://example.com/ecobloom_branding.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for 'HealthTrack'\",\n            \"description\": \"Mobile app design focused on user-friendly health tracking and data visualization.\",\n            \"image_url\": \"https://example.com/healthtrack_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by iterative prototyping and user testing. I prioritize clean aesthetics and user-centered design.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, translating their vision into effective design solutions, and managing feedback throughout the project lifecycle.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2020-06\",\n            \"end_date\": \"Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Design Thinking Certification - IDEO U\"\n    ],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
