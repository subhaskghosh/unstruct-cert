{"_id": "resume_search--graphic_design:_--p--70630", "text": "{\n    \"name\": \"Aisha Sharma\",\n    \"contact_information\": {\n        \"email\": \"aisha.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Visual Communication\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup\",\n            \"description\": \"Complete brand identity including logo, color palette, and brand guidelines.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I thrive on collaborative brainstorming and iterative design, constantly pushing boundaries to create impactful and visually stunning solutions. My approach prioritizes user-centric design principles combined with innovative aesthetics.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their vision and translate it into effective design solutions.\",\n    \"design_awards\": [\n  