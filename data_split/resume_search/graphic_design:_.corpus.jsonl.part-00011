{"_id": "resume_search--graphic_design:_--p--69823", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Designed a modern and minimalist logo for a new tech startup, incorporating their brand values of innovation and simplicity.\",\n            \"url\": \"https://example.com/logo1\"\n        },\n        {\n            \"title\": \"Brand Guidelines for Fashion Brand\",\n            \"description\": \"Developed comprehensive brand guidelines including logo usage, color palettes, typography, and imagery for a fashion brand.\",\n            \"url\": \"https://example.com/brandguidelines\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin by deeply understanding the client's needs and target audience, then move into sketching and concept development, followed by digital implementation and refinement.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, managing feedback, and delivering designs that meet their objectives and exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency\",\n            \"years\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"T