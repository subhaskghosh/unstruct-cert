ility\": \"2024-11-20\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69268", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe InDesign\",\n        \"Adobe Illustrator\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout\",\n            \"description\": \"Designed a multi-page magazine layout for a local publication.\"\n        },\n        {\n            \"title\": \"Book Cover Design\",\n            \"description\": \"Created a visually appealing book cover for a novel.\"\n        }\n    ],\n    \"design_specialization\": \"publication design\",\n    \"creative_process\": \"I focus on clean layouts and effective typography.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients.\",\n    \"design_awards\": [\n        \"Local Design Competition Winner - 2022\"\n    ],\n    \"name\": \"Bob TheBuilder\",\n    \"contact_information\": {\n        \"email\": \"bob.builder@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Communication\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Junior Designer\",\n            \"company\": \"Publishing House Y\",\n            \"duration\": \"2022-2024\"\n        }\n    ],\n    \"skills\": [\n        \"Layout Design\",\n        \"Typography\",\n        \"Print Production\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional - InDesign\"\n    ],\n    \"objective\": \"Seeking a challenging design role in the publishing industry.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobbuilderdesigns.com\"\n    ],\n    \"availability\": \"2024-12-15\"\n}"}
