{"_id": "resume_search--graphic_design:_--n--70631", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Web Banner Design\",\n            \"description\": \"Designed a vibrant web banner for an online advertising campaign.\",\n            \"url\": \"https://example.com/banner1\"\n        },\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Created engaging social media graphics for various platforms.\",\n            \"url\": \"https://example.com/social1\"\n        }\n    ],\n    \"design_specialization\": \"Web Design\",\n    \"creative_process\": \"I focus on user-centered design and creating visually appealing interfaces.\",\n    \"client_work_experience\": \"2 years of experience working with clients on website design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Smith\",\n    \"contact_information\": {\n        \"email\": \"bob.smith@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Web Development\",\n            \"college\": \"Community College of Design\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Web Designer\",\n            \"company\": \"Web Solutions Inc.\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"HTML\",\n        \"CSS\",\n        \"JavaScript\",\n        \"Adobe Photoshop\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To obtain a web design position where I can utilize my skills to create user-friendly and visually appealing websites.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobsmith.com\