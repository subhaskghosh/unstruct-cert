-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71676", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Innovate Studios\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\",\n        \"Web Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Rebranding for Tech Startup\",\n            \"description\": \"Complete brand overhaul including logo, color palette, and brand guidelines.\"\n        },\n        {\n            \"title\": \"Mobile App UI/UX Design\",\n            \"description\": \"User interface and user experience design for a mobile application.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a user-centered design approach, starting with research and prototyping to create impactful and intuitive solutions.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver designs that exceed expectations.\",\n    \"design_awards\": [\n        \"AIGA Award for Excellence in Branding\",\n        \"DesignRush Best UI/UX Design Award\"\n    ],\n    \"portfolio_links\": [\n        \"https://ww