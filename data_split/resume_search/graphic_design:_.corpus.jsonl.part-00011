{"_id": "resume_search--graphic_design:_--p--70447", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design for a sustainable flower delivery service, including logo, color palette, typography, and brand guidelines.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"UI/UX for 'HealthTrack'\",\n            \"description\": \"Mobile app design for health tracking, focusing on user-friendly interfaces and data visualization.\",\n            \"image_url\": \"https://example.com/healthtrack.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a user-centered design approach, starting with thorough research and ideation, followed by prototyping and iterative testing. I prioritize clean and modern aesthetics.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating directly with clients, managing projects from concept to completion, and consistently exceeding expectations.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Senior Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
