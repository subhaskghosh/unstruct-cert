{"_id": "resume_search--graphic_design:_--p--70640", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'Bloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines. Focused on a modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/bloom_identity.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups - Tech Startup\",\n            \"description\": \"UI/UX design for a tech startup's website.  Emphasized clean lines and user-friendly navigation.\",\n            \"image_url\": \"https://example.com/tech_startup_website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process begins with thorough research into the client's target audience and brand values. I then develop multiple concepts, iterating based on feedback and usability testing. I believe in a data-driven approach, balancing aesthetic appeal with strategic objectives.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, presenting design concepts, and incorporating feedback to deliver results that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Figma\",\n        \"Client Communication\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a dynamic team, developing impactful and visually appealing designs.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://avachen.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70640", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Poster Design - Music Festival\",\n            \"description\": \"Poster design for a local music festival.  Incorporated bright colors and bold typography.\",\n            \"image_url\": \"https://example.com/music_festival_poster.jpg\"\n        },\n        {\n            \"title\": \"Flyer Design - Restaurant Promotion\",\n            \"description\": \"Flyer design for a restaurant promotion. Focused on eye-catching imagery and clear messaging.\",\n            \"image_url\": \"https://example.com/restaurant_flyer.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I generally start with a rough sketch and then refine it digitally. I'm open to client feedback and willing to make revisions as needed.\",\n    \"client_work_experience\": \"Limited client interaction, primarily working under the direction of senior designers.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"university\": \"Community College of Anytown\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Designer\",\n            \"company\": \"Print & Design Co.\",\n            \"start_date\": \"2022-09-01\",\n            \"end_date\": \"2023-06-30\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Poster Design\",\n        \"Flyer Design\",\n        \"Adobe Photoshop\",\n  