rtifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70616", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration - Fantasy Landscape\",\n            \"description\": \"A detailed illustration of a fantasy landscape, showcasing character design.\",\n            \"url\": \"https://example.com/illustration1\"\n        },\n        {\n            \"title\": \"Mobile App UI Design\",\n            \"description\": \"UI design for a mobile app focused on productivity.\",\n            \"url\": \"https://example.com/appui1\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design, iterating through wireframes and prototypes to achieve optimal usability.\",\n    \"client_work_experience\": \"Worked with several clients on mobile application design projects, receiving positive feedback on user experience.\",\n    \"design_awards\": [\n        \"UX Design Award - 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"start_date\": \"2019-08-01\",\n            \"end_date\": \"2023-08-01\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Wireframing\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"certifications\": [\n        \"UX Certification - Nielsen Norman 