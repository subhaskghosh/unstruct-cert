cy X\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my branding expertise and creative skills to contribute to the success of a forward-thinking organization.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
