ears\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\",\n        \"Adobe Creative Suite\",\n        \"User Research\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design position where I can leverage my skills and experience to create impactful and innovative designs.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
