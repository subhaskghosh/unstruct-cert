{"_id": "resume_search--graphic_design:_--p--70918", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Rebranding Project for 'EcoBloom'\",\n            \"description\": \"Complete rebranding package including logo design, color palette, typography, and brand guidelines for a sustainable flower delivery service.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Social Media Campaign for 'Urban Eats'\",\n            \"description\": \"A series of visually engaging graphics for a restaurant's social media campaign, focusing on a modern aesthetic.\",\n            \"url\": \"https://example.com/urbaneats\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research into the client's brand and target audience, followed by sketching and ideation. I then develop digital concepts and refine them based on feedback, always striving for a clean and impactful design.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients from initial concept to final delivery, ensuring their vision is realized while maintaining high design standards.\",\n    \"design_awards\": [\n        \"AIGA Student Design Award (2019)\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art & Design\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"3 years\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Principles\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional in Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design position where I can help brands thrive.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
