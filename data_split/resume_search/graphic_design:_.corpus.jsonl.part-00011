{"_id": "resume_search--graphic_design:_--p--69397", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern and memorable logo for a new tech startup.\"\n        },\n        {\n            \"title\": \"Branding Guidelines for Fashion Brand\",\n            \"description\": \"Developed comprehensive branding guidelines for a fashion brand, including color palettes, typography, and imagery.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with understanding the client's vision and target audience, then move into sketching and conceptualization, followed by digital design and refinement.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver designs that exceed expectations.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"3 years\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\":