{"_id": "resume_search--graphic_design:_--p--70449", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design, including logo, color palette, typography, and brand guidelines for a sustainable flower delivery service.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for 'TravelApp'\",\n            \"description\": \"Redesign of a travel booking mobile app, focusing on user experience and visual appeal. Included wireframes, mockups, and prototypes.\",\n            \"image_url\": \"https://example.com/travelapp.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and client understanding, followed by iterative design and feedback rounds.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating directly with clients, managing projects, and delivering designs that meet their objectives.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022 - EcoBloom Branding\"\n    ],\n    \"name\": \"Alice Wonderland\",\n    \"contact_information\": {\n        \"email\": \"alice.wonderland@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"DesignHub Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional in Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicewonderland.com/portfolio\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
