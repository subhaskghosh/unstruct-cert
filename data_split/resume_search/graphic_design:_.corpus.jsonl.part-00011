{"_id": "resume_search--graphic_design:_--p--70105", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Developed a complete brand identity, including logo, color palette, and typography, for a sustainable floral company.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Marketing Collateral for 'TechSolutions'\",\n            \"description\": \"Designed brochures, flyers, and social media graphics for a tech company's marketing campaign.\",\n            \"image_url\": \"https://example.com/techsolutions.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding and Visual Identity\",\n    \"creative_process\": \"I start with thorough research and brainstorming, then develop multiple concepts before refining the chosen direction with client feedback.\",\n    \"client_work_experience\": \"I have over 4 years of experience collaborating with clients, understanding their needs, and delivering designs that exceed their expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Ramirez\",\n    \"contact_information\": {\n        \"email\": \"aria.ramirez@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Principles\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creativity and design skills to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariaramirezdesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70105", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Web Design for 'OnlineStore'\",\n            \"description\": \"Designed a user-friendly e-commerce website layout.\",\n            \"image_url\": \"https://example.com/onlinestore.jpg\"\n        },\n        {\n            \"title\": \"Motion Graphics for 'PromoVideo'\",\n            \"description\": \"Created animated graphics for a promotional video.\",\n            \"image_url\": \"https://example.com/promovideo.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Web Design\",\n    \"creative_process\": \"I focus on user experience and intuitive design solutions.\",\n    \"client_work_experience\": \"I have 2 years of freelance experience working with small businesses.\",\n    \"design_awards\": [\n        \"Web Design Award 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Web Development\",\n            \"college\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Web Designer\",\n            \"company\": \"Freelance\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Web Design\",\n        \"HTML\",\n        \"CSS\",\n        \"JavaScript\",\n        \"Adobe Photoshop\"\n    ],\n    \"certifications\": [\n        \"Certified Web Developer\"\n    ],\n    \"objective\": \"To leverage my web design skills in a full-time position.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencarterweb.