{"_id": "resume_search--graphic_design:_--p--70095", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and visual guidelines.  Focused on a modern, minimalist aesthetic.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design for a technology company website, emphasizing clean design and user experience.\",\n            \"url\": \"https://example.com/techforward\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process begins with thorough research and understanding of the client's needs and target audience. I then develop multiple concepts, iterate based on feedback, and refine the design until it perfectly aligns with the client's vision.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, managing project timelines, and delivering high-quality design solutions that meet their specific requirements.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2020 - Present\"\n        