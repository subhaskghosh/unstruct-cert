{"_id": "resume_search--graphic_design:_--p--68844", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for 'EcoBloom'\",\n            \"description\": \"Developed a complete brand identity for EcoBloom, including logo design, color palette, and brand guidelines.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed user interfaces and user experiences for a mobile application focused on fitness tracking.\",\n            \"url\": \"https://example.com/fitnessapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital prototyping. I iterate based on client feedback and focus on creating visually compelling and user-centered designs.\",\n    \"client_work_experience\": \"Experienced in collaborating with clients throughout the design process, from initial concept to final delivery. Adept at understanding client needs and translating them into effective design solutions.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\",\n        \"Best Branding Project 2021\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n  