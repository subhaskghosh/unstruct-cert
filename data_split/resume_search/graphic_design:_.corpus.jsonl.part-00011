{"_id": "resume_search--graphic_design:_--p--70532", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide for a sustainable flower delivery service.\"\n        },\n        {\n            \"title\": \"UI/UX Design for 'HealthTrack'\",\n            \"description\": \"Redesign of a mobile health tracking application, focusing on user experience and accessibility.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and prototyping. I prioritize user feedback throughout the design process.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating directly with clients, understanding their needs, and delivering creative solutions that exceed expectations.\",\n    \"design_awards\": [\n        \"Webby Award (2022) - Best UI/UX Design\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, CA 91234\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"California College of the Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\",\n        \"Adobe Creative Suite\",\n        \"