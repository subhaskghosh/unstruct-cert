{"_id": "resume_search--graphic_design:_--p--69702", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern and memorable logo for a new tech company.\"\n        },\n        {\n            \"title\": \"Brand Style Guide\",\n            \"description\": \"Developed a comprehensive brand style guide for consistent visual communication.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming, followed by sketching and digital execution.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients on branding and marketing projects, consistently delivering designs that meet their objectives and exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Wonderland\",\n    \"contact_information\": {\n        \"email\": \"alice.wonderland@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-26\"\n}"}
