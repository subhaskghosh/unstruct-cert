{"_id": "resume_search--graphic_design:_--p--71067", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines for a new tech startup. Focus on clean, modern aesthetic.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"UI/UX design for a mobile application focused on user engagement and intuitive navigation.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a collaborative process, starting with thorough research and brainstorming, followed by iterative design and refinement based on client feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver design solutions that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n   