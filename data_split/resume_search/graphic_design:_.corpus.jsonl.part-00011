{"_id": "resume_search--graphic_design:_--p--69027", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, and brand guidelines for a sustainable flower delivery service.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI/UX design for a local restaurant's website.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My design process begins with thorough research and client consultation, followed by sketching, digital prototyping, and iterative refinement based on feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their brand identity and translate it into compelling visual designs.\",\n    \"design_awards\": [\n        \"Golden A' Design Award 2023 - Branding\"\n    ],\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\"