{"_id": "resume_search--graphic_design:_--p--69197", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Logo Design for Tech Startup\",\n            \"description\": \"Developed a modern and memorable logo design for a new tech startup, focusing on simplicity and scalability. The logo incorporates a minimalist icon and a clean typeface.\",\n            \"image_url\": \"https://example.com/logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"Created high-fidelity website mockups for a client in the healthcare industry.\",\n            \"image_url\": \"https://example.com/website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin with thorough research and client discovery, followed by sketching and prototyping. I iterate based on feedback and prioritize user-centered design.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients of various sizes, delivering design solutions that meet their specific needs and brand guidelines.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020-2023\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience to create impactful visual solutions for innovative companies.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69197", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Design\",\n            \"description\": \"Designed a responsive website for a local business. Focused on user experience and clean aesthetics.\",\n            \"image_url\": \"https://example.com/website2.jpg\"\n        },\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Created engaging social media graphics to promote brand awareness.\",\n            \"image_url\": \"https://example.com/socialmedia.jpg\"\n        }\n    ],\n    \"design_specialization\": \"web design\",\n    \"creative_process\": \"I focus on understanding the client's vision and translating it into visually appealing designs.\",\n    \"client_work_experience\": \"2 years of experience working with clients on various design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"college\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Designer\",\n            \"company\": \"Web Solutions Inc.\",\n            \"duration\": \"2022-2024\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"Web Design\",\n        \"UI Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging role in web design where I can contribute my skills and grow professionally.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"p