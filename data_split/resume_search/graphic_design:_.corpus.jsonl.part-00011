{"_id": "resume_search--graphic_design:_--p--70377", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'NovaTech'\",\n            \"description\": \"Complete brand overhaul including logo design, color palette, and brand guidelines.\",\n            \"url\": \"https://example.com/novatech\"\n        },\n        {\n            \"title\": \"Website Mockups for 'GreenLeaf Organics'\",\n            \"description\": \"UI/UX design for a responsive e-commerce website.\",\n            \"url\": \"https://example.com/greenleaf\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My design process starts with thorough research and understanding of the client's brand values. I then move onto ideation, sketching, and digital prototyping, followed by iterative refinement based on feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients on diverse branding and marketing projects, consistently delivering designs that meet their objectives and exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Brand Identity\",\n        \"UI/UX Design