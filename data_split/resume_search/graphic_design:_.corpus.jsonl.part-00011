{"_id": "resume_search--graphic_design:_--n--71589", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe InDesign\",\n        \"QuarkXPress\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"A tri-fold brochure for a local business.\",\n            \"image_url\": \"https://example.com/brochure.jpg\"\n        },\n        {\n            \"title\": \"Flyer Design\",\n            \"description\": \"Flyer advertising a community event.\",\n            \"image_url\": \"https://example.com/flyer.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on executing designs according to client specifications, ensuring high-quality print production.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients to produce print materials.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Applied Science in Graphic Design\",\n            \"college\": \"Community College Y\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Print Shop Z\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Typography\",\n        \"Layout Design\",\n        \"Adobe InDesign\",\n        \"Adobe Photoshop\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my print design skills to a growing organization.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobjohnsonprints.co