{"_id": "resume_search--graphic_design:_--p--70579", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines for a sustainable floral company.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design and mockups for a tech startup's website, focusing on user engagement and intuitive navigation.\",\n            \"image_url\": \"https://example.com/techforward.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative design process, starting with thorough research and brainstorming, followed by sketching and prototyping, and finally refining the design based on client feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience working directly with clients, managing projects from initial concept to final delivery, and consistently exceeding their expectations.\",\n    \"design_awards\": [\n        \"Silver Award - Regional Design Competition 2022\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional - Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
