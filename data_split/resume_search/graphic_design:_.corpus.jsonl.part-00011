raphy\",\n        \"Adobe Creative Suite\",\n        \"Client Communication\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-01-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71686", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Illustration\",\n            \"description\": \"A watercolor painting of a landscape.\",\n            \"url\": \"https://example.com/portfolio/illustration1\"\n        },\n        {\n            \"title\": \"Logo Design (Classic Style)\",\n            \"description\": \"A logo design with a vintage aesthetic.\",\n            \"url\": \"https://example.com/portfolio/logo\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I prefer to work independently, focusing on my artistic vision. I generally don't seek extensive client feedback during the initial stages.\",\n    \"client_work_experience\": \"Limited experience working directly with clients; most projects were commissioned through art galleries.\",\n    \"design_awards\": [\n        \"Local Art Fair - Best in Show\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Watercolor Painting\",\n        \"Digital Painting\",\n        \"Traditional Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career as a professional illustrator.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n  