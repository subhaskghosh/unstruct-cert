{"_id": "resume_search--graphic_design:_--p--71116", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Startup X\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide.\",\n            \"url\": \"https://example.com/portfolio/startupx\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App Y\",\n            \"description\": \"User interface and user experience design for a mobile application.\",\n            \"url\": \"https://example.com/portfolio/appY\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a user-centered design process, starting with research and ideation, followed by prototyping and testing.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver effective design solutions.\",\n    \"design_awards\": [\n        \"Golden A' Design Award 2022\",\n        \"Communication Arts Award 2021\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency A\",\n            \"duration\": \"2018 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional in Photoshop\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design role where I can utilize my creativity and skills to contribute to innovative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
