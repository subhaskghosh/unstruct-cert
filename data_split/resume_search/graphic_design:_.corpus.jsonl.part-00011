{"_id": "resume_search--graphic_design:_--p--68199", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe XD\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Rebranding for Tech Startup\",\n            \"description\": \"Complete brand overhaul for a new tech startup, including logo design, color palette, typography, and brand guidelines.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile app focused on fitness tracking.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My design process is heavily user-centered. I start with thorough research and user interviews, followed by wireframing, prototyping, and iterative testing. I believe in a collaborative approach, constantly seeking feedback throughout the design process.\",\n    \"client_work_experience\": \"I have over 4 years of experience collaborating directly with clients to understand their needs and deliver effective design solutions. I'm adept at managing client expectations and incorporating feedback seamlessly.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020-Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience to create impactful visual solutions for innovative brands.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.anyasharma.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-26\"\n}"}
