{"_id": "resume_search--graphic_design:_--p--69719", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Developed a modern and minimalist logo for a new tech startup.\"\n        },\n        {\n            \"title\": \"Website Mockup\",\n            \"description\": \"Created a website mockup for a client in the fashion industry.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming, then move to sketching and digital design. Client feedback is integrated throughout the process.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to deliver high-quality design solutions that meet their specific needs and objectives.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Web Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my skills and experience in graphic design to contribute to a creative and innovative team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-11-25\"\n}"}
