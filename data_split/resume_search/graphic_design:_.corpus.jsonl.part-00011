{"_id": "resume_search--graphic_design:_--n--68915", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Procreate\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Character Illustration for Children's Book\",\n            \"description\": \"Detailed illustration of a whimsical character.\",\n            \"image_url\": \"https://example.com/character_illustration.jpg\"\n        },\n        {\n            \"title\": \"Digital Painting - Landscape\",\n            \"description\": \"A vibrant landscape painting created digitally.\",\n            \"image_url\": \"https://example.com/landscape_painting.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I love bringing characters and stories to life through vibrant illustrations and digital painting.\",\n    \"client_work_experience\": \"Experienced in working directly with authors and publishers to create engaging illustrations.\",\n    \"design_awards\": [],\n    \"name\": \"Arthur Bell\",\n    \"contact_information\": {\n        \"email\": \"arthur.bell@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Illustration\",\n            \"university\": \"Art Institute\",\n            \"year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Publishing House Y\",\n            \"years\": 4\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\",\n        \"Adobe Photoshop\",\n        \"Storytelling\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career as a freelance illustrator, bringing imagination to life through visual storytelling.\",\n    \"languages\": [\