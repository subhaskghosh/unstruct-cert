            \"company\": \"Design Agency XYZ\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can utilize my skills and experience to create impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69547", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup for E-commerce Store\",\n            \"description\": \"Designed a responsive website mockup for an e-commerce store, focusing on user experience and visual appeal.\",\n            \"image_url\": \"https://example.com/website1.jpg\"\n        },\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Created engaging social media graphics for various campaigns.\",\n            \"image_url\": \"https://example.com/social1.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I prioritize user-centered design, conducting user research and usability testing to inform design decisions.\",\n    \"client_work_experience\": \"2 years of experience working with clients on digital design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Adobe XD\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my UI/UX design skills to a innovative team.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"