X Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and branding expertise to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71018", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup for E-commerce\",\n            \"description\": \"UI/UX design for an e-commerce platform.\",\n            \"url\": \"https://example.com/portfolio/ecommerce\"\n        },\n        {\n            \"title\": \"Mobile App Design\",\n            \"description\": \"Design of a mobile application interface.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user research and iterative prototyping to create user-centered designs.\",\n    \"client_work_experience\": \"Experience primarily focused on direct collaboration with product managers and developers.\",\n    \"design_awards\": [],\n    \"name\": \"James Carter\",\n    \"contact_information\": {\n        \"email\": \"james.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Tech Innovations Inc.\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Wireframing\",\n        \"User Testing\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"To apply my UI/UX design skills to create innovative and user-friendly digital products.\",\n    \"languages\": [\n        \"English\",\n    