{"_id": "resume_search--graphic_design:_--p--70620", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'NovaTech'\",\n            \"description\": \"Complete brand overhaul including logo design, color palette, and typography. Modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/novatech.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'EcoSolutions'\",\n            \"description\": \"UI/UX design for a sustainable energy company, focusing on clean layouts and intuitive navigation.\",\n            \"image_url\": \"https://example.com/ecosolutions.png\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with thorough research into the client's target audience and competitive landscape, then develop multiple concepts before refining the chosen direction based on feedback.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating directly with clients to deliver effective design solutions.\",\n    \"design_awards\": [\n        \"AIGA Award for Excellence in Branding - 2022\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a dynamic team and create impactful design solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
