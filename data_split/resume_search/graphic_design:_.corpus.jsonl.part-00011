{"_id": "resume_search--graphic_design:_--p--71944", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity including logo, color palette, typography, and brand guidelines for a new technology startup. Focused on a clean and modern aesthetic.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed the user interface and user experience for a mobile application focused on productivity. Implemented user research and usability testing to optimize design.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX Design\",\n    \"creative_process\": \"I approach each project with a focus on understanding the client's needs and target audience. I iterate through multiple concepts, incorporating feedback at each stage to ensure a final product that is both visually appealing and effective.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients throughout the entire design process, from initial concept to final delivery. Proven ability to manage client expectations and deliver projects on time and within budget.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"User Research\",\n        \"Usability Testing\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71944", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\",\n        \"Inkscape\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Illustration Project\",\n            \"description\": \"A watercolor painting of a landscape.\",\n            \"url\": \"https://example.com/portfolio/watercolor\"\n        },\n        {\n            \"title\": \"Print Design for Local Event\",\n            \"description\": \"Created flyers and posters for a community event. Focused on bright colors and clear messaging.\",\n            \"url\": \"https://example.com/portfolio/eventflyer\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I primarily work from client briefs, translating their vision into visual concepts.\",\n    \"client_work_experience\": \"Limited client interaction, primarily working through project managers.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Freelance\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Print Design\",\n        \"CorelDRAW\",\n        \"GIMP\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find freelance illustration opportunities.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2024-05-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71945", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Branding for Tech Startup\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"Website Mockups for E-commerce Client\",\n            \"description\": \"UI/UX design for a responsive e-commerce website.\",\n            \"url\": \"https://example.com/portfolio/ecommerce\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative process, starting with thorough research and sketching, followed by digital prototyping and iterative refinement based on client feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience working directly with clients to develop and implement effective design solutions that meet their business objectives. I excel at understanding client needs and translating them into compelling visual designs.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can utilize my creativity and skills to contribute to innovative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71945", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Traditional Illustration\",\n            \"description\": \"Watercolor painting of a landscape.\",\n            \"url\": \"https://example.com/portfolio/landscape\"\n        },\n        {\n            \"title\": \"Print Design for Local Event\",\n            \"description\": \"Flyer design for a community festival.\",\n            \"url\": \"https://example.com/portfolio/festival\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy exploring traditional artistic techniques and bringing them to life through digital tools.\",\n    \"client_work_experience\": \"Limited client experience, primarily focused on personal projects and commissions.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Watercolor Painting\",\n        \"Digital Art\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find freelance illustration opportunities and develop my artistic skills.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71946", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe XD\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity, including logo, color palette, typography, and brand guidelines for a seed-stage tech startup.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed the user interface and user experience for a mobile app focused on productivity.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I approach design with a user-centered mindset, focusing on research, ideation, prototyping, and iterative refinement.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, translating their vision into compelling visual solutions, and managing feedback effectively.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Innovative Design Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and innovative environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71946", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"InDesign\",\n        \"Microsoft Publisher\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Print Advertisement for Local Business\",\n            \"description\": \"Designed a print advertisement for a local retail store.\",\n            \"url\": \"https://example.com/portfolio/printad\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Created a brochure for a community event.\",\n            \"url\": \"https://example.com/portfolio/brochure\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on delivering visually appealing designs based on client requirements.\",\n    \"client_work_experience\": \"I've primarily worked on print projects with local businesses.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Communication\",\n            \"university\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Local Print Shop\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\",\n        \"InDesign\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills in a stable and creative work environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsdesign.com\"\n    ],\n    \"availability\": \"2024-04-30\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71947", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Designed a modern and minimalist logo for a new tech startup focusing on AI solutions.\"\n        },\n        {\n            \"title\": \"Brand Identity for Coffee Shop\",\n            \"description\": \"Developed a complete brand identity, including logo, color palette, and typography, for a local coffee shop.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and brainstorming sessions to understand the client's vision. I then create multiple concepts, refine based on feedback, and deliver a final design that exceeds expectations.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients, managing projects from initial concept to final delivery, and ensuring their satisfaction.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience to create impactful and innovative branding solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71947", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout Design\",\n            \"description\": \"Designed layouts for a monthly magazine.\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Created a brochure for a travel agency.\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I typically work independently, focusing on executing designs based on client briefs.\",\n    \"client_work_experience\": \"I have 1.5 years of experience in client projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Junior Designer\",\n            \"company\": \"Printing Company\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Adobe InDesign\",\n        \"Adobe Photoshop\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To gain experience in print design and further develop my skills.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsportfolio.com\"\n    ],\n    \"availability\": \"2024-05-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71948", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design for a sustainable flower delivery service, including logo, color palette, and marketing materials.\",\n            \"image_url\": \"https://example.com/ecobloom_branding.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for 'TravelEase' App\",\n            \"description\": \"Redesign of the user interface for a travel booking application, focusing on improved usability and visual appeal.\",\n            \"image_url\": \"https://example.com/travelease_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and prototyping. I iterate based on client feedback and prioritize user-centered design principles, always striving for innovative and visually compelling solutions.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, managing projects from concept to completion, and consistently exceeding expectations in terms of design quality and meeting deadlines.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022 - EcoBloom Branding\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"DesignCo\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Illustration\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71948", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup for 'Tech Solutions'\",\n            \"description\": \"A mockup design for a technology company website, focusing on clean layouts and user-friendly navigation.\",\n            \"image_url\": \"https://example.com/techsolutions_website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Web Design\",\n    \"creative_process\": \"I focus on rapid prototyping and user testing to ensure designs are functional and meet user needs. I like to keep things simple and straightforward.\",\n    \"client_work_experience\": \"1.5 years of experience working with clients on web design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate's Degree in Web Development\",\n            \"university\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Web Designer\",\n            \"company\": \"Web Solutions Inc.\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Web Design\",\n        \"UI/UX Design\",\n        \"HTML\",\n        \"CSS\",\n        \"JavaScript\"\n    ],\n    \"certifications\": [\n        \"Certified Web Designer\"\n    ],\n    \"objective\": \"Seeking a challenging web design position where I can leverage my skills and experience.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencarterwebdesign.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71949", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, typography, and brand guidelines for a sustainable flower delivery service.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"UI/UX for 'TravelEase' App\",\n            \"description\": \"User interface and user experience design for a mobile travel planning application.\",\n            \"url\": \"https://example.com/travelease\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a highly collaborative approach, starting with thorough research and ideation, followed by iterative prototyping and testing. My process prioritizes user-centered design principles and a modern aesthetic.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to understand their needs and deliver effective design solutions, consistently receiving positive feedback on communication and project management.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\",\n        \"Best Branding Project - 2021\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\",\n        \"User Research\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop\"\n    ],\n    \"objective\": \"Seeking a challenging role where I can leverage my design skills and creative vision to contribute to a dynamic team.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
