{"_id": "resume_search--graphic_design:_--n--70029", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Flyer Design for Local Event\",\n            \"description\": \"Colorful flyer design for a community festival.\",\n            \"url\": \"https://example.com/flyer\"\n        },\n        {\n            \"title\": \"Brochure Design for Travel Agency\",\n            \"description\": \"Tri-fold brochure showcasing travel packages.\",\n            \"url\": \"https://example.com/brochure\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I usually start with a pencil sketch and then move on to digital rendering.\",\n    \"client_work_experience\": \"2 years of experience working with clients on various design projects.\",\n    \"design_awards\": [\n        \"Local Art Competition - 3rd Place\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Art\",\n            \"university\": \"Community College\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020-Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking freelance illustration opportunities.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n    ],\n    \"availabil