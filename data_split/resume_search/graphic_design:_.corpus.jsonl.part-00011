mpaigns.\",\n    \"portfolio_links\": [\n        \"https://arthurpenhaligon.com\"\n    ],\n    \"availability\": \"2024-04-15\",\n    \"design_awards\": [\n        \"Best Marketing Campaign Graphic - 2022\"\n    ]\n}"}
