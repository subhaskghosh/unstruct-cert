{"_id": "resume_search--graphic_design:_--p--70111", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Chicago\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"UI/UX Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Minimalist Branding for 'EcoBloom'\",\n            \"description\": \"Developed a complete brand identity for EcoBloom, a sustainable skincare company. Focused on clean lines, earthy tones, and a minimalist aesthetic.\"\n        },\n        {\n            \"title\": \"Logo Design for 'NovaTech'\",\n            \"description\": \"Designed a modern and memorable logo for NovaTech, a tech startup.\"\n        }\n    ],\n    \"design_specialization\": \"Branding and Logo Design\",\n    \"creative_process\": \"I begin by deeply understanding the client's vision and target audience. I then brainstorm concepts, create sketches, and refine the design through iterative feedback.\",\n    \"client_work_experience\": \"I have collaborated with numerous clients over the past 3 years, consistently delivering designs that meet their needs and exceed their expectations.\",\n    \"portfolio_links\": [\n        \"https://www.anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
