objective\": \"To contribute my branding and design expertise to a forward-thinking company.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71692", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Print Advertising Campaign\",\n            \"description\": \"Design of print ads for a local retail store.\",\n            \"url\": \"https://example.com/print_ads\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Brochure layout for a corporate event.\",\n            \"url\": \"https://example.com/brochure\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I rely heavily on client direction and established design trends.\",\n    \"client_work_experience\": \"2 years of experience primarily working with internal marketing teams.\",\n    \"design_awards\": [\n        \"Local Print Design Award 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Applied Science in Graphic Communication\",\n            \"university\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Local Print Shop\",\n            \"duration\": \"2022 - 2024\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\",\n        \"Adobe InDesign\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a stable position in a print production environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencartersprints.com\"\n    ],\n    \"availability\": \"2024-06-01\