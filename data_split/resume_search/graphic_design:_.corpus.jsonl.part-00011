{"_id": "resume_search--graphic_design:_--n--68913", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Mobile App UI Design\",\n            \"description\": \"Designed user interface elements for a mobile application.\"\n        },\n        {\n            \"title\": \"Website Redesign\",\n            \"description\": \"Redesigned a website with a focus on improved user flow.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I believe in iterative design, constantly refining and testing based on user feedback and data.\",\n    \"client_work_experience\": \"Worked with development teams to implement designs and ensure a seamless user experience.\",\n    \"design_awards\": [\n        \"UX Design Award 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2019 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"User Testing\"\n    ],\n    \"certifications\": [\n        \"Certified UX Professional\"\n    ],\n    \"objective\": \"Seeking a challenging UI/UX design role where I can contribute to creating innovative and user-friendly products.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"www.bobwilliamsprofessionals