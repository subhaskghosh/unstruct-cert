{"_id": "resume_search--graphic_design:_--p--70101", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"California Institute of the Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"BrandSpark Solutions\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Led branding projects for various clients, including logo design, brand guidelines, and marketing materials.\"\n        },\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"CreativeFlow Agency\",\n            \"start_date\": \"2018-07-01\",\n            \"end_date\": \"2020-05-31\",\n            \"description\": \"Designed marketing materials, website graphics, and social media content.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"A clean and minimalist brand identity design for a tech startup focusing on sustainability.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile app aimed at improving productivity