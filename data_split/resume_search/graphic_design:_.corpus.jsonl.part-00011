{"_id": "resume_search--graphic_design:_--p--71303", "text": "{\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"BrandBloom Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Led branding projects for various clients, including logo design, brand guidelines, and marketing collateral.\"\n        },\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"start_date\": \"2018-09-01\",\n            \"end_date\": \"2020-05-31\",\n            \"description\": \"Developed visual concepts and designs for print and digital media.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Typography\",\n        \"Branding\",\n        \"Logo Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoLife'\",\n            \"description\": \"Complete brand identity system for a sustainable lifestyle company, including logo, color palette, typography, and brand guidelines.\"\n        },\n        {\n            \"title\": \"Marketing Collateral for 'TechForward'\",\n            \"description\": \"Designed brochures, flyers, and social media graphics for a tech startup.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin by understanding the client's goals and target audience. I then develop multiple concepts, refine them based on feedback, and deliver a polished final product.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients throughout the design process, ensuring their satisfaction and meeting their specific needs.\",\n    \"portfolio_links\": [\n        \"https://www.eleanorvance.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71303", "text": "{\n    \"name\": \"Arthur Finch\",\n    \"contact_information\": {\n        \"email\": \"arthur.finch@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Media Studies\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Web Designer\",\n            \"company\": \"Digital Dynamics\",\n            \"start_date\": \"2019-07-01\",\n            \"end_date\": \"2023-11-30\",\n            \"description\": \"Designed and maintained websites, focusing on user experience and front-end development.\"\n        }\n    ],\n    \"skills\": [\n        \"HTML\",\n        \"CSS\",\n        \"JavaScript\",\n        \"UI Design\",\n        \"UX Design\",\n        \"Adobe XD\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe XD\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Redesign for 'Local Eats'\",\n            \"description\": \"Redesigned the website for a local restaurant, focusing on improved user navigation and mobile responsiveness.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I focus on user-centered design principles, iterating on designs based on user feedback and data analysis.\",\n    \"client_work_experience\": \"Managed client expectations and delivered web design solutions that met their business objectives.\",\n    \"portfolio_links\": [\n        \"https://www.arthurfinch.com\"\n    ],\n    \"availability\": \"2024-02-01\"\n}"}
