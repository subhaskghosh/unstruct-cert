{"_id": "resume_search--graphic_design:_--p--69371", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for EcoClean\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide for a sustainable cleaning product company.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI design for a responsive website.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming, followed by sketching and digital prototyping, and iterative refinement based on client feedback.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients, managing projects from concept to completion, and ensuring their satisfaction.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Web Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creativity and skills to a challenging and rewarding graphic design role.\",\n    \"