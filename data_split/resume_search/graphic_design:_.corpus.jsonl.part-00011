{"_id": "resume_search--graphic_design:_--n--71538", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout\",\n            \"description\": \"Full spread magazine design for a fashion editorial. High-resolution images and attention to detail.\",\n            \"url\": \"https://example.com/magazine-layout\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Tri-fold brochure for a local business. Included copywriting and photography direction.\",\n            \"url\": \"https://example.com/brochure-design\"\n        },\n        {\n            \"title\": \"Poster Design\",\n            \"description\": \"Event poster design for a music festival.\",\n            \"url\": \"https://example.com/poster-design\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on creating visually stunning layouts and ensuring print quality.  I'm meticulous about color management and typography.\",\n    \"client_work_experience\": \"2 years working with print clients, translating their vision into tangible materials.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Communication\",\n            \"college\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"PrintPro Inc.\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n     