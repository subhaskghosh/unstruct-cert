bjective\": \"Seeking a UI/UX Design position where I can apply my skills to create innovative and user-centered digital experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
