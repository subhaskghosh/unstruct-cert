{"_id": "resume_search--graphic_design:_--p--70535", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for 'EcoBloom'\",\n            \"description\": \"Complete brand identity development including logo, color palette, typography, and brand guidelines. Focused on a clean and modern aesthetic.\",\n            \"image_url\": \"https://example.com/ecobloom_logo.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App 'CityNav'\",\n            \"description\": \"User interface and user experience design for a mobile navigation app. Emphasis on usability and visual clarity.\",\n            \"image_url\": \"https://example.com/citynav_screens.png\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research and concept development, followed by iterative design and client feedback. I prioritize clean aesthetics and user-centered design principles.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating with diverse clients, consistently delivering projects on time and within budget.\",\n    \"design_awards\": [\n        \"Awwwards - Honorable Mention (2022)\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n  