{"_id": "resume_search--graphic_design:_--n--71429", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"Mockups of website designs for various clients.\",\n            \"image_url\": \"https://example.com/portfolio/website_mockups.jpg\"\n        },\n        {\n            \"title\": \"Print Brochure Design\",\n            \"description\": \"Brochure design for a local business.\",\n            \"image_url\": \"https://example.com/portfolio/brochure.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Web Design\",\n    \"creative_process\": \"I focus on user-centered design and prioritize functionality.\",\n    \"client_work_experience\": \"2 years of experience collaborating with clients on web design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Miller\",\n    \"contact_information\": {\n        \"email\": \"ben.miller@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Web Development\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Web Designer\",\n            \"company\": \"Web Solutions Inc.\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Web Design\",\n        \"HTML\",\n        \"CSS\",\n        \"JavaScript\",\n        \"UI/UX\"\n    ],\n    \"certifications\": [\n        \"Certified Web Designer\"\n    ],\n    \"objective\": \"To leverage my web design skills to create engaging and user-friendly websites.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.benmiller.web\"\n    ]