{"_id": "resume_search--graphic_design:_--p--69079", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Redesign\",\n            \"description\": \"Redesign of a local business website focused on improved user experience and modern aesthetics.\"\n        },\n        {\n            \"title\": \"Mobile App Interface\",\n            \"description\": \"UI/UX design for a mobile application targeting health and wellness.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"Iterative design process involving user research, wireframing, prototyping, and user testing.\",\n    \"client_work_experience\": \"Collaborated with clients to understand their brand identity and translate it into effective visual designs.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"User Interface Design\",\n        \"User Experience Design\",\n        \"Wireframing\",\n        \"Prototyping\",\n        \"Visual Design\"\n    ],\n    \"certifications\": [\n        \"Certified UX Professional\"\n    ],\n    \"objective\": \"Seeking a challenging UI/UX design role where I can leverage my skills and experience to create impactful user experiences.\",\n    \"languages\": [\n  