ion\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop (2023)\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and innovative design role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
