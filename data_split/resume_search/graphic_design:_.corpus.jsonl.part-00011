{"_id": "resume_search--graphic_design:_--n--69377", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design\",\n            \"description\": \"Logo design for a new coffee shop.\",\n            \"url\": \"https://example.com/logo_design\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Brochure design for a local event.\",\n            \"url\": \"https://example.com/brochure_design\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I focus on creating visually appealing designs that effectively communicate a brand's message.\",\n    \"client_work_experience\": \"Experienced in working directly with clients to deliver branding solutions that meet their objectives.\",\n    \"design_awards\": [\n        \"Best Logo Design Award 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"college\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a graphic design position where I can utilize my creativity and skills to develop impactful visual communications.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.