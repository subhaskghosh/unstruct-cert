{"_id": "resume_search--graphic_design:_--p--70816", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for EcoWare\",\n            \"description\": \"Complete brand identity design for a sustainable product company, including logo, color palette, and style guide.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application focused on health and wellness.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process is heavily user-centered. I begin with thorough research to understand the target audience and their needs, followed by iterative design and prototyping phases with continuous user feedback.  I prioritize usability and accessibility.\",\n    \"client_work_experience\": \"I have over 5 years of experience collaborating directly with clients to understand their needs, present design concepts, and incorporate feedback. I'm skilled at managing client expectations and delivering projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"www.anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70816", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"A modern and minimalist logo design for a technology startup.\"\n        },\n        {\n            \"title\": \"Print Design for Marketing Campaign\",\n            \"description\": \"Design of brochures and flyers for a marketing campaign.\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I generally start with a client brief and brainstorm ideas, then create initial sketches and refine them based on feedback. I focus on aesthetically pleasing and visually impactful designs.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients, primarily on print-based projects.\",\n    \"design_awards\": [\n        \"Local Design Competition Winner - 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Graphic Designer\",\n            \"company\": \"PrintPro Solutions\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Print Design\",\n        \"Typography\",\n        \"Layout Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a junior design role to expand my skills and experience.\",\n    \"languages