{"_id": "resume_search--graphic_design:_--p--70484", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Minimalist Branding for Tech Startup\",\n            \"description\": \"Designed a full brand identity for a tech startup, including logo, color palette, typography, and brand guidelines. Focused on a clean and modern aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/tech_branding.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI/UX designs for a responsive website, maintaining a minimalist and user-friendly interface.\",\n            \"image_url\": \"https://example.com/portfolio/website_mockups.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process begins with thorough research and understanding of the client's needs and target audience. I then develop initial concepts, refine them based on feedback, and deliver high-quality designs that align with the brand's vision.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients on a variety of branding and design projects, consistently delivering projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Web Design\",\n        \"UI/UX\",\n        \"Adobe Creative Suite\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70484", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustrative Painting\",\n            \"description\": \"Traditional oil painting depicting a landscape scene.\",\n            \"image_url\": \"https://example.com/portfolio/painting.jpg\"\n        },\n        {\n            \"title\": \"Event Flyer Design\",\n            \"description\": \"A brightly colored flyer for a music festival.\",\n            \"image_url\": \"https://example.com/portfolio/flyer.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I find inspiration in nature and classical art, and enjoy experimenting with different mediums to create unique and expressive artwork.\",\n    \"client_work_experience\": \"1 year of freelance illustration work.\",\n    \"design_awards\": [\n        \"Local Art Competition - 2nd Place\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\",\n        \"Adobe Photoshop\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career in illustration and contribute to visually engaging projects.\",\n    \"languages\": [\n        \"English\",\n