{"_id": "resume_search--graphic_design:_--p--68759", "text": "{\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Design Street, Anytown, CA 91234\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"California Institute of the Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Brand Identity Designer\",\n            \"company\": \"Innovate Studios\",\n            \"duration\": \"2020 - 2023\",\n            \"description\": \"Led the visual development of brand identities for various clients, including logo design, color palettes, and typography.\"\n        },\n        {\n            \"title\": \"Junior Graphic Designer\",\n            \"company\": \"Creative Flow Agency\",\n            \"duration\": \"2019 - 2020\",\n            \"description\": \"Assisted senior designers with project execution, including creating marketing materials and social media graphics.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"UI/UX Design\",\n        \"Communication\",\n        \"Problem-solving\",\n        \"Detail-oriented\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Bloom & Brew Branding\",\n            \"description\": \"Complete brand identity for a local coffee shop, including logo, packaging, and website design. Features a modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/bloom_and_brew.jpg\"\n        },\n        {\n            \"title\": \"Tech Solutions Website Redesign\",\n            \"description\": \"Redesign of a tech company's website with a focus on user experience and modern design trends.\",\n            \"image_url\": \"https://example.com/tech_solutions.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research and client discovery, followed by sketching and ideation. I prioritize iterative design and feedback to ensure the final product aligns with the client's vision and goals.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver solutions that exceed expectations.\",\n    \"portfolio_links\": [\n        \"https://ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68759", "text": "{\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Art Avenue, Anytown, NY 10001\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"New York University\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Storybook Creations\",\n            \"duration\": \"2018 - 2021\",\n            \"description\": \"Created illustrations for children's books and educational materials.\"\n        },\n        {\n            \"title\": \"Freelance Artist\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2021 - Present\",\n            \"description\": \"Offering illustration and painting services to private clients.\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Character Design\",\n        \"Storytelling\",\n        \"Creative Thinking\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"The Magical Forest Illustration\",\n            \"description\": \"A detailed illustration for a children's book, showcasing a whimsical forest scene.\",\n            \"image_url\": \"https://example.com/magical_forest.jpg\"\n        },\n        {\n            \"title\": \"Portrait of a Young Girl\",\n            \"description\": \"A realistic portrait painting.\",\n            \"image_url\": \"https://example.com/portrait.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"My creative process is