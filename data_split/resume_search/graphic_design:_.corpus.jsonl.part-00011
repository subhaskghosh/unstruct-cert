{"_id": "resume_search--graphic_design:_--p--70643", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Minimalist Branding for Tech Startup\",\n            \"description\": \"Developed a clean and modern brand identity for a tech startup, including logo, color palette, and typography.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI/UX design for a responsive website, focusing on user-friendliness and aesthetic appeal.\",\n            \"url\": \"https://example.com/portfolio/website\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough research, concept sketching, and iterative design based on client feedback, always striving for simplicity and impact.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their vision and deliver creative solutions that meet their objectives.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2020 - 2023\"\n        },\n        {\n            \"role\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2023 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design position.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70643", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Vintage Poster Design\",\n            \"description\": \"Created a retro-style poster for a music festival, inspired by classic travel advertisements.\",\n            \"url\": \"https://example.com/portfolio/vintageposter\"\n        },\n        {\n            \"title\": \"Illustration Project\",\n            \"description\": \"Detailed illustration of a fantasy landscape.\",\n            \"url\": \"https://example.com/portfolio/illustration\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I draw inspiration from a wide range of sources, including historical art movements and contemporary trends.\",\n    \"client_work_experience\": \"I have worked on several personal projects and collaborated with smaller clients on illustrative work.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Illustrator\",\n            \"company\": \"Independent Artist\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Concept Art\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career as a professional illustrator.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n 