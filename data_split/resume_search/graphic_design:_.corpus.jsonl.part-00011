lls\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Visual Communication\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and user-centric approach to create impactful visual solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-02-29\"\n}"}
