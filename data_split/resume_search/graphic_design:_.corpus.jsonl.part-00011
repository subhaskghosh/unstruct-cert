{"_id": "resume_search--graphic_design:_--n--71463", "text": "{\n    \"design_software_proficiency\": [\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Mobile App UI Design\",\n            \"description\": \"User interface design for a mobile application.\",\n            \"image_url\": \"https://example.com/mobileapp.jpg\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I work independently and prefer to have a clear brief from the client. I focus on efficiency and delivering functional designs.\",\n    \"client_work_experience\": \"Limited experience with client interaction, preferring to work from detailed specifications.\",\n    \"design_awards\": [\n        \"Webby Award - Honorable Mention\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Software Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"Seeking a challenging UI/UX design role where I can utilize my skills to create user-friendly digital products.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ben-carter-ux.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71464", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup 'Innovate'\",\n            \"description\": \"Complete brand overhaul for a new tech startup, including logo design, color palette, typography, and brand guidelines.\",\n            \"image_url\": \"https://example.com/innovate_logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups - Mobile App UI\",\n            \"description\": \"UI/UX design for a mobile application focusing on user-friendly navigation and engaging visuals.\",\n            \"image_url\": \"https://example.com/mobile_app_ui.png\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative process, starting with thorough client discovery, followed by conceptualization, iterative design, and rigorous testing to ensure the final product aligns with their vision and goals.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, understanding their needs, and translating them into compelling visual solutions. Proven ability to manage feedback effectively and deliver projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Carter\",\n    \"contact_information\": {\n        \"email\": \"alice.carter@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n          