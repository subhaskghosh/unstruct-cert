{"_id": "resume_search--graphic_design:_--p--70736", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Minimalist Brand Identity for Tech Startup\",\n            \"description\": \"Clean and modern logo, color palette, and brand guidelines for a new technology company.\",\n            \"image_url\": \"https://example.com/portfolio/tech_branding.jpg\"\n        },\n        {\n            \"title\": \"Packaging Design for Sustainable Products\",\n            \"description\": \"Eco-friendly packaging design featuring minimalist typography and illustrations.\",\n            \"image_url\": \"https://example.com/portfolio/sustainable_packaging.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with thorough research and mood boarding, followed by iterative design and refinement based on client feedback.\",\n    \"client_work_experience\": \"Over 5 years of experience working directly with clients, managing projects from concept to completion and ensuring their vision is realized.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Agency X\",\n            \"start_date\": \"2021-06-01\",\n            \"end_date\": \"2024-01-01\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"UI/UX\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can leverage my skills and experience to create impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharma.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70736", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Detailed Illustration for Children's Book\",\n            \"description\": \"A highly detailed and colorful illustration for a children's storybook.\",\n            \"image_url\": \"https://example.com/portfolio/childrens_illustration.jpg\"\n        },\n        {\n            \"title\": \"Complex Website Mockup\",\n            \"description\": \"A comprehensive website mockup with various interactive elements.\",\n            \"image_url\": \"https://example.com/portfolio/website_mockup.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I approach each project with a focus on technical detail and achieving a photorealistic aesthetic.\",\n    \"client_work_experience\": \"2 years of freelance work, primarily focused on illustration projects.\",\n    \"design_awards\": [\n        \"Best Illustration Award - 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Fine Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2017\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2021-01-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [\n        \"Digital Illustration Certification\"\n    ],\n    \"objec