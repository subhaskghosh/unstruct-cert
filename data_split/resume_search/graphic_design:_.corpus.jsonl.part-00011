n    \"availability\": \"2024-12-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69890", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for 'Sunrise Cafe'\",\n            \"description\": \"Created a modern and vibrant logo for a local cafe.\",\n            \"image_url\": \"https://example.com/sunrise_cafe_logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockup for 'Tech Solutions'\",\n            \"description\": \"Designed a clean and user-friendly website mockup.\",\n            \"image_url\": \"https://example.com/tech_solutions_website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with understanding the client's brand identity and target audience, then develop concepts through sketching and digital prototyping.\",\n    \"client_work_experience\": \"5+ years of experience collaborating with clients to deliver effective and visually appealing designs.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2018-Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"UI/UX Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69890", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brochure Design for 'Travel Adventures'\",\n            \"description\": \"Designed a colorful brochure promoting travel packages.\",\n            \"image_url\": \"https://example.com/travel_brochure.jpg\"\n        }\n    ],\n    \"design_specialization\": \"illustration\",\n    \"creative_process\": \"I typically start by gathering inspiration from various sources and experimenting with different styles.\",\n    \"client_work_experience\": \"2 years of experience working with clients on various design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"college\": \"Community College of Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"duration\": \"2020-2022\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Illustration\",\n        \"Digital Painting\",\n        \"beginner\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking an entry-level design position to expand my skills and experience.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2024-04-01\"\n}"}
