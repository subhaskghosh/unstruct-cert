{"_id": "resume_search--graphic_design:_--p--70412", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup\",\n            \"description\": \"Designed a complete brand identity, including logo, color palette, typography, and brand guidelines for a new tech startup. Focused on a clean, modern aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/startup_branding.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Developed the UI/UX design for a mobile application, emphasizing usability and a minimalist design approach.\",\n            \"image_url\": \"https://example.com/portfolio/mobile_app_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with thorough research and brainstorming, followed by sketching and prototyping. I prioritize user feedback and iterative design improvements.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver effective design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n   