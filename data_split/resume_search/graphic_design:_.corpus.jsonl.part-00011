{"_id": "resume_search--graphic_design:_--p--70522", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, typography, and brand guidelines.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechSolutions'\",\n            \"description\": \"UI/UX design for a modern and responsive website.\",\n            \"image_url\": \"https://example.com/techsolutions.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a highly collaborative process, working closely with clients through sketching, wireframing, and iterative feedback to achieve a design that perfectly reflects their vision and target audience.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating with diverse clients, consistently delivering designs that meet their objectives and exceed expectations.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\"\n    ],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Bra