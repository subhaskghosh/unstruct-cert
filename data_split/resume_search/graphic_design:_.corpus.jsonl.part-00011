,\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my creative skills and experience in branding to contribute to a dynamic and innovative design team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.amelia-stone-portfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
