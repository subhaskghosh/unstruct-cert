{"_id": "resume_search--graphic_design:_--n--69660", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Client Z\",\n            \"description\": \"Logo design and brand identity for a local business.\",\n            \"url\": \"http://example.com/portfolio/clientz\"\n        }\n    ],\n    \"design_specialization\": \"Logo Design\",\n    \"creative_process\": \"I focus on creating visually appealing and memorable logos that represent the client's brand.\",\n    \"client_work_experience\": \"I have 1.5 years of experience working with clients on logo design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Design\",\n            \"college\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Junior Graphic Designer\",\n            \"company\": \"Small Business B\",\n            \"start_date\": \"2022-01-01\",\n            \"end_date\": \"2023-06-30\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a junior graphic design position where I can develop my skills and contribute to a team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"http://example.com/portfolio\"\n    ],\n    \"availability\": \"2025-01-15\"\n}"}
