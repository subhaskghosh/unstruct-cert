{"_id": "resume_search--graphic_design:_--p--70431", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide for a sustainable flower delivery service.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'Tech Solutions'\",\n            \"description\": \"UI/UX design for a tech startup's website, focusing on user flow and conversion optimization.\",\n            \"url\": \"https://example.com/techsolutions\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My design process is heavily user-centered, starting with research and empathy mapping to understand the target audience's needs and preferences. I iterate based on user feedback and prioritize creating visually appealing and functional designs.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating directly with clients, managing projects from initial concept to final delivery, and consistently exceeding expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding graphic design role.\",\n    \"languages\": [\n        \"English\",\n        \"Hindi\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70431", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Flyer Design for Local Event\",\n            \"description\": \"A promotional flyer designed for a community fundraising event.\",\n            \"url\": \"https://example.com/flyer\"\n        },\n        {\n            \"title\": \"Brochure Design for Travel Agency\",\n            \"description\": \"Tri-fold brochure showcasing travel packages and destinations.\",\n            \"url\": \"https://example.com/brochure\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on translating client briefs into visually appealing designs, utilizing established design principles and techniques.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients, primarily focused on print media projects.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Applied Science in Graphic Communications\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"PrintPro Solutions\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\",\n        \"Adobe InDesign\",\n        \"Color Management\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To secure a graphic design position where I can utilize my skills and c