{"_id": "resume_search--graphic_design:_--n--68183", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Social Media Graphics for 'FashionHub'\",\n            \"description\": \"Created a series of engaging social media graphics for a fashion retail brand.\",\n            \"image_url\": \"https://example.com/fashionhub.jpg\"\n        },\n        {\n            \"title\": \"Illustration Series for 'Children's Books'\",\n            \"description\": \"Developed illustrations for a series of children's books.\",\n            \"image_url\": \"https://example.com/childrensbooks.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I approach each project with a clear vision, focusing on creating visually stunning and detailed illustrations.\",\n    \"client_work_experience\": \"Worked with various clients, successfully delivering high-quality illustrations that met their specific requirements.\",\n    \"design_awards\": [\n        \"Best Illustrator Award - 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2018-05-01\",\n            \"end_date\": \"2024-01-01\"\n        },\n        {\n            \"title\": \"Senior Illustrator\",\n            \"company\": \"Illustration Studio Y\",\n            \"start_date\": \"2021-01-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\",\n        \"Adobe Photoshop\",\n        \"Storyboarding\"\n    ],\n    \"certifications\": [\n        \"Digital Illustration Certification\"\n    ],\n    \"objective\": \"To continue creating captivating illustrations and expanding my artistic horizons.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsillustrations.com\"\n    ],\n    \"availability\": \"2024-02-28\"\n}"}
