{"_id": "resume_search--graphic_design:_--n--70178", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Complex Illustration Work\",\n            \"description\": \"Detailed illustrations created for children's books.\",\n            \"image_url\": \"https://example.com/portfolio/illustration.jpg\"\n        },\n        {\n            \"title\": \"Traditional Painting\",\n            \"description\": \"Oil paintings showcasing artistic skill.\",\n            \"image_url\": \"https://example.com/portfolio/painting.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"My process involves a lot of sketching and experimentation with different techniques.\",\n    \"client_work_experience\": \"Limited client interaction, primarily working on personal projects.\",\n    \"design_awards\": [\n        \"Local Art Competition Winner\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"State University\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\",\n        \"Sketching\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career in illustration and visual arts.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n   