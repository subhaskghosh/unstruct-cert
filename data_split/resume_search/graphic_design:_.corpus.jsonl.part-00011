ges\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://example.com/portfolio\"\n    ],\n    \"availability\": \"2023-11-25\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69347", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"A series of engaging social media graphics for a food delivery service.\",\n            \"image_url\": \"https://example.com/social_media.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Social Media Marketing\",\n    \"creative_process\": \"I prioritize fast turnaround times and creating visually appealing content that aligns with current trends.\",\n    \"client_work_experience\": \"Successfully managed multiple social media campaigns for a variety of clients.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Marketing\",\n            \"university\": \"State University\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Social Media Manager\",\n            \"company\": \"Marketing Agency X\",\n            \"years\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Social Media Marketing\",\n        \"Content Creation\",\n        \"Graphic Design\",\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"certifications\": [\n        \"Social Media Marketing Certification\"\n    ],\n    \"objective\": \"To excel in a social media marketing role and drive brand awareness through creative campaigns.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://example.com/socialmedia\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69348", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Local Coffee Shop\",\n            \"description\": \"Developed a complete branding package including logo, color palette, and marketing materials.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"Designed user interface mockups for a responsive website.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming before sketching initial concepts. I iterate based on feedback and focus on creating visually appealing and effective designs.\",\n    \"client_work_experience\": \"Extensive experience working directly with clients to understand their needs and deliver designs that exceed their expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"UI/UX Design\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design position where I can utilize my skills and creativity to contribute to innovative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
