{"_id": "resume_search--graphic_design:_--p--69717", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'The Coffee Bean'\",\n            \"description\": \"Complete branding package including logo design, color palette, and brand guidelines.\"\n        },\n        {\n            \"title\": \"Website Mockups for 'Tech Solutions'\",\n            \"description\": \"UI/UX design for a tech company's new website.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research and sketching, followed by digital mockups and iterative refinement based on client feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients, managing expectations, and delivering projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Co.\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can utilize my skills and creativity to contribute to innovative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"www.alicesmithdesign.com\"\n    ],\n    \"availability\": \"2024-11-25\"\n}"}
