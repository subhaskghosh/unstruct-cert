{"_id": "resume_search--graphic_design:_--n--69843", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Project\",\n            \"description\": \"Digital illustration for a children's book.\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"My process is very intuitive, starting with a feeling and evolving through experimentation.\",\n    \"client_work_experience\": \"Limited client interaction, primarily focused on personal projects.\",\n    \"design_awards\": [\n        \"Local Art Competition Winner\"\n    ],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [\n        \"Digital Art Fundamentals\"\n    ],\n    \"objective\": \"To pursue freelance illustration opportunities.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobjohnsonart.com\"\n    ],\n    \"availability\": \"2025-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69844", "text": "{\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for 'Bloom'\",\n            \"description\": \"Created a modern and minimalist logo for a floral boutique.\",\n            \"image_url\": \"https://example.com/bloom_logo.jpg\"\n        },\n        {\n            \"title\": \"Website Mockup for 'Tech Solutions'\",\n            \"description\": \"Designed a user-friendly website mockup for a tech company.\",\n            \"image_url\": \"https://example.com/tech_solutions_mockup.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I start with thorough research and brainstorming before sketching initial concepts. I iterate based on client feedback, focusing on visual storytelling.\",\n    \"client_work_experience\": \"I have extensive experience collaborating directly with clients to understand their brand identity and translate it into effective designs.\",\n    \"design_awards\": [],\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"UI/UX\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design role where I can contribute my creativity and skills to a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
