{"_id": "resume_search--graphic_design:_--p--71605", "text": "{\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Rhode Island School of Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Brand Identity Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Developed and executed brand identities for a diverse range of clients, including logo design, brand guidelines, and marketing collateral.\"\n        },\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2024-01-01\",\n            \"end_date\": null,\n            \"description\": \"Providing branding and design solutions for small businesses and startups.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Visual Communication\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Illustrator\",\n        \"Adobe Photoshop\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Logo for Tech Startup\",\n            \"description\": \"A minimalist logo design for a technology startup, emphasizing innovation and simplicity.\",\n            \"image_url\": \"https://example.com/logo1.jpg\"\n        },\n        {\n            \"title\": \"Brand Guidelines for Retail Company\",\n            \"description\": \"Comprehensive brand guidelines including logo usage, color palette, typography, and imagery.\",\n            \"image_url\": \"https://example.com/brandguidelines.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin with thorough client research and concept development, followed by iterative design and feedback. My approach emphasizes clean, modern aesthetics and strategic brand messaging.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients to understand their needs and deliver design solutions that exceed expectations.\",\n    \"portfolio_links\": [\n        \"https://eleanorvance.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
