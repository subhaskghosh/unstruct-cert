{"_id": "resume_search--graphic_design:_--p--69313", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Designed a modern logo and brand identity for a new technology startup.\",\n            \"image_url\": \"https://example.com/logo1.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"Created high-fidelity website mockups for a client in the e-commerce industry.\",\n            \"image_url\": \"https://example.com/website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital prototyping. I prioritize client feedback throughout the entire process.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating directly with clients, understanding their needs, and delivering designs that exceed their expectations. I'm adept at managing feedback and revisions efficiently.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Web Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design position where I can utilize my skills and creativity to contribute to a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-11-20\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69313", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Project\",\n            \"description\": \"A digital illustration for a children's book.\",\n            \"image_url\": \"https://example.com/illustration.jpg\"\n        }\n    ],\n    \"design_specialization\": \"illustration\",\n    \"creative_process\": \"I like to start with a rough sketch and then refine it digitally.\",\n    \"client_work_experience\": \"I have some experience working with clients, primarily on freelance illustration projects.\",\n    \"design_awards\": [\n        \"Local Art Competition - 3rd Place\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College of Art\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2022-01-01\",\n            \"end_date\": \"2024-06-01\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find freelance illustration work.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n    ],\n    \"availability\": \"2025-01-15\"\n}"}
