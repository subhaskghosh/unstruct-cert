     \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\",\n        \"Adobe Creative Suite\",\n        \"Figma\",\n        \"Wireframing\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Expert - Photoshop\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68996", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"Adobe InDesign\",\n        \"Blender\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustrative Book Cover\",\n            \"description\": \"Detailed illustration for a fantasy novel cover, utilizing a highly ornate and colorful style.\",\n            \"url\": \"https://example.com/portfolio/bookcover\"\n        },\n        {\n            \"title\": \"3D Modeling Project\",\n            \"description\": \"A 3D model of a futuristic cityscape, demonstrating technical proficiency in Blender.\",\n            \"url\": \"https://example.com/portfolio/3dmodel\"\n        }\n    ],\n    \"design_specialization\": \"Illustration & 3D Modeling\",\n    \"creative_process\": \"I rely heavily on visual inspiration and technical experimentation to create unique and imaginative designs.\",\n    \"client_work_experience\": \"Approximately 1 year of freelance experience working with a limited number of clients.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Digital Media\",\n            \"college\": \"Community College\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"3D Modeling\",\n        \"CorelDRAW\",\n        \"Adobe InDesign\",\n        \"Digital Painting\"\n    ],\n    \"certifications\": [\n        \"Certified Blender User\"\n    ],\n    \"objective\": \"Seeking opportunities to utilize my artistic skills in a creative environment.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
