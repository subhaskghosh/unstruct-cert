{"_id": "resume_search--graphic_design:_--p--68739", "text": "{\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"California Institute of the Arts\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Innovate Solutions\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"Developed a complete brand identity for a new tech startup, including logo, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/portfolio/techstartup\"\n        },\n        {\n            \"title\": \"UI/UX Redesign of Mobile App\",\n            \"description\": \"Led the UI/UX redesign of a mobile app, resulting in a 20% increase in user engagement.\",\n            \"url\": \"https://example.com/portfolio/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX Design\",\n    \"creative_process\": \"I start with thorough research and client interviews to understand their needs and target audience.  I then move into sketching and wireframing before developing digital designs.\",\n    \"client_work_experience\": \"Extensive experience working directly with clients to deliver exceptional designs that meet their business objectives.\",\n    \"design_awards\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can leverage my skills and creativity to deliver impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
