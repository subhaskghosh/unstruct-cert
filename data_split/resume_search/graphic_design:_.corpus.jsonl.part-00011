jective\": \"To leverage my branding expertise to create impactful visual solutions for innovative companies.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
