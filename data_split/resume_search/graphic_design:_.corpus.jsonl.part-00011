guages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70041", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Detailed Illustration\",\n            \"description\": \"A highly detailed and ornate illustration in a traditional style.\",\n            \"url\": \"https://example.com/portfolio/illustration\"\n        },\n        {\n            \"title\": \"Print Magazine Layout\",\n            \"description\": \"A complex magazine layout featuring multiple images and text elements.\",\n            \"url\": \"https://example.com/portfolio/magazine\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I focus on detailed execution and achieving a high level of realism in my work.\",\n    \"client_work_experience\": \"Experienced in working with clients on illustration projects.\",\n    \"design_awards\": [\n        \"Illustration Award 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Illustration Studio Y\",\n            \"duration\": \"4 years\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find a challenging position where I can utilize my illustration skills.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n 