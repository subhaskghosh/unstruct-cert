{"_id": "resume_search--graphic_design:_--p--70631", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern and minimalist logo for a tech startup, focusing on brand identity and scalability.\",\n            \"url\": \"https://example.com/logo1\"\n        },\n        {\n            \"title\": \"Branding Guidelines for Fashion Brand\",\n            \"description\": \"Developed comprehensive branding guidelines, including logo usage, color palettes, and typography.\",\n            \"url\": \"https://example.com/branding1\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process involves thorough research, sketching, and iterative design based on client feedback.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients, understanding their needs, and delivering high-quality design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a