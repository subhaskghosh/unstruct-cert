{"_id": "resume_search--graphic_design:_--p--71539", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo design, color palette, typography, and brand guidelines for a sustainable floral company. Focused on a modern and minimalist aesthetic.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechSolutions'\",\n            \"description\": \"UI/UX design for a tech startup's website. Focused on user flow and clean design.\",\n            \"image_url\": \"https://example.com/techsolutions.png\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My creative process begins with thorough user research and understanding client goals. I then develop multiple concepts, iterate based on feedback, and focus on creating designs that are both visually appealing and functionally effective.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients, managing expectations, and delivering projects on time and within budget.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Wonderland\",\n    \"contact_information\": {\n        \"email\": \"alice.wonderland@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"DesignCo\",\n            \"duration\": \"2020 - Present\"\n        }