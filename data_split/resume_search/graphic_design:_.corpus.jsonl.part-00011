{"_id": "resume_search--graphic_design:_--n--71793", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Book Cover Illustration\",\n            \"description\": \"Detailed illustration for a fantasy novel cover.\",\n            \"url\": \"https://example.com/book-cover\"\n        },\n        {\n            \"title\": \"Print Ad Design\",\n            \"description\": \"Print advertisement for a local business.\",\n            \"url\": \"https://example.com/print-ad\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I focus on bringing imaginative concepts to life through detailed and expressive illustrations.\",\n    \"client_work_experience\": \"2 years of experience working with clients on illustration projects.\",\n    \"design_awards\": [\n        \"Best Illustration Award - Local Art Fair 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Illustrator\",\n            \"company\": \"Freelance\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\",\n        \"Concept Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career as a professional illustrator.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsart.com\"\n    ],\n    \"availability\"