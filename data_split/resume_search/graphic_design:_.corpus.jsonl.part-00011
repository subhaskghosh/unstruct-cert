,\n    \"objective\": \"Seeking freelance illustration opportunities to expand my artistic skillset.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bencarterart.com\"\n    ],\n    \"availability\": \"2024-06-01\"\n}"}
