  \"portfolio_links\": [\n        \"https://www.alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-10-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69242", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"UI Design for Mobile App\",\n            \"description\": \"Designed the user interface for a mobile application.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX\",\n    \"creative_process\": \"I prioritize user-centered design, focusing on usability and accessibility.\",\n    \"client_work_experience\": \"I have 2 years of experience working with clients, primarily on digital projects.\",\n    \"design_awards\": [\n        \"UX Design Award 2023\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"Tech Institute\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Tech Startup Y\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Usability Testing\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"Seeking a challenging role in UI/UX design where I can leverage my skills to create innovative user experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobwilliamsux.com\"\n    ],\n    \"availability\": \"2024-11-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69243", "text": "{\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Designed branding materials, UI/UX elements for web and mobile applications, and marketing collateral.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Tech Startup\",\n            \"description\": \"Complete branding package including logo, color palette, and style guide.\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Wireframes and visual designs for a mobile application.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I start with understanding the client's needs and target audience, then move to concept development and iterative design.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, presenting designs, and incorporating feedback.\",\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicesmithdesign.com\"\n    ],\n    \"availability\": \"2024-01-16\"\n}"}
