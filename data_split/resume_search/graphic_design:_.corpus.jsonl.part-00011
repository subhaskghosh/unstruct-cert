{"_id": "resume_search--graphic_design:_--n--69677", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Gamma Industries\",\n            \"description\": \"Designed a minimalist logo for Gamma Industries.\",\n            \"url\": \"https://example.com/gamma-logo\"\n        },\n        {\n            \"title\": \"Brochure Design for Delta Corp\",\n            \"description\": \"Created a visually engaging brochure for Delta Corp's marketing campaign.\",\n            \"url\": \"https://example.com/delta-brochure\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I focus on developing strong visual identities that resonate with target audiences.\",\n    \"client_work_experience\": \"Proven ability to manage client relationships and deliver projects on time and within budget.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Marketing\",\n            \"university\": \"State University\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Marketing Agency\",\n            \"duration\": \"2018-2022\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Marketing Materials\",\n        \"Print Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my design expertise to a creative and innovative team.\",\n    \"languages\": [\n        \"English\",\n