{"_id": "resume_search--graphic_design:_--p--71113", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Tech Startup Branding\",\n            \"description\": \"Complete branding package for a seed-funded tech startup, including logo design, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/techbranding\"\n        },\n        {\n            \"title\": \"Mobile App UI/UX\",\n            \"description\": \"UI/UX design for a mobile application focused on productivity, emphasizing user-friendliness and visual appeal.\",\n            \"url\": \"https://example.com/mobileapp\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a highly collaborative creative process, working closely with clients to understand their vision and translate it into impactful designs. Iteration and feedback are crucial throughout the project.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients across various industries, particularly within the tech sector. I excel at understanding client needs and delivering solutions that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Figma\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience to create impactful branding solutions for innovative companies.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71113", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"GIMP\",\n        \"Blender\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Series\",\n            \"description\": \"A series of digital illustrations exploring fantasy themes.\",\n            \"url\": \"https://example.com/illustrations\"\n        },\n        {\n            \"title\": \"Web Banner Designs\",\n            \"description\": \"Collection of static web banners for various products.\",\n            \"url\": \"https://example.com/banners\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I generally start with a personal concept and then refine it based on feedback. I prefer to work independently.\",\n    \"client_work_experience\": \"Limited experience working directly with clients. I've primarily worked on personal projects.\",\n    \"design_awards\": [\n        \"Local Art Competition - Honorable Mention\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Concept Art\",\n        \"CorelDRAW\",\n        \"GIMP\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To develop my skills as an illustrator and contribute to creative projects.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\