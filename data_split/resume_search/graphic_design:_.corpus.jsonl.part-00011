{"_id": "resume_search--graphic_design:_--n--69443", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for 'SmallBiz'\",\n            \"description\": \"A simple logo design for a local business.\",\n            \"url\": \"https://example.com/smallbiz\"\n        },\n        {\n            \"title\": \"Flyer for 'EventX'\",\n            \"description\": \"A promotional flyer for a local event.\",\n            \"url\": \"https://example.com/eventx\"\n        }\n    ],\n    \"design_specialization\": \"Logo Design\",\n    \"creative_process\": \"I focus on delivering quick and effective solutions to meet client needs.\",\n    \"client_work_experience\": \"I have limited experience working directly with clients.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Smith\",\n    \"contact_information\": {\n        \"email\": \"bob.smith@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022-2023\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\",\n        \"Logo Design\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a design position where I can utilize my skills.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-01-10\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69444", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern and scalable logo for a new tech startup.\",\n            \"url\": \"https://example.com/logo1\"\n        },\n        {\n            \"title\": \"Branding Guidelines\",\n            \"description\": \"Developed comprehensive branding guidelines for a client.\",\n            \"url\": \"https://example.com/branding1\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital prototyping. I prioritize client feedback throughout the process.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating directly with clients to deliver creative solutions that meet their business objectives.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Web Design\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creativity and design skills to a challenging and rewarding role in a dynamic team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alice-smith-portfolio.com\"\n    ],\n    \"availability\": \"2024-11-15\"\n}"}
