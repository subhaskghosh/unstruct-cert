{"_id": "resume_search--graphic_design:_--n--69630", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design\",\n            \"description\": \"A logo I designed for a small business.\",\n            \"image_url\": \"https://example.com/logo.jpg\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I work independently, focusing on delivering high-quality designs based on client briefs.\",\n    \"client_work_experience\": \"2 years of experience working with clients, primarily receiving briefs and delivering final designs.\",\n    \"design_awards\": [\n        \"Local Design Competition - Honorable Mention\"\n    ],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate's Degree in Graphic Arts\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Logo Design\",\n        \"Print Design\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging freelance design opportunity.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliamsdesign.com\"\n    ],\n    \"availability\": \"2024-02-01\"\n}"}
