{"_id": "resume_search--graphic_design:_--p--68837", "text": "{\n    \"name\": \"Anya Sharma\",\n    \"contact_information\": {\n        \"email\": \"anya.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Design Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Brand Designer\",\n            \"company\": \"Creative Solutions Inc.\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\",\n        \"Marketing Collateral\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines for a sustainable flower delivery service. Focused on a natural and elegant aesthetic.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design and mockups for a tech startup's website. Modern, clean design with a focus on user experience and readability.\",\n            \"image_url\": \"https://example.com/techforward.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"My creative process is highly iterative and collaborative, starting with extensive research and mood boarding, followed by sketching and prototyping, and refined through client feedback. I prioritize a modern aesthetic and conceptual thinking.\",\n    \"client_work_experience\": \"I have extensive experience collaborating directly with clients to understand their brand needs and translate them into effective design solutions.\",\n    \"design_awards\": [],\n    \"objective\": \"To contribute my branding expertise and creative vision to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68837", "text": "{\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Art Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Communication\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Marketing Assistant\",\n            \"company\": \"Global Marketing Solutions\",\n            \"duration\": \"2018 - 2021\"\n        },\n        {\n            \"title\": \"Junior Designer\",\n            \"company\": \"Design Co.\",\n            \"duration\": \"2021 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Social Media Marketing\",\n        \"Content Creation\",\n        \"Adobe Photoshop\",\n        \"Basic Graphic Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Canva\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Social Media Graphics\",\n            \"description\": \"Various social media graphics created for different clients.\",\n            \"image_url\": \"https://example.com/socialmedia.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Social Media Graphics\",\n    \"creative_process\": \"I generally follow client direction closely and aim to execute their vision efficiently.\",\n    \"client_work_experience\": \"I have some experience communicating with clients, primarily regarding feedback on designs.\",\n    \"design_awards\": [],\n    \"objective\": \"To grow my skills in the marketing and design field.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bencarterdesign.com\"\n    ],\n    \"availability\": \"2024-02-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--68838", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Minimalist Branding for Tech Startup\",\n            \"description\": \"Clean and modern branding design for a new technology company, focusing on a minimalist aesthetic. Included logo design, color palette, and brand guidelines.\",\n            \"image_url\": \"https://example.com/portfolio/tech_branding.jpg\"\n        },\n        {\n            \"title\": \"Website Mockups - User Interface\",\n            \"description\": \"Modern UI design for a responsive website. Focuses on simplicity and user experience.\",\n            \"image_url\": \"https://example.com/portfolio/website_ui.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My creative process starts with thorough research and understanding of the client's needs and target audience. I then move into sketching and wireframing, followed by iterative design and refinement based on feedback.\",\n    \"client_work_experience\": \"I have extensive experience working directly with clients, understanding their vision, and translating it into effective design solutions. I'm comfortable presenting designs and incorporating feedback throughout the process.\",\n    \"design_awards\": [],\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.avachen.design\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--68838", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Complex Illustration - Fantasy Art\",\n            \"description\": \"Detailed and intricate illustration of a fantasy landscape.\",\n            \"image_url\": \"https://example.com/portfolio/fantasy_art.jpg\"\n        },\n        {\n            \"title\": \"Traditional Painting - Oil on Canvas\",\n            \"description\": \"A vibrant oil painting showcasing a portrait.\",\n            \"image_url\": \"https://example.com/portfolio/oil_painting.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I usually start with a detailed concept sketch, then move into rendering and refining the details.  I focus on technical skill and visual impact.\",\n    \"client_work_experience\": \"I've primarily worked on personal projects and commissions, with limited direct client interaction.\",\n    \"design_awards\": [\n        \"Local Art Competition - 1st Place\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute of America\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\",\n        \"Adobe Illustrator\",\n        \"Composition\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking freelance