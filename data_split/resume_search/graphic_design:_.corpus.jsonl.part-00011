{"_id": "resume_search--graphic_design:_--p--69709", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern logo and brand guidelines for a new tech company.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"Designed website mockups for a client in the fashion industry.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin by understanding the client's vision and target audience. I then sketch out multiple concepts before moving into digital design.\",\n    \"client_work_experience\": \"I have over 4 years of experience collaborating with clients, understanding their needs, and delivering designs that exceed their expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Web Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a challenging and rewarding role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-05-15\"\n}"}
