{"_id": "resume_search--graphic_design:_--p--69365", "text": "{\n    \"name\": \"Ava Carter\",\n    \"contact_information\": {\n        \"email\": \"ava.carter@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Brand Solutions Inc.\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Developed branding materials for various clients, including logo design, brand guidelines, and marketing collateral.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Branding\",\n        \"Logo Design\",\n        \"Typography\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"design_specialization\": \"Branding\",\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Coffee Shop\",\n            \"description\": \"Designed a logo and brand identity for a local coffee shop. Project completed in 2023.\",\n            \"url\": \"https://example.com/logo1\"\n        },\n        {\n            \"title\": \"Marketing Collateral for Tech Startup\",\n            \"description\": \"Created marketing materials for a tech startup, including brochures and social media graphics. Project completed in 2022.\",\n            \"url\": \"https://example.com/marketing1\"\n        }\n    ],\n    \"portfolio_links\": [\n        \"https://avacarterdesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
