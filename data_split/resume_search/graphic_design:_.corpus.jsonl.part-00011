{\n            \"title\": \"Graphic Designer\",\n            \"company\": \"DesignCo\",\n            \"duration\": \"2020 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Brand Identity\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To leverage my design skills and creativity to develop impactful brand experiences for innovative companies.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://anyasharma.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
