,\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.exampleportfolio.com/ava\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--71184", "text": "{\n    \"design_software_proficiency\": [\n        \"Figma\",\n        \"Adobe XD\",\n        \"Sketch\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup for E-commerce Site\",\n            \"description\": \"Designed a clean and user-friendly website mockup.\"\n        },\n        {\n            \"title\": \"Mobile App UI Design\",\n            \"description\": \"Developed a mobile app UI with a focus on usability.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX Design\",\n    \"creative_process\": \"I prefer a user-centric design process, focusing heavily on wireframing and prototyping before visual design. I work efficiently and independently.\",\n    \"client_work_experience\": \"2 years of experience working with clients on web and app design projects.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"Tech Institute\",\n            \"year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"UI/UX Designer\",\n            \"company\": \"Web Solutions Inc.\",\n            \"duration\": \"2021-Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Design\",\n        \"Wireframing\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To create intuitive and engaging user experiences.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.exampleportfolio.com/ben\"\n    ],\n    \"availability\": \"2024-04-30\"\n}"}
{"_id": "resume_search--graphic_design:_--p--71185", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for Startup X\",\n            \"description\": \"Complete branding package including logo, color palette, and brand guidelines.\",\n            \"url\": \"https://example.com/portfolio/startupx\"\n        },\n        {\n            \"title\": \"UI/UX Redesign of Mobile App Y\",\n            \"description\": \"Redesigned user interface and user experience for a mobile application, resulting in increased user engagement.\",\n            \"url\": \"https://example.com/portfolio/appY\"\n        }\n    ],\n    \"design_specialization\": \"Branding and UI/UX\",\n    \"creative_process\": \"I approach design with a user-centered methodology, starting with research and prototyping before iterating on designs based on feedback. I pay close attention to detail and strive for a clean, modern aesthetic.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients across various industries, translating their needs into effective visual solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency A\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n       