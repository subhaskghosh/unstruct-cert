           \"company\": \"Design Agency A\",\n            \"duration\": \"2020 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Logo Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my skills and experience in graphic design to create impactful visual solutions for innovative companies.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
