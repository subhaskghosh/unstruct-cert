itle\": \"Senior Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To leverage my skills and experience in graphic design to create impactful and innovative visual solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsondesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
