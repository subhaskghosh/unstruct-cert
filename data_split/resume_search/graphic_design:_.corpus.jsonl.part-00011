{"_id": "resume_search--graphic_design:_--n--71101", "text": "{\n    \"design_software_proficiency\": [\n        \"CorelDRAW\",\n        \"Sketch\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration for Children's Book\",\n            \"description\": \"Illustrations for a children's book with a whimsical style.\",\n            \"image_url\": \"https://example.com/childrensbook.jpg\"\n        },\n        {\n            \"title\": \"Motion Graphics for Social Media\",\n            \"description\": \"Short animated videos for social media campaigns.\",\n            \"image_url\": \"https://example.com/motiongraphics.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I'm inspired by nature and storytelling. I use a variety of techniques to bring my ideas to life, focusing on detail and emotional impact.\",\n    \"client_work_experience\": \"2 years of freelance experience working with small businesses on illustration projects.\",\n    \"design_awards\": [\n        \"Local Art Competition Winner - 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Illustration\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2021\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2021 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Motion Graphics\",\n        \"Storyboarding\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Associate in Photoshop\"\n    ],\n    \"o