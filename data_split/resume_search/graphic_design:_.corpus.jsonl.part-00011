{"_id": "resume_search--graphic_design:_--n--69634", "text": "{\n    \"design_software_proficiency\": [\n        \"Figma\",\n        \"Sketch\",\n        \"Adobe XD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"Designed user interfaces and user experiences for a mobile application.\",\n            \"url\": \"https://example.com/uiux1\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX\",\n    \"creative_process\": \"I focus on user-centered design principles and iterative prototyping.\",\n    \"client_work_experience\": \"2 years of experience working with clients.\",\n    \"design_awards\": [\n        \"Best UI Design Award 2023\"\n    ],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Ave, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Tech Solutions\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"User Testing\"\n    ],\n    \"certifications\": [\n        \"Certified UX Professional\"\n    ],\n    \"objective\": \"To create innovative and user-friendly digital experiences.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobjohnsonux.com\"\n    ],\n    \"availability\": \"2024-05-01\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69635", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding Project for Startup X\",\n            \"description\": \"Developed a complete branding identity including logo, color palette, and style guide.\",\n            \"image_url\": \"https://example.com/startupx_branding.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App Y\",\n            \"description\": \"Designed user interfaces and user experience for a mobile application.\",\n            \"image_url\": \"https://example.com/appY_uiux.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I approach design with a user-centered mindset, starting with research and ideation, followed by prototyping and iteration based on feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver effective design solutions.\",\n    \"design_awards\": [\n        \"Design Excellence Award 2022\"\n    ],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency Z\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design role where I can leverage my creativity and skills to contribute to innovative projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicesmithportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
