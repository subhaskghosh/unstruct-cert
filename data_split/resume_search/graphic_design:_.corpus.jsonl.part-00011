{"_id": "resume_search--graphic_design:_--p--70591", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Brand Identity for Tech Startup\",\n            \"description\": \"A complete brand identity package including logo, color palette, typography, and brand guidelines. Focused on a clean, modern aesthetic.\",\n            \"image_url\": \"https://example.com/portfolio/tech_startup.jpg\"\n        },\n        {\n            \"title\": \"Illustrative Packaging Design\",\n            \"description\": \"Packaging design for a new line of organic teas, featuring hand-drawn illustrations.\",\n            \"image_url\": \"https://example.com/portfolio/tea_packaging.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I begin each project with thorough research and ideation, followed by sketching and digital prototyping. Collaboration with the client is crucial throughout the process.\",\n    \"client_work_experience\": \"5+ years of experience working directly with clients to deliver successful design solutions, managing projects from concept to completion.\",\n    \"design_awards\": [\n        \"AIGA Design Award (2022)\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n 