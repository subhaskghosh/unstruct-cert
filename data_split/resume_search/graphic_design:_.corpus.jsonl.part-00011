{"_id": "resume_search--graphic_design:_--p--68843", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Mobile App UI/UX - 'TravelEase'\",\n            \"description\": \"UI/UX design for a mobile travel application, focusing on user flow and usability.\",\n            \"url\": \"https://example.com/travelease\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I believe in a user-centered design approach, starting with research and ideation, followed by prototyping and iterative feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating directly with clients, understanding their needs, and translating them into effective design solutions.\",\n    \"design_awards\": [\n        \"Golden A' Design Award 2022 - Branding Category\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Studio X\",\n            \"duration\": \"2020 - 2023\"\n        }\n    ],\n    \"skills\": [\n        \"Graphic Design\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional - Photoshop\"\n    ],\n    \"objective\": \"Seeking a challenging graphic design role in a collaborative environment where I can leverage my skills and creativity.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
