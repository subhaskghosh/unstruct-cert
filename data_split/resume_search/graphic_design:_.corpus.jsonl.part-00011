pography\",\n        \"Color Theory\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a dynamic team and create impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70618", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe InDesign\",\n        \"Sketch\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Magazine Layout for 'Travel Weekly'\",\n            \"description\": \"Designed a double-page spread for a travel magazine.\",\n            \"image_url\": \"https://example.com/travel_weekly_layout.jpg\"\n        },\n        {\n            \"title\": \"Flyer for Local Event\",\n            \"description\": \"Created a promotional flyer for a community event.\",\n            \"image_url\": \"https://example.com/community_flyer.png\"\n        }\n    ],\n    \"design_specialization\": \"Print Design\",\n    \"creative_process\": \"I focus on delivering designs that adhere strictly to the client's specifications and maintain a consistent visual style.\",\n    \"client_work_experience\": \"2 years of experience working with clients, primarily focused on executing existing design concepts.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Graphic Communication\",\n            \"university\": \"Community College\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Printing Solutions Inc.\",\n            \"duration\": \"2022 - 2024\"\n        }\n    ],\n    \"skills\": [\n        \"Print Design\",\n        \"Layout Design\",\n        \"Typography\",\n        \"Adobe InDesign\",\n        \"Prepress\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To find a challenging position where I can utilize my skills in print design and contribute to high-quality publications.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://bobwilliams.com\"\n    ],\n    \"availability\": \"2024-04-15\"\n}"}
{"_id": "resume_search--graphic_design:_--p--70619", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design including logo, color palette, typography, and brand guidelines, showcasing a clean and modern aesthetic.\",\n            \"image_url\": \"https://example.com/ecobloom.jpg\"\n        },\n        {\n            \"title\": \"UI/UX Design for Mobile App\",\n            \"description\": \"User interface and user experience design for a mobile application, focusing on simplicity and usability.\",\n            \"image_url\": \"https://example.com/mobileapp.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative and iterative design process, starting with thorough research and concept development, followed by prototyping and user testing.\",\n    \"client_work_experience\": \"Over 5 years of experience working directly with clients, understanding their needs, and delivering high-quality design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Thompson\",\n    \"contact_information\": {\n        \"email\": \"aria.thompson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art and Design\",\n            \"year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Design Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Logo Design\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design role where I can leverage my skills and experience to create impactful and visually appealing designs.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariathompson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70619", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Poster Design for Local Event\",\n            \"description\": \"Poster design for a community event, featuring vibrant colors and illustrative elements.\",\n            \"image_url\": \"https://example.com/poster.jpg\"\n        },\n        {\n            \"title\": \"Flyer Design for Restaurant\",\n            \"description\": \"Flyer design for a local restaurant, highlighting special offers.\",\n            \"image_url\": \"https://example.com/flyer.jpg\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy experimenting with different styles and techniques to create unique and eye-catching designs.\",\n    \"client_work_experience\": \"2 years of freelance work with small businesses and individuals.\",\n    \"design_awards\": [],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone_number\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Visual Communication\",\n            \"college\": \"Community College of Arts\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Graphic Designer\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Poster Design\",\n        \"Flyer Design\",\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and passion for design to a dynamic team.\",\n    \"languages\": [\n        \"English\",\n      