{"_id": "resume_search--graphic_design:_--p--71197", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe XD\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for Tech Startup\",\n            \"description\": \"Complete brand identity design, including logo, color palette, typography, and visual guidelines. Focused on a modern, minimalist aesthetic.\"\n        },\n        {\n            \"title\": \"Mobile App UI/UX Design\",\n            \"description\": \"UI/UX design for a mobile application, emphasizing user-friendliness and intuitive navigation.\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I approach projects with a user-centered design thinking process, starting with research and ideation, followed by prototyping and iterative testing.\",\n    \"client_work_experience\": \"I have consistently collaborated closely with clients throughout the design process, incorporating their feedback and ensuring their vision is realized.  I pride myself on clear communication and building strong relationships.\",\n    \"design_awards\": [],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UI/UX Designer\",\n            \"company\": \"Innovate Solutions\",\n            \"duration\": \"2020 - 2023\",\n            \"description\": \"Designed and developed user interfaces for web and mobile applications, working closely with developers and product managers.\"\n        },\n        {\n            \"title\": \"Brand Identity Designer\",\n            \"company\": \"Creative Agency\",\n            \"duration\": \"2023 - Present\",\n            \"description\": \"Leading brand identity projects, from concept development to final delivery. Strong emphasis on client collaboration.\"\n        }\n    ],\n    \"skills\": [\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\",\n        \"Prototyping\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To leverage my design skills and experience to create impactful and user-centered designs.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
