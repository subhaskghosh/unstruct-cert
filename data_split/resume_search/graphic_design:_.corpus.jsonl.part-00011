{"_id": "resume_search--graphic_design:_--p--71349", "text": "{\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"BrandBloom Agency\",\n            \"start_date\": \"2020-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Developed branding and marketing materials for a diverse range of clients. Led design projects from concept to completion.\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Branding\",\n        \"Logo Design\"\n    ],\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Modern Tech Startup Branding\",\n            \"description\": \"Complete branding package including logo, color palette, typography, and marketing materials.\"\n        },\n        {\n            \"title\": \"Restaurant Menu Design\",\n            \"description\": \"Designed a visually appealing and easy-to-read menu for a local restaurant.\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I believe in a collaborative approach, starting with understanding the client's vision and target audience. I then explore various concepts and iterate based on feedback.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, presenting design concepts, and incorporating feedback to achieve desired outcomes.\",\n    \"portfolio_links\": [\n        \"https://www.ariasharmadesign.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
