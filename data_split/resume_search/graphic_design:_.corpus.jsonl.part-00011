{"_id": "resume_search--graphic_design:_--n--69346", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Project\",\n            \"description\": \"A personal illustration project showcasing my artistic style.\"\n        }\n    ],\n    \"design_specialization\": \"illustration\",\n    \"creative_process\": \"I focus on artistic expression and let my creativity guide the design process.\",\n    \"client_work_experience\": \"I have limited experience working directly with clients; most of my work is personal projects.\",\n    \"design_awards\": [],\n    \"name\": \"Bob Williams\",\n    \"contact_information\": {\n        \"email\": \"bob.williams@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Painting\",\n        \"Digital Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To pursue a career as a freelance illustrator, creating unique and captivating artwork.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.bobwilliamsart.com\"\n    ],\n    \"availability\": \"2024-12-15\"\n}"}
