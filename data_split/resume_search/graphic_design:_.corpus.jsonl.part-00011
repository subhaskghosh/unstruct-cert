{"_id": "resume_search--graphic_design:_--p--69701", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Illustrator\",\n        \"Adobe Photoshop\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Coffee Shop\",\n            \"description\": \"Created a modern logo and branding guidelines for a new coffee shop.\"\n        },\n        {\n            \"title\": \"Brochure Design\",\n            \"description\": \"Designed a trifold brochure for a local event.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I start with understanding the client's vision, then move to sketching and concept development.  I iterate based on feedback and focus on creating visually appealing and effective designs.\",\n    \"client_work_experience\": \"I have over 3 years of experience working directly with clients, managing projects from concept to completion, and ensuring their satisfaction.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Typography\",\n        \"Print Design\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"Seeking a challenging graphic design position where I can utilize my skills and creativity to contribute to a successful team.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicesmithdesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--69701", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Illustrator\",\n        \"Adobe Photoshop\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Website Mockup\",\n            \"description\": \"Designed a clean and user-friendly website mockup.\"\n        },\n        {\n            \"title\": \"Mobile App Interface\",\n            \"description\": \"Created an intuitive mobile app interface.\"\n        }\n    ],\n    \"design_specialization\": \"UI/UX\",\n    \"creative_process\": \"I focus on user-centered design, conducting research and testing to create effective and engaging user experiences.\",\n    \"client_work_experience\": \"I have over 3 years of experience collaborating with clients to understand their needs and deliver user-focused designs.\",\n    \"design_awards\": [\n        \"Web Design Award 2022\"\n    ],\n    \"name\": \"Bob Johnson\",\n    \"contact_information\": {\n        \"email\": \"bob.johnson@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Computer Science\",\n            \"university\": \"Tech Institute\",\n            \"graduation_year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"UX Designer\",\n            \"company\": \"Tech Startup\",\n            \"duration\": \"2019 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"UI Design\",\n        \"UX Research\",\n        \"Prototyping\",\n        \"Usability Testing\"\n    ],\n    \"certifications\": [\n        \"Google UX Design Professional Certificate\"\n    ],\n    \"objective\": \"To leverage my UX design skills to create innovative and user-centered digital products.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\":