{"_id": "resume_search--graphic_design:_--p--69967", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete brand identity design for a sustainable floral delivery service, including logo, color palette, and brand guidelines.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'Tech Solutions'\",\n            \"description\": \"UI/UX design for a technology company's new website, focusing on user engagement and conversion rates.\",\n            \"url\": \"https://example.com/techsolutions\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital prototyping. I prioritize client feedback throughout the entire process.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients, understanding their needs, and delivering designs that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Adobe Creative Suite\",\n        \"UI/UX Design\",\n        \"Branding\",\n        \"Typography\",\n     