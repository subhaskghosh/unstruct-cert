{"_id": "resume_search--graphic_design:_--n--68363", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Detailed Architectural Illustration\",\n            \"description\": \"A highly detailed architectural rendering created for a construction firm. Emphasizes technical accuracy and precision.\",\n            \"url\": \"https://example.com/architecture\"\n        },\n        {\n            \"title\": \"Complex Mechanical Diagram\",\n            \"description\": \"A technical diagram illustrating the internal workings of a complex machine.\",\n            \"url\": \"https://example.com/mechanical\"\n        }\n    ],\n    \"design_specialization\": \"Technical Illustration\",\n    \"creative_process\": \"My process focuses on precision and accuracy, ensuring all details are meticulously represented.\",\n    \"client_work_experience\": \"I have worked with engineering firms and architects, delivering detailed technical visuals.\",\n    \"design_awards\": [\n        \"Award for Technical Excellence\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"+1-555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Engineering Graphics\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Technical Illustrator\",\n            \"company\": \"Engineering Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Technical Illustration\",\n        \"CAD Software\",\n        \"Adobe Illustrator\",\n        \"Precision Drawing\",\n        \"Detail Orientation\"\n  