{"_id": "resume_search--graphic_design:_--p--71744", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Tech Startup Branding\",\n            \"description\": \"Complete branding package for a seed-funded tech startup, including logo design, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/portfolio/techbranding\"\n        },\n        {\n            \"title\": \"Marketing Campaign Visuals\",\n            \"description\": \"Series of digital assets for a marketing campaign promoting a new software product.\",\n            \"url\": \"https://example.com/portfolio/marketingcampaign\"\n        }\n    ],\n    \"design_specialization\": \"Branding & Marketing Design\",\n    \"creative_process\": \"I begin with thorough research into the client's brand and target audience, followed by iterative design explorations and feedback sessions.\",\n    \"client_work_experience\": \"Extensive experience collaborating with clients to understand their needs and deliver effective design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"XYZ Tech Solutions\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Marketing Design\",\n        \"