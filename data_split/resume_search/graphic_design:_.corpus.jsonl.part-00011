{"_id": "resume_search--graphic_design:_--p--70042", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Branding for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo, color palette, typography, and brand guidelines for a sustainable flower delivery service.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechSolutions'\",\n            \"description\": \"UI/UX design for a tech startup’s website, focusing on user engagement and clear information architecture.\",\n            \"url\": \"https://example.com/techsolutions\"\n        }\n    ],\n    \"design_specialization\": \"Branding & UI/UX\",\n    \"creative_process\": \"My creative process starts with thorough research and understanding the client's brand identity and target audience. I then develop multiple concepts, iterating based on feedback, and delivering a polished and effective design solution.\",\n    \"client_work_experience\": \"Over 5 years of experience collaborating with diverse clients, from startups to established corporations, consistently delivering designs that meet and exceed their expectations.\",\n    \"design_awards\": [\n        \"Design Excellence Award - 2022\"\n    ],\n    \"name\": \"Ava Chen\",\n    \"contact_information\": {\n        \"email\": \"ava.chen@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Arts\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"DesignCo\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Adobe Creative Suite\",\n        \"Illustration\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://avachen.portfolio.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
{"_id": "resume_search--graphic_design:_--n--70042", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"CorelDRAW\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Illustration Series - Nature\",\n            \"description\": \"A series of digital illustrations inspired by natural landscapes.\",\n            \"url\": \"https://example.com/nature-illustrations\"\n        },\n        {\n            \"title\": \"Poster Design - Music Festival\",\n            \"description\": \"Promotional poster for a local music festival.\",\n            \"url\": \"https://example.com/music-festival-poster\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I enjoy experimenting with different styles and techniques to create visually appealing and engaging artwork.\",\n    \"client_work_experience\": \"2 years of freelance illustration work, primarily focused on personal projects and small commissions.\",\n    \"design_awards\": [],\n    \"name\": \"Leo Maxwell\",\n    \"contact_information\": {\n        \"email\": \"leo.maxwell@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Arts in Fine Arts\",\n            \"university\": \"Community College of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"start_date\": \"2020-08-01\",\n            \"end_date\": \"2023-01-31\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Adobe Photoshop\",\n        \"Concept Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To develop my skills as an illustrator and contribute to creative projects.\",\n    \"languages\": [\n    