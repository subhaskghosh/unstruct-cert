{"_id": "resume_search--graphic_design:_--n--68631", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Corel Painter\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Character Illustration for Children's Book\",\n            \"description\": \"Detailed illustrations for a whimsical children's book.\",\n            \"url\": \"https://example.com/portfolio/childrensbook\"\n        },\n        {\n            \"title\": \"Fantasy Landscape Painting\",\n            \"description\": \"Digital painting of a fantastical landscape.\",\n            \"url\": \"https://example.com/portfolio/fantasy\"\n        }\n    ],\n    \"design_specialization\": \"Illustration\",\n    \"creative_process\": \"I am inspired by fantasy and storytelling. I enjoy bringing characters and worlds to life through detailed illustrations.\",\n    \"client_work_experience\": \"2 years of freelance illustration work for various clients.\",\n    \"design_awards\": [\n        \"Best Illustration Award - Local Art Show 2022\"\n    ],\n    \"name\": \"Ben Carter\",\n    \"contact_information\": {\n        \"email\": \"ben.carter@email.com\",\n        \"phone\": \"555-987-6543\",\n        \"address\": \"456 Oak Avenue, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Arts in Fine Arts\",\n            \"university\": \"Art Institute\",\n            \"year\": 2022\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Freelance Illustrator\",\n            \"company\": \"Self-Employed\",\n            \"duration\": \"2022 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Illustration\",\n        \"Digital Painting\",\n        \"Character Design\",\n        \"Fantasy Art\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To create captivating illustrations for a variety of projects.\",\n    \"languages\": [\n        \"Engli