{"_id": "resume_search--graphic_design:_--p--70702", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Adobe InDesign\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Complete branding package including logo, color palette, typography, and brand guidelines.\",\n            \"url\": \"https://example.com/ecobloom\"\n        },\n        {\n            \"title\": \"Website Mockups for 'TechForward'\",\n            \"description\": \"UI/UX design for a tech startup's website, focusing on a clean and modern aesthetic.\",\n            \"url\": \"https://example.com/techforward\"\n        }\n    ],\n    \"design_specialization\": \"Branding\",\n    \"creative_process\": \"I approach design with a user-centered mindset, starting with thorough research and brainstorming before developing concepts and iterating based on feedback.\",\n    \"client_work_experience\": \"5+ years of experience collaborating directly with clients, managing projects from concept to completion, and ensuring client satisfaction.\",\n    \"design_awards\": [\n        \"AIGA Design Award (2022)\"\n    ],\n    \"name\": \"Aria Sharma\",\n    \"contact_information\": {\n        \"email\": \"aria.sharma@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"Art Institute of Anytown\",\n            \"graduation_year\": 2019\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Senior Graphic Designer\",\n            \"company\": \"Creative Solutions Agency\",\n            \"duration\": \"2019 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\",\n        \"Color Theory\",\n        \"Adobe Creative Suite\"\n    ],\n    \"certifications\": [\n        \"Adobe Certified Professional\"\n    ],\n    \"objective\": \"To contribute my creative skills and experience to a dynamic team and help build impactful brands.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://ariasportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
