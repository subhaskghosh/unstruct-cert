{"_id": "resume_search--graphic_design:_--n--69291", "text": "{\n    \"name\": \"Bob The Builder\",\n    \"contact_information\": {\n        \"email\": \"bob.builder@email.com\",\n        \"phone_number\": \"555-987-6543\",\n        \"address\": \"456 Construction Rd, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Associate of Applied Science in Construction\",\n            \"university\": \"Trade School of Anytown\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Construction Foreman\",\n            \"company\": \"BuildIt Co.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Construction Management\",\n        \"Blueprint Reading\",\n        \"Team Leadership\"\n    ],\n    \"design_software_proficiency\": [\n        \"AutoCAD\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Residential Building Plans\",\n            \"description\": \"Detailed blueprints for residential construction projects.\"\n        }\n    ],\n    \"design_specialization\": \"Architectural Design\",\n    \"creative_process\": \"I focus on practical and efficient design solutions based on established building codes.\",\n    \"client_work_experience\": \"Experienced in managing client expectations and delivering projects on time and within budget.\",\n    \"availability\": \"2024-12-20\"\n}"}
{"_id": "resume_search--graphic_design:_--p--69292", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Brand Identity for 'EcoBloom'\",\n            \"description\": \"Logo design, color palette, and brand guidelines for a sustainable flower delivery service.\"\n        },\n        {\n            \"title\": \"Website Mockups\",\n            \"description\": \"UI/UX design for a mobile app landing page.\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin with thorough research, brainstorming multiple concepts, creating sketches, and then translating them into digital designs. I iterate based on client feedback.\",\n    \"client_work_experience\": \"I have over 4 years of experience collaborating with clients, understanding their needs, and delivering designs that exceed expectations.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"State University\",\n            \"year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"Graphic Designer\",\n            \"company\": \"Design Agency X\",\n            \"duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"UI/UX Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a dynamic team and create impactful visual solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
