{"_id": "resume_search--graphic_design:_--p--69790", "text": "{\n    \"design_software_proficiency\": [\n        \"Adobe Photoshop\",\n        \"Adobe Illustrator\",\n        \"Figma\"\n    ],\n    \"portfolio_samples\": [\n        {\n            \"title\": \"Logo Design for Tech Startup\",\n            \"description\": \"Created a modern and memorable logo for a tech startup.\",\n            \"image_url\": \"https://example.com/logo1.jpg\"\n        },\n        {\n            \"title\": \"Website Mockup\",\n            \"description\": \"Designed a website mockup for a client in the healthcare industry.\",\n            \"image_url\": \"https://example.com/website.jpg\"\n        }\n    ],\n    \"design_specialization\": \"branding\",\n    \"creative_process\": \"I begin with thorough research and brainstorming, followed by sketching and digital design iterations. Client feedback is integrated throughout the process.\",\n    \"client_work_experience\": \"Over 3 years of experience collaborating with clients, managing projects, and delivering high-quality design solutions.\",\n    \"design_awards\": [],\n    \"name\": \"Alice Smith\",\n    \"contact_information\": {\n        \"email\": \"alice.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Fine Arts in Graphic Design\",\n            \"university\": \"University of Art\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"role\": \"Graphic Designer\",\n            \"company\": \"Design Agency\",\n            \"duration\": \"2020-2023\"\n        }\n    ],\n    \"skills\": [\n        \"Logo Design\",\n        \"Branding\",\n        \"Web Design\",\n        \"Typography\"\n    ],\n    \"certifications\": [],\n    \"objective\": \"To contribute my creative skills and experience to a challenging and rewarding design role.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicesmithdesign.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
