t_experience\": true,\n    \"certified_public_accountant\": true,\n    \"investment_analysis\": [\n        \"DCF Analysis\",\n        \"Valuation\",\n        \"Portfolio Management\"\n    ],\n    \"certifications\": [\n        \"CFA Level 1\",\n        \"Certified Management Accountant (CMA)\"\n    ],\n    \"objective\": \"Seeking a challenging leadership role in corporate finance where I can leverage my analytical skills and experience to drive business growth.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.linkedin.com/in/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
