rience\": [\n        {\n            \"company\": \"Tesla\",\n            \"role\": \"Design Engineer\",\n            \"duration\": \"3 years\"\n        },\n        {\n            \"company\": \"Ford Motor Company\",\n            \"role\": \"Intern\",\n            \"duration\": \"1 summer\"\n        }\n    ],\n    \"skills\": [\n        \"Design\",\n        \"Analysis\",\n        \"Problem-solving\",\n        \"Teamwork\",\n        \"Communication\"\n    ],\n    \"objective\": \"To contribute my skills and experience in mechanical engineering to a challenging and innovative role in the automotive industry.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
