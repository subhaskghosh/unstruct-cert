uation_year\": 2018\n        },\n        {\n            \"degree\": \"Bachelor of Science in Mechanical Engineering\",\n            \"university\": \"Stanford University\",\n            \"graduation_year\": 2016\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"AutoCorp\",\n            \"title\": \"Senior Mechanical Engineer\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Design\",\n        \"Analysis\",\n        \"Problem Solving\",\n        \"Teamwork\"\n    ],\n    \"objective\": \"To contribute my expertise in automotive engineering to a challenging and innovative role focused on sustainable transportation solutions.\",\n    \"languages\": [\n        \"English\",\n        \"German\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/alicesmithportfolio\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
