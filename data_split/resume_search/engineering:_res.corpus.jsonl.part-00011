pany\": \"Automotive Innovations Inc.\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"3 years\"\n        },\n        {\n            \"company\": \"Engineering Solutions Corp.\",\n            \"role\": \"Mechanical Engineer\",\n            \"duration\": \"2 years\"\n        }\n    ],\n    \"skills\": [\n        \"Project Management\",\n        \"Design\",\n        \"Analysis\",\n        \"Testing\",\n        \"Problem-solving\",\n        \"Collaboration\"\n    ],\n    \"objective\": \"To contribute my mechanical engineering expertise and project management skills to a challenging and innovative environment.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
