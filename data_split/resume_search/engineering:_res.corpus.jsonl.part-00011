            \"company\": \"PowerTech Solutions\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"3 years\"\n        },\n        {\n            \"company\": \"ThermoDynamics Inc.\",\n            \"role\": \"Mechanical Engineer\",\n            \"duration\": \"2 years\"\n        }\n    ],\n    \"skills\": [\n        \"Project Management\",\n        \"Problem-Solving\",\n        \"Analytical Skills\",\n        \"Teamwork\"\n    ],\n    \"objective\": \"To leverage my expertise in mechanical engineering and project management to contribute to innovative and challenging projects.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
