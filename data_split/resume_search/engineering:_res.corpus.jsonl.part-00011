        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Robotics Inc.\",\n            \"title\": \"Project Manager\",\n            \"duration\": \"3 years\"\n        }\n    ],\n    \"skills\": [\n        \"Project Management\",\n        \"CAD Design\",\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Communication\"\n    ],\n    \"objective\": \"To contribute my skills and experience in mechanical engineering to a challenging and rewarding role focused on sustainable energy solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.exampleportfolio.com/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
