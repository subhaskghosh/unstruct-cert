in Mechanical Engineering\",\n            \"university\": \"Stanford University\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Automotive Innovations Inc.\",\n            \"role\": \"Lead Design Engineer\",\n            \"duration\": \"3 years\"\n        },\n        {\n            \"company\": \"Research Labs\",\n            \"role\": \"Research Assistant\",\n            \"duration\": \"2 years\"\n        }\n    ],\n    \"skills\": [\n        \"Problem-solving\",\n        \"Teamwork\",\n        \"Communication\",\n        \"Leadership\",\n        \"Project Management\"\n    ],\n    \"objective\": \"To contribute my expertise in mechanical engineering to a challenging and innovative role within the automotive industry.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/portfolio\"\n    ],\n    \"availability\": \"2024-01-15\"\n}"}
