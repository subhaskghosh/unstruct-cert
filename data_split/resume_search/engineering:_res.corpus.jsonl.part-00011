nnovations Inc.\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"2018 - Present\"\n        },\n        {\n            \"company\": \"Engineering Solutions Ltd.\",\n            \"role\": \"Mechanical Engineer\",\n            \"duration\": \"2016 - 2018\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Team Leadership\",\n        \"Communication\",\n        \"Design\",\n        \"Analysis\"\n    ],\n    \"objective\": \"To contribute my expertise in mechanical engineering and project management to a challenging and innovative role in the automotive industry.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.exampleportfolio.com/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
