information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Master of Science in Mechanical Engineering\",\n            \"university\": \"University of California, Berkeley\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"Bachelor of Science in Mechanical Engineering\",\n            \"university\": \"Stanford University\",\n            \"year\": 2016\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Automotive Dynamics Inc.\",\n            \"role\": \"Lead Mechanical Engineer\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Communication\",\n        \"Project Management\"\n    ],\n    \"objective\": \"To contribute my expertise in mechanical engineering to a challenging and innovative role within the automotive industry.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"http://alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
