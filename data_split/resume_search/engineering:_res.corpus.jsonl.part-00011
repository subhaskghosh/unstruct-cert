            \"duration\": \"5 years\"\n        }\n    ],\n    \"skills\": [\n        \"Project Management\",\n        \"Design\",\n        \"Analysis\",\n        \"Problem Solving\"\n    ],\n    \"objective\": \"To contribute my expertise in mechanical engineering and project management to a challenging and innovative role in the renewable energy sector.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnsonportfolio.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
