            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"5 years\"\n        }\n    ],\n    \"skills\": [\n        \"Design\",\n        \"Analysis\",\n        \"Testing\",\n        \"Project Management\",\n        \"Problem Solving\"\n    ],\n    \"objective\": \"Seeking a challenging role in the automotive industry where I can leverage my skills and experience to develop innovative and efficient solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/alicejohnson\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
