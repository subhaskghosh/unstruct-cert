{"_id": "resume_search--engineering:_res--p--67783", "text": "{\n    \"engineering_field\": \"Mechanical\",\n    \"project_experience\": [\n        {\n            \"scope\": \"Led a team in the design and development of a new engine cooling system for a major automotive manufacturer.\",\n            \"role\": \"Project Lead\",\n            \"impact\": \"Reduced engine overheating by 15% and improved fuel efficiency.\"\n        },\n        {\n            \"scope\": \"Managed the implementation of a new automated testing process for automotive components.\",\n            \"role\": \"Project Manager\",\n            \"impact\": \"Improved testing accuracy and reduced testing time by 20%.\"\n        }\n    ],\n    \"technical_skills\": [\n        \"CAD\",\n        \"FEA\",\n        \"MATLAB\",\n        \"Project Management\",\n        \"GD&T\",\n        \"Automotive Engineering\"\n    ],\n    \"certifications\": [\n        \"Six Sigma Black Belt\",\n        \"PMP\"\n    ],\n    \"research_and_development\": \"Experience in developing new materials for automotive applications.\",\n    \"standards_and_regulations_knowledge\": [\n        \"ISO 26262\",\n        \"SAE J1939\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Master of Science in Mechanical Engineering\",\n            \"university\": \"University of California, Berkeley\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Automotive Solutions Inc.\",\n            \"title\": \"Project Engineer\",\n            \"duration\": \"3 years\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Communication\"\n    ],\n    \"objective\": \"Seeking a challenging role in the automotive industry where I can utilize my project management and engineering skills.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-01\"\n}"}
