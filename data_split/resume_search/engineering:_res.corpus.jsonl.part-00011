ompany\": \"Automotive Innovations Inc.\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Innovation\",\n        \"Communication\"\n    ],\n    \"objective\": \"Seeking a challenging role in automotive engineering where I can leverage my project management and technical skills to contribute to innovative solutions.\",\n    \"languages\": [\n        \"English\",\n        \"German\"\n    ],\n    \"portfolio_links\": [\n        \"https://alicejohnson.com/portfolio\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
