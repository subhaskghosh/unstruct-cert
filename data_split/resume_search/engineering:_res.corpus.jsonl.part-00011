duration\": \"2020 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Mechanical Design\",\n        \"Automotive Engineering\",\n        \"Finite Element Analysis\",\n        \"CAD/CAM\"\n    ],\n    \"objective\": \"To contribute my expertise in mechanical engineering to the development of innovative automotive solutions.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.johndoeportfolio.com\"\n    ],\n    \"availability\": \"2024-03-01\"\n}"}
