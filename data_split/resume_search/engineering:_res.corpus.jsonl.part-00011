{"_id": "resume_search--engineering:_res--p--68856", "text": "{\n    \"engineering_field\": \"Mechanical Engineering\",\n    \"project_experience\": [\n        {\n            \"scope\": \"Led the design and implementation of a thermal management system for a high-performance electric vehicle.\",\n            \"role\": \"Project Lead\",\n            \"impact\": \"Improved battery efficiency by 15% and reduced cooling system weight by 10%\"\n        },\n        {\n            \"scope\": \"Developed a novel heat exchanger design for a concentrated solar power plant.\",\n            \"role\": \"Design Engineer\",\n            \"impact\": \"Increased energy capture efficiency by 8%\"\n        }\n    ],\n    \"technical_skills\": [\n        \"Finite Element Analysis (FEA)\",\n        \"Computational Fluid Dynamics (CFD)\",\n        \"MATLAB\",\n        \"CAD/CAM\",\n        \"Thermal Modeling\"\n    ],\n    \"certifications\": [\n        \"Certified Energy Manager (CEM)\",\n        \"Six Sigma Green Belt\"\n    ],\n    \"research_and_development\": \"Conducted research on advanced materials for thermal energy storage.\",\n    \"standards_and_regulations_knowledge\": [\n        \"ASME\",\n        \"ISO 9001\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"PhD in Mechanical Engineering\",\n            \"university\": \"Massachusetts Institute of Technology\",\n            \"graduation_year\": 2020\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Tesla\",\n            \"role\": \"Thermal Systems Engineer\",\n            \"duration\": \"2020-2023\"\n        }\n    ],\n    \"skills\": [\n        \"Project Management\",\n        \"Teamwork\",\n        \"Problem Solving\",\n        \"Communication\"\n    ],\n    \"objective\": \"Seeking a challenging role in mechanical engineering where I can apply my expertise in thermal systems and project management to develop innovative sustainable energy solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.alicejohnson.com\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
