        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"GreenTech Solutions\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Communication\",\n        \"Leadership\"\n    ],\n    \"objective\": \"Seeking a challenging role in a forward-thinking organization focused on sustainable engineering solutions.\",\n    \"languages\": [\n        \"English\",\n        \"German (Fluent)\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/portfolio\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
