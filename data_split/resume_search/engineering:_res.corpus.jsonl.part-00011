ith\",\n    \"contact_information\": {\n        \"email\": \"john.smith@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main Street, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Bachelor of Science in Mechanical Engineering\",\n            \"university\": \"University of Anytown\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"company\": \"Acme Manufacturing\",\n            \"title\": \"Manufacturing Engineer\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Problem Solving\",\n        \"Teamwork\",\n        \"Communication\",\n        \"Project Management\"\n    ],\n    \"objective\": \"To contribute my mechanical engineering skills and experience to a challenging and innovative environment focused on manufacturing excellence.\",\n    \"languages\": [\n        \"English\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-01\"\n}"}
