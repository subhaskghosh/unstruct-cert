ompany\": \"Automotive Innovations Inc.\",\n            \"role\": \"Senior Mechanical Engineer\",\n            \"duration\": \"5 years\"\n        }\n    ],\n    \"skills\": [\n        \"Design\",\n        \"Analysis\",\n        \"Manufacturing\",\n        \"Project Management\",\n        \"Problem Solving\"\n    ],\n    \"objective\": \"Seeking a challenging role in automotive R&D focused on innovative engineering solutions.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [\n        \"https://www.example.com/alicejohnsonportfolio\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
