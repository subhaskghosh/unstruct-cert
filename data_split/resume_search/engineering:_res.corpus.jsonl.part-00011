{"_id": "resume_search--engineering:_res--p--71254", "text": "{\n    \"engineering_field\": \"Mechanical Engineering\",\n    \"project_experience\": [\n        {\n            \"scope\": \"Designed and tested a new suspension system for a prototype vehicle.\",\n            \"role\": \"Lead Mechanical Engineer\",\n            \"impact\": \"Improved vehicle handling by 15%.\"\n        },\n        {\n            \"scope\": \"Developed a manufacturing process for a complex engine component.\",\n            \"role\": \"Design Engineer\",\n            \"impact\": \"Reduced production costs by 10%.\"\n        },\n        {\n            \"scope\": \"Led a team in the design of a new robotic arm for automotive assembly.\",\n            \"role\": \"Project Manager\",\n            \"impact\": \"Increased assembly line efficiency by 20%.\"\n        },\n        {\n            \"scope\": \"Conducted thermal analysis for engine cooling systems.\",\n            \"role\": \"Thermal Engineer\",\n            \"impact\": \"Improved engine durability and reduced overheating issues.\"\n        },\n        {\n            \"scope\": \"Created detailed CAD models and engineering drawings for automotive components.\",\n            \"role\": \"CAD Designer\",\n            \"impact\": \"Facilitated accurate manufacturing and assembly.\"\n        }\n    ],\n    \"technical_skills\": [\n        \"CAD (SolidWorks, AutoCAD)\",\n        \"FEA (ANSYS)\",\n        \"MATLAB\",\n        \"Robotics\",\n        \"Thermodynamics\",\n        \"Fluid Dynamics\"\n    ],\n    \"certifications\": [\n        \"Certified Robotics Technician (CRT)\"\n    ],\n    \"research_and_development\": \"Experience in developing new materials and manufacturing processes for automotive applications.\",\n    \"standards_and_regulations_knowledge\": [\n        \"ISO 9001\",\n        \"TS 16949\"\n    ],\n    \"name\": \"John Smith\",\n    \"contact_information\": {\n        \"email\": \"john.smith@email.com\",\n        \"phone_