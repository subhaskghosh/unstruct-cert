{"_id": "resume_search--engineering:_res--p--71393", "text": "{\n    \"engineering_field\": \"Mechanical\",\n    \"project_experience\": [\n        {\n            \"scope\": \"Led the design and integration of a new engine cooling system for a high-performance sports car.\",\n            \"role\": \"Project Manager\",\n            \"impact\": \"Reduced engine operating temperature by 15%, improving vehicle performance and reliability.\"\n        },\n        {\n            \"scope\": \"Developed and validated a novel suspension system for an electric vehicle prototype.\",\n            \"role\": \"Lead Engineer\",\n            \"impact\": \"Improved vehicle handling and ride comfort, resulting in positive driver feedback.\"\n        }\n    ],\n    \"technical_skills\": [\n        \"CAD (CATIA, SolidWorks)\",\n        \"FEA (ANSYS)\",\n        \"CFD (Fluent)\",\n        \"MATLAB\",\n        \"Simulink\",\n        \"Project Management\",\n        \"Automotive Systems\",\n        \"Control Systems\"\n    ],\n    \"certifications\": [\n        \"Project Management Professional (PMP)\",\n        \"ISO 26262 Functional Safety Engineer\"\n    ],\n    \"research_and_development\": \"Conducted research on advanced materials for automotive applications, resulting in a published paper in the Journal of Automotive Engineering.\",\n    \"standards_and_regulations_knowledge\": [\n        \"ISO 26262\",\n        \"Automotive SPICE\",\n        \"FMVSS\"\n    ],\n    \"name\": \"Alice Johnson\",\n    \"contact_information\": {\n        \"email\": \"alice.johnson@email.com\",\n        \"phone_number\": \"+1-555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Master of Science in Mechanical Engineering\",\n            \"university\": \"Massachusetts Institute of Technology\",\n            \"graduation_year\": 2018\n        },\n        {\n            \"degree\": \"Bachelor of Science in Mechanical Enginee