s Inc.\",\n            \"duration\": \"5 years\"\n        },\n        {\n            \"title\": \"HR Generalist\",\n            \"company\": \"Global Innovations Ltd.\",\n            \"duration\": \"2 years\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation & Benefits\",\n        \"Training & Development\",\n        \"Conflict Resolution\",\n        \"Workday\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my HR expertise to contribute to a thriving and inclusive work environment.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
