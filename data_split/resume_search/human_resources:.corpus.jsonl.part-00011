ess Partner\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation & Benefits\",\n        \"HRIS\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my expertise in HR to contribute to a dynamic and innovative organization.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
