"company\": \"Tech Solutions Inc.\",\n            \"start_date\": \"2018-07-01\",\n            \"end_date\": \"2023-12-31\",\n            \"responsibilities\": \"Managed full-cycle recruitment, employee relations, performance management, and HRIS systems.\"\n        },\n        {\n            \"title\": \"HR Generalist\",\n            \"company\": \"Global Innovations Ltd.\",\n            \"start_date\": \"2016-06-01\",\n            \"end_date\": \"2018-06-30\",\n            \"responsibilities\": \"Supported HR functions including recruitment, onboarding, and employee engagement.\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"HRIS\",\n        \"Conflict Resolution\",\n        \"Training and Development\",\n        \"Diversity and Inclusion\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my HR expertise and passion for employee development to contribute to a thriving organizational culture.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-01-15\"\n}"}
