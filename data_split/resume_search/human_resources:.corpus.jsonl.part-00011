us Recruiting\"\n    ],\n    \"employee_engagement_strategies\": \"Implemented employee surveys, team-building activities, and recognition programs to boost morale and engagement.\",\n    \"hr_software_experience\": [\n        \"Workday\",\n        \"BambooHR\"\n    ],\n    \"organizational_planning_skills\": \"Developed and implemented organizational charts and job descriptions to streamline workflows.\",\n    \"conflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"program_name\": \"Leadership Development Program\",\n            \"description\": \"A comprehensive program designed to enhance leadership skills among managers.\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"program_name\": \"Diversity & Inclusion Training\",\n            \"description\": \"A training program focused on promoting diversity and inclusion in the workplace.\",\n            \"duration\": \"2 days\"\n        }\n    ]\n}"}
