rkday\",\n        \"Greenhouse\",\n        \"BambooHR\"\n    ],\n    \"organizational_planning_skills\": \"Experienced in job analysis, organizational design, and succession planning.\",\n    \"conflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"name\": \"Leadership Development Program\",\n            \"description\": \"Designed and delivered a program to enhance leadership skills among mid-level managers.\"\n        }\n    ]\n}"}
