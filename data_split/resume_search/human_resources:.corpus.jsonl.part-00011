olutions Inc.\",\n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Training and Development\",\n        \"HRIS\",\n        \"Workday\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\"\n    ],\n    \"objective\": \"To leverage my HR expertise to contribute to a dynamic organization focused on employee growth and development.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
