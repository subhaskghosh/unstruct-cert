ls\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation\",\n        \"Benefits Administration\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\"\n    ],\n    \"objective\": \"Seeking a challenging HR leadership role where I can leverage my experience to drive employee engagement and organizational success.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
