resent\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Training & Development\",\n        \"Compensation & Benefits\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"Certified Diversity Professional (CDP)\"\n    ],\n    \"objective\": \"To contribute my expertise in HR management to a dynamic organization committed to employee growth and innovation.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-01-15\"\n}"}
