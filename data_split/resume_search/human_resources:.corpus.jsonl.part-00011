n            \"duration\": \"2018 - Present\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation & Benefits\",\n        \"HRIS\",\n        \"Change Management\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my HR expertise to contribute to the success of a dynamic and growing organization.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
