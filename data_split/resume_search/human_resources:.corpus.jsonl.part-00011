usive work environment.\",\n    \"hr_software_experience\": [\n        \"Workday\",\n        \"SuccessFactors\",\n        \"BambooHR\"\n    ],\n    \"organizational_planning_skills\": \"Strong skills in succession planning, talent management, and organizational design.\",\n    \"conflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"title\": \"Leadership Development Program\",\n            \"description\": \"A comprehensive program designed to enhance the leadership skills of managers.\"\n        },\n        {\n            \"title\": \"Diversity and Inclusion Training\",\n            \"description\": \"A training program focused on promoting diversity, equity, and inclusion in the workplace.\"\n        }\n    ],\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"availability\": \"2024-05-01\"\n}"}
