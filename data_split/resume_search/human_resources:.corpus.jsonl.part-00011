ining_programs_developed\": [\n        {\n            \"title\": \"Diversity and Inclusion Training\",\n            \"description\": \"A comprehensive program designed to educate employees on unconscious bias and promote inclusive behaviors.\",\n            \"date_developed\": \"2020-03-15\"\n        },\n        {\n            \"title\": \"Effective Communication Skills Workshop\",\n            \"description\": \"A workshop focused on improving communication skills and conflict resolution techniques.\",\n            \"date_developed\": \"2021-09-01\"\n        }\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-01-15\"\n}"}
