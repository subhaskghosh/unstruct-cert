Stanford University\",\n            \"year\": 2016\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"HR Business Partner\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"2018 - Present\",\n            \"description\": \"Partnered with business leaders to develop and implement HR strategies aligned with business objectives. Managed employee relations issues, performance management, and talent development.\"\n        }\n    ],\n    \"skills\": [\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Talent Acquisition\",\n        \"Organizational Development\",\n        \"HRIS\",\n        \"Conflict Resolution\",\n        \"Training & Development\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"Certified Mediator\"\n    ],\n    \"objective\": \"To leverage my HR expertise to drive organizational success and foster a positive work environment.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
