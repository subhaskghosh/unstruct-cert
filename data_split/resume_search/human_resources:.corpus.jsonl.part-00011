programs_developed\": [\n        {\n            \"title\": \"Leadership Development Program\",\n            \"description\": \"A comprehensive program designed to equip emerging leaders with the skills and knowledge to succeed.\"\n        }\n    ],\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"availability\": \"2024-03-15\"\n}"}
