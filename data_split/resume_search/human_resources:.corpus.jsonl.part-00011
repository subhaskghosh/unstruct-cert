description\": \"Managed full-cycle recruitment, employee relations, and performance management for a team of 100+ employees.\"\n        },\n        {\n            \"title\": \"HR Generalist\",\n            \"company\": \"Global Innovations Ltd.\",\n            \"duration\": \"2016 - 2018\",\n            \"description\": \"Supported various HR functions, including recruitment, onboarding, and employee engagement.\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Training and Development\",\n        \"HRIS\",\n        \"Conflict Resolution\",\n        \"Communication\",\n        \"Leadership\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"Certified Professional in Talent Development (CPTD)\"\n    ],\n    \"objective\": \"Seeking a challenging HR leadership role where I can leverage my skills and experience to drive organizational success.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
