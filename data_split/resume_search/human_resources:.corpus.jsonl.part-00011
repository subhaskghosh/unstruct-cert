{"_id": "resume_search--human_resources:--p--70945", "text": "{\n    \"name\": \"Eleanor Vance\",\n    \"contact_information\": {\n        \"email\": \"eleanor.vance@email.com\",\n        \"phone_number\": \"555-123-4567\",\n        \"address\": \"123 Main St, Anytown, USA\"\n    },\n    \"education\": [\n        {\n            \"degree\": \"Master of Science in Human Resources\",\n            \"university\": \"State University\",\n            \"graduation_year\": 2018\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"HR Manager\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"start_date\": \"2018-06-01\",\n            \"end_date\": \"2023-12-31\",\n            \"description\": \"Managed full-cycle recruitment, employee relations, and performance management. Implemented new onboarding processes and diversity initiatives.\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"HRIS\",\n        \"Conflict Resolution\",\n        \"Training & Development\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\"\n    ],\n    \"recruitment_methods\": [\n        \"LinkedIn Recruiter\",\n        \"Indeed\",\n        \"Employee Referrals\",\n        \"University Recruiting\"\n    ],\n    \"employee_engagement_strategies\": \"Implemented regular employee surveys, team-building activities, and mentorship programs to increase employee satisfaction and retention. Focused on creating a culture of feedback and recognition.\",\n    \"hr_software_experience\": [\n        \"Workday\",\n        \"Taleo\",\n        \"SuccessFactors\"\n    ],\n    \"organizational_planning_skills\": \"Developed and implemented HR policies and procedures aligned with organizational goals. Led workforce planning initiatives to ensure optimal staffing levels.\",\n    \"conflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"progra