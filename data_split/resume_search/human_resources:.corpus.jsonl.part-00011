    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation & Benefits\",\n        \"HRIS\",\n        \"Conflict Resolution\",\n        \"Training & Development\",\n        \"Diversity & Inclusion\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my HR expertise to contribute to a thriving and inclusive work environment.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-01\"\n}"}
