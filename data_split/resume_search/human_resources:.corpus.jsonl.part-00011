HR Manager\",\n            \"company\": \"Tech Solutions Inc.\",\n            \"duration\": \"5 years\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Organizational Development\",\n        \"Performance Management\",\n        \"Compensation and Benefits\"\n    ],\n    \"certifications\": [\n        \"SHRM-CP\",\n        \"PHR\"\n    ],\n    \"objective\": \"To leverage my experience in HR to contribute to the growth and success of a dynamic organization.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
