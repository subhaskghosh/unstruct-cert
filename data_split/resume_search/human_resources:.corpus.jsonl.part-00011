nflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"title\": \"Diversity & Inclusion Training\",\n            \"description\": \"A comprehensive program on unconscious bias and inclusive leadership.\",\n            \"year\": 2021\n        },\n        {\n            \"title\": \"Effective Communication Workshop\",\n            \"description\": \"Training focused on active listening and conflict resolution.\",\n            \"year\": 2022\n        },\n        {\n            \"title\": \"Inclusive Hiring Practices\",\n            \"description\": \"A workshop on removing bias from the recruitment process\",\n            \"year\": 2023\n        }\n    ]\n}"}
