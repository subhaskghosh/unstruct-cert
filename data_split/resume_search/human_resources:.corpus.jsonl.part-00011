ambooHR\"\n    ],\n    \"organizational_planning_skills\": \"Expertise in job analysis, succession planning, and organizational design.\",\n    \"conflict_resolution\": true,\n    \"training_programs_developed\": [\n        {\n            \"title\": \"Diversity & Inclusion Training\",\n            \"description\": \"A comprehensive program designed to promote understanding and respect in the workplace.\",\n            \"duration\": \"2 days\"\n        },\n        {\n            \"title\": \"Conflict Resolution Workshop\",\n            \"description\": \"Interactive workshop equipping employees with skills to effectively manage and resolve conflicts.\",\n            \"duration\": \"1 day\"\n        }\n    ]\n}"}
