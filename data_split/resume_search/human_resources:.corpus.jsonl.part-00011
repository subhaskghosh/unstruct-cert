        },\n        {\n            \"title\": \"HR Generalist\",\n            \"company\": \"Global Innovations Ltd.\",\n            \"duration\": \"2 years\"\n        }\n    ],\n    \"skills\": [\n        \"Recruitment\",\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation & Benefits\",\n        \"Organizational Development\"\n    ],\n    \"certifications\": [\n        \"SHRM-SCP\",\n        \"PHR\"\n    ],\n    \"objective\": \"Seeking a challenging HR leadership role where I can leverage my experience to drive organizational success and foster a positive work culture.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
