duration\": \"2018 - Present\"\n        },\n        {\n            \"title\": \"HR Generalist\",\n            \"company\": \"Global Innovations Ltd.\",\n            \"duration\": \"2016 - 2018\"\n        }\n    ],\n    \"skills\": [\n        \"Employee Relations\",\n        \"Performance Management\",\n        \"Compensation and Benefits\",\n        \"HRIS\",\n        \"Organizational Development\"\n    ],\n    \"certifications\": [\n        \"SHRM-SCP\",\n        \"PHR\"\n    ],\n    \"objective\": \"Seeking a challenging HR leadership role where I can leverage my experience to drive organizational growth and employee engagement.\",\n    \"languages\": [\n        \"English\",\n        \"Spanish\"\n    ],\n    \"portfolio_links\": [],\n    \"availability\": \"2024-03-15\"\n}"}
